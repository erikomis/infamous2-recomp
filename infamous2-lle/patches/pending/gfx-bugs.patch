+ * sRGB and alpha-test wrappers. Returns 1, or -1 without mutation for an
+ * unexpected form or insufficient capacity. */
+#define RSX_FP_CTRL_DEPTH_EXPORT 0xEu
+int rsx_fp_apply_depth_export(char* hlsl, u32 capacity);
