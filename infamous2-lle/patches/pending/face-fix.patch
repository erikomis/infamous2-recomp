diff --git a/tools/test_spu_insn_guard.py b/tools/test_spu_insn_guard.py
new file mode 100644
index 0000000..649315e
--- /dev/null
+++ b/tools/test_spu_insn_guard.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""spu_lifter --insn-guard: one instruction becomes a nop while a port predicate says so.
+
+A patch to an SPU image's bytes (RPCS3's "Disable Mesh Trimming" for inFAMOUS 2
+nops a `brnz` of the Edge geometry job) never reaches a lifted image, so the
+lifter can guard an instruction instead: `if (!PRED(ctx)) { <instruction> }`.
+
+Checks: the guarded line wraps exactly the unguarded translation, nothing else
+in the function changes, the header declares the predicate, the CLI rejects an
+address with no instruction; then a compiled run of a tiny function (il, brnz
+over an il, il) must take the branch while the predicate returns 0 -- the
+original program -- and fall through, as the nop'ed program does, when it
+returns 1.
+"""
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import spu_lifter  # noqa: E402
+
+BASE = 0x100
+WORDS = [
+    (0x081 << 23) | (1 << 7) | 4,    # 0x100 il   r4, 1
+    (0x042 << 23) | (3 << 7) | 4,    # 0x104 brnz r4, 0x110
+    (0x081 << 23) | (7 << 7) | 6,    # 0x108 il   r6, 7     (skipped by the branch)
+    0x40200000,                      # 0x10C nop
+    (0x081 << 23) | (2 << 7) | 5,    # 0x110 il   r5, 2
+]
+DATA = b"".join(struct.pack(">I", w) for w in WORDS)
+
+
+def lift(guard):
+    lf = spu_lifter.SPULifter(prefix="t_", reg_locals=False)
+    lf.insn_guard = dict(guard)
+    lf.func_starts = set()
+    insns = spu_lifter.disassemble_spu(DATA, BASE)
+    f = lf.lift_function(insns, BASE, BASE + len(DATA))
+    return f.body_lines, lf.emit_header()
+
+
+def structural():
+    plain, plain_h = lift({})
+    guarded, guarded_h = lift({0x104: "pred"})
+    assert len(plain) == len(guarded), (plain, guarded)
+    diff = [(a, b) for a, b in zip(plain, guarded) if a != b]
+    assert len(diff) == 1, diff
+    a, b = diff[0]
+    assert "goto loc_00000110" in a, a
+    assert b.startswith("    if (!pred(ctx)) { " + a.strip() + " }"), b
+    assert "int pred(spu_context* ctx);" in guarded_h and "pred" not in plain_h
+    print("PASS: --insn-guard structure")
+
+
+def cli():
+    with tempfile.TemporaryDirectory() as tmp:
+        blob = os.path.join(tmp, "m.bin")
+        with open(blob, "wb") as f:
+            f.write(DATA)
+        base = [sys.executable, os.path.join(HERE, "spu_lifter.py"), blob, "--base", hex(BASE), "-o", tmp]
+        bad = subprocess.run(base + ["--insn-guard", "0x102=pred"], capture_output=True, text=True)
+        assert bad.returncode != 0 and "no instruction there" in bad.stderr, bad.stderr
+        bad = subprocess.run(base + ["--insn-guard", "0x104"], capture_output=True, text=True)
+        assert bad.returncode != 0 and "ADDR=SYMBOL" in bad.stderr, bad.stderr
+    print("PASS: --insn-guard arguments")
+
+
+PRELUDE = r"""
+#include <stdint.h>
+#include <stdio.h>
+typedef union { uint32_t _u32[4]; } u128;
+typedef struct { u128 gpr[128]; uint32_t pc; } spu_context;
+static u128 spu_il(int32_t v) { u128 r = { { (uint32_t)v, (uint32_t)v, (uint32_t)v, (uint32_t)v } }; return r; }
+static int g_skip;
+int pred(spu_context* ctx) { (void)ctx; return g_skip; }
+"""
+
+MAIN = r"""
+int main(void) {
+    for (g_skip = 0; g_skip < 2; g_skip++) {
+        static spu_context c;
+        c = (spu_context){0};
+        f(&c);
+        printf("%u %u\n", c.gpr[6]._u32[0], c.gpr[5]._u32[0]);
+    }
+    return 0;
+}
+"""
+
+
+def semantic():
+    cc = shutil.which(os.environ.get("CC", "cc")) or shutil.which("clang") or shutil.which("gcc")
+    if not cc:
+        print("SKIP: no C compiler for the semantic check")
+        return
+    body, _ = lift({0x104: "pred"})
+    src = PRELUDE + "void f(spu_context* ctx) {\n" + "\n".join(body) + "\n}\n" + MAIN
+    with tempfile.TemporaryDirectory() as tmp:
+        c = os.path.join(tmp, "g.c")
+        with open(c, "w") as f:
+            f.write(src)
+        exe = os.path.join(tmp, "g")
+        subprocess.run([cc, "-O2", "-w", c, "-o", exe], check=True)
+        out = subprocess.run([exe], check=True, capture_output=True, text=True).stdout.split("\n")
+    # predicate 0: brnz taken, r6 never set; predicate 1: the branch is a nop, r6 = 7
+    assert out[0] == "0 2" and out[1] == "7 2", out
+    print("PASS: --insn-guard semantics")
+
+
+if __name__ == "__main__":
+    structural()
+    cli()
+    semantic()
