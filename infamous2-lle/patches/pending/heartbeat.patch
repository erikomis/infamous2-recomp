  *                                100 boosts a weak large-motor value, capped
  *                                at the motor's maximum
  *   PS3_RUMBLE_LOG=1             print every request the title makes
+ *
+ * The host can add a pulse of its own (cellPad_host_pulse: a port's
+ * low-health heartbeat, say). Each motor then runs at the stronger of the two,
+ * the title's request and the pulse, so a pulse never weakens or cuts a hit;
+ * PS3_RUMBLE=0 and the strength apply to it as to the title's. A pulse level
+ * holds until the next call and lapses PAD_PULSE_HOLD_MS after the last one,
+ * so a caller that stops calling cannot leave a motor running.
  * -------------------------------------------------------------------------*/
 
 #define PAD_RUMBLE_HOLD_MS     1000   /* one SDL request lasts this long ... */
 #define PAD_RUMBLE_RENEW_MS     400   /* ... and is renewed this often */
+#define PAD_PULSE_HOLD_MS       300   /* a host pulse nobody renews lasts this long */
 
 typedef struct {
     u16 lo, hi;        /* what the host motors were last asked for */
     u64 sent_ms;       /* when (GetTickCount64), 0 = nothing pending */
+    u16 game_lo, game_hi;     /* the title's part of it (strength applied) */
