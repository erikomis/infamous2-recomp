+/* The motors' new levels to port's controller. Call with the pad lock held. */
+static void pad_rumble_out(int port)
+{
+#if PAD_BACKEND_XINPUT
+    /* XInput keeps the motors at what they were last set to: no renewal. */
+    if (s_host_state[port].connected) {
+        XINPUT_VIBRATION vib;
+        vib.wLeftMotorSpeed  = (WORD)s_rumble[port].lo;
+        vib.wRightMotorSpeed = (WORD)s_rumble[port].hi;
+        XInputSetState((DWORD)port, &vib);
+    }
+#endif
+#if PAD_BACKEND_SDL2
+    pad_sdl_rumble_send(port);
+#endif
