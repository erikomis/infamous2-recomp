diff --git a/libs/input/tests/test_pad_pulse.c b/libs/input/tests/test_pad_pulse.c
new file mode 100644
index 0000000..b76a0d6
--- /dev/null
+++ b/libs/input/tests/test_pad_pulse.c
@@ -0,0 +1,245 @@
+/* cellPad_host_pulse: a host pulse (a port's low-health heartbeat) on top of
+ * the title's rumble. Each motor runs at the stronger of the two, so a pulse
+ * never weakens a hit and a hit never cuts a pulse; PS3_RUMBLE_STRENGTH
+ * scales the pulse and strength 0 (PS3_RUMBLE=0) silences it; a pulse nobody
+ * renews lapses on the pad poll after PAD_PULSE_HOLD_MS; the light bar glows
+ * towards red with it as it does with a hit, the adaptive trigger does not
+ * buzz with it.
+ *
+ *   cc -std=gnu17 -I include -isystem /opt/homebrew/include \
+ *      -isystem /opt/homebrew/include/SDL2 libs/input/tests/test_pad_pulse.c \
+ *      -o /tmp/test_pad_pulse && /tmp/test_pad_pulse
+ *
+ * Nothing links SDL: the test defines every SDL call the backend makes.
+ */
+#include "../cellPad.c"
+#include <assert.h>
+#include <sys/mman.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+/* the guest-memory writers' SPU coherence hooks (ppu_memory.h) */
+uint64_t spu_lockline_mask_range(uint32_t ea, uint32_t len) { (void)ea; (void)len; return 0; }
+void spu_lockline_lock_mask(uint64_t mask) { (void)mask; }
+void spu_lockline_unlock_mask(uint64_t mask) { (void)mask; }
+void spu_coh_notify_write_from_ppu(uint32_t addr) { (void)addr; }
+
+
+/* ---- the fake SDL: one controller ------------------------------------------ */
+static struct {
+    int present, closed, ps5, refuse;
+    Sint16 lt, rt;
+    uint32_t buttons;            /* SDL_GameControllerButton bits */
+    int effects;                 /* SendEffect calls */
+    uint8_t last[47];            /* the last effect report */
+} s_pad = { .present = 1, .ps5 = 1 };
+
+int SDL_NumJoysticks(void) { return s_pad.present; }
+SDL_bool SDL_IsGameController(int idx) { return idx == 0 && s_pad.present ? SDL_TRUE : SDL_FALSE; }
+SDL_JoystickID SDL_JoystickGetDeviceInstanceID(int idx) { return idx == 0 ? 1 : -1; }
+SDL_JoystickGUID SDL_JoystickGetDeviceGUID(int idx) { SDL_JoystickGUID g; memset(&g, 0, sizeof g); g.data[0] = (Uint8)idx; return g; }
+const char* SDL_JoystickNameForIndex(int idx) { (void)idx; return "Fake DualSense"; }
+SDL_GameController* SDL_GameControllerOpen(int idx) { (void)idx; s_pad.closed = 0; return (SDL_GameController*)&s_pad; }
+void SDL_GameControllerClose(SDL_GameController* gc) { (void)gc; s_pad.closed = 1; }
+SDL_bool SDL_GameControllerGetAttached(SDL_GameController* gc) { (void)gc; return s_pad.present ? SDL_TRUE : SDL_FALSE; }
+const char* SDL_GameControllerName(SDL_GameController* gc) { (void)gc; return "Fake DualSense"; }
+SDL_GameControllerType SDL_GameControllerGetType(SDL_GameController* gc)
+{
+    (void)gc; return s_pad.ps5 ? SDL_CONTROLLER_TYPE_PS5 : SDL_CONTROLLER_TYPE_XBOXONE;
+}
+SDL_bool SDL_GameControllerHasRumble(SDL_GameController* gc) { (void)gc; return SDL_TRUE; }
+/* The motors, recorded: the last request and how many there were. */
+static struct { Uint16 lo, hi; Uint32 ms; int n; } s_mot;
+int SDL_GameControllerRumble(SDL_GameController* gc, Uint16 lo, Uint16 hi, Uint32 ms)
+{
+    (void)gc; s_mot.lo = lo; s_mot.hi = hi; s_mot.ms = ms; s_mot.n++; return 0;
+}
+int SDL_GameControllerSendEffect(SDL_GameController* gc, const void* data, int size)
+{
+    (void)gc;
+    assert(!s_pad.closed && size == 47);
+    if (s_pad.refuse) return -1;
+    memcpy(s_pad.last, data, 47);
+    s_pad.effects++;
+    return 0;
+}
+Uint8 SDL_GameControllerGetButton(SDL_GameController* gc, SDL_GameControllerButton b) { (void)gc; return (Uint8)(s_pad.buttons >> b & 1u); }
+Sint16 SDL_GameControllerGetAxis(SDL_GameController* gc, SDL_GameControllerAxis a)
+{
+    (void)gc;
+    return a == SDL_CONTROLLER_AXIS_TRIGGERLEFT ? s_pad.lt : a == SDL_CONTROLLER_AXIS_TRIGGERRIGHT ? s_pad.rt : 0;
+}
+void SDL_GameControllerUpdate(void) {}
+int SDL_PeepEvents(SDL_Event* ev, int n, SDL_eventaction action, Uint32 lo, Uint32 hi) { (void)ev; (void)n; (void)action; (void)lo; (void)hi; return 0; }
+Uint32 SDL_WasInit(Uint32 flags) { return flags; }
+int SDL_InitSubSystem(Uint32 flags) { (void)flags; return 0; }
+SDL_bool SDL_SetHint(const char* name, const char* value) { (void)name; (void)value; return SDL_TRUE; }
+const char* SDL_GetError(void) { return "fake"; }
+/* The extras: player lights, light bar and gyro, recorded (a DualSense has
+ * a light bar and a gyro; the "Xbox" pad of the second half has neither). */
+static struct { int player; int leds; Uint8 rgb[3]; int gyro_on; float gyro[3]; } s_x;
+void SDL_GameControllerSetPlayerIndex(SDL_GameController* gc, int i) { (void)gc; s_x.player = i + 1; }
+SDL_bool SDL_GameControllerHasLED(SDL_GameController* gc) { (void)gc; return s_pad.ps5 ? SDL_TRUE : SDL_FALSE; }
+int SDL_GameControllerSetLED(SDL_GameController* gc, Uint8 r, Uint8 g, Uint8 b)
+{
+    (void)gc;
+    assert(!s_pad.closed);
+    s_x.rgb[0] = r; s_x.rgb[1] = g; s_x.rgb[2] = b; s_x.leds++;
+    return 0;
+}
+SDL_bool SDL_GameControllerHasSensor(SDL_GameController* gc, SDL_SensorType t)
+{
+    (void)gc; return s_pad.ps5 && t == SDL_SENSOR_GYRO ? SDL_TRUE : SDL_FALSE;
+}
+int SDL_GameControllerSetSensorEnabled(SDL_GameController* gc, SDL_SensorType t, SDL_bool on)
+{
+    (void)gc; assert(t == SDL_SENSOR_GYRO); s_x.gyro_on = on; return 0;
+}
+int SDL_GameControllerGetSensorData(SDL_GameController* gc, SDL_SensorType t, float* d, int n)
+{
+    (void)gc; assert(t == SDL_SENSOR_GYRO && s_x.gyro_on);
+    for (int i = 0; i < n && i < 3; i++) d[i] = s_x.gyro[i];
+    return 0;
+}
+
+/* ---- helpers ---------------------------------------------------------------- */
+static void poll_wait(int ms)
+{
+    usleep((unsigned)ms * 1000);
+    cellPad_poll();
+}
+static void rumble(int small_on, int large)
+{
+    CellPadActParam* act = (CellPadActParam*)(vm_base + 0x3000);
+    act->motor[CELL_PAD_ACTUATOR_PARAM_SMALL] = (u8)small_on;
+    act->motor[CELL_PAD_ACTUATOR_PARAM_LARGE] = (u8)large;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)0x3000) == CELL_OK);
+}
+static int light_is(unsigned rgb) { return s_x.rgb[0] == (rgb >> 16 & 0xFF) && s_x.rgb[1] == (rgb >> 8 & 0xFF) && s_x.rgb[2] == (rgb & 0xFF); }
+static int right_mode(void) { return s_pad.last[10]; }
+
+/* The merge itself, no controller. */
+static void test_merge(void)
+{
+    PadRumble r;
+    memset(&r, 0, sizeof r);
+    assert(!pad_rumble_merge(&r, 100, 1000));                 /* nothing asked: nothing changes */
+    r.pulse_lo = 30000; r.pulse_hi = 8000; r.pulse_ms = 1000;
+    assert(pad_rumble_merge(&r, 100, 1000) && r.lo == 30000 && r.hi == 8000);
+    assert(!pad_rumble_merge(&r, 100, 1100));                 /* the same level: no new request */
+    r.game_lo = 50000;                                        /* a hit on the large motor wins there */
+    assert(pad_rumble_merge(&r, 100, 1100) && r.lo == 50000 && r.hi == 8000);
+    r.game_lo = 10000;                                        /* a weak one loses to the pulse */
+    assert(pad_rumble_merge(&r, 100, 1100) && r.lo == 30000 && r.hi == 8000);
+    assert(pad_rumble_merge(&r, 50, 1100) && r.lo == 15000 && r.hi == 4000);   /* strength scales the pulse only */
+    assert(pad_rumble_merge(&r, 200, 1100) && r.lo == 60000 && r.hi == 16000);
+    r.pulse_lo = 40000;
+    assert(pad_rumble_merge(&r, 200, 1100) && r.lo == 65535);                  /* capped */
+    assert(pad_rumble_merge(&r, 0, 1100) && r.lo == 10000 && r.hi == 0);       /* vibration off: no pulse */
+    r.game_lo = 0;
+    assert(pad_rumble_merge(&r, 0, 1100) && r.lo == 0 && r.hi == 0);
+    assert(pad_rumble_merge(&r, 100, 1000 + PAD_PULSE_HOLD_MS - 1) && r.lo == 40000);
+    assert(pad_rumble_merge(&r, 100, 1000 + PAD_PULSE_HOLD_MS) && r.lo == 0 && r.hi == 0);   /* lapsed */
+    assert(r.pulse_ms == 0 && r.pulse_lo == 0 && r.pulse_hi == 0);
+    r.game_lo = 20000; r.game_hi = 65535;                     /* the title's rumble alone: as before */
+    assert(pad_rumble_merge(&r, 100, 5000) && r.lo == 20000 && r.hi == 65535);
+}
+
+int main(void)
+{
+    unsetenv("PS3_PAD_SDL"); unsetenv("PS3_INPUT_MAP"); unsetenv("PS3_INPUT_MODE");
+    unsetenv("PS3_RUMBLE"); unsetenv("PS3_RUMBLE_STRENGTH"); unsetenv("PS3_RUMBLE_LOG");
+    unsetenv("PS3_PAD_ADAPTIVE"); unsetenv("PS3_PAD_FIRE_AT"); unsetenv("PS3_PAD_LIGHT_HIT");
+    unsetenv("PS3_PAD_GYRO");
+    setenv("PS3_PAD_LIGHT", "1e78ff", 1);
+    vm_base = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+    test_merge();
+
+    assert(cellPadInit(4) == CELL_OK);
+    assert(light_is(0x1e78ff));
+    const int n0 = s_mot.n;
+
+    /* A beat: sent at once, with SDL's usual duration; repeated calls with
+     * the same level send nothing more. */
+    cellPad_host_pulse(0, 40000, 12000);
+    assert(s_mot.n == n0 + 1 && s_mot.lo == 40000 && s_mot.hi == 12000 && s_mot.ms == PAD_RUMBLE_HOLD_MS);
+    cellPad_host_pulse(0, 40000, 12000);
+    assert(s_mot.n == n0 + 1);
+    poll_wait(PAD_LIGHT_MIN_GAP_MS + 5);
+    assert(s_x.rgb[0] > 0x90 && s_x.rgb[2] < 0x70);           /* the light bar glows with it (40000/65535 to red) */
+    assert(right_mode() == 0x25);                             /* the trigger keeps its click: no buzz for a pulse */
+    s_pad.rt = 20000;                                         /* not even with the trigger held */
+    cellPad_host_pulse(0, 40000, 12000);
+    poll_wait(PAD_ADAPT_MIN_GAP_MS + 5);
+    assert(right_mode() == 0x25);
+    s_pad.rt = 0;
+    /* The beat ends: motors off at once, the light back to blue. */
+    cellPad_host_pulse(0, 0, 0);
+    assert(s_mot.n == n0 + 2 && s_mot.lo == 0 && s_mot.hi == 0 && s_mot.ms == 0);
+    poll_wait(PAD_LIGHT_MIN_GAP_MS + 5);
+    assert(light_is(0x1e78ff));
+
+    /* With the title's rumble: the stronger per motor, in both orders. */
+    rumble(0, 100);                                           /* large 100 -> 25700 */
+    assert(s_mot.lo == 25700 && s_mot.hi == 0);
+    cellPad_host_pulse(0, 40000, 12000);
+    assert(s_mot.lo == 40000 && s_mot.hi == 12000);
+    rumble(1, 200);                                           /* a hit over the beat */
+    assert(s_mot.lo == 51400 && s_mot.hi == 65535);
+    cellPad_host_pulse(0, 0, 0);                              /* the beat ends: the hit stays whole */
+    assert(s_mot.lo == 51400 && s_mot.hi == 65535);
+    cellPad_host_pulse(0, 40000, 12000);
+    rumble(0, 0);                                             /* the hit ends: the beat stays */
+    assert(s_mot.lo == 40000 && s_mot.hi == 12000);
+
+    /* Nobody renews it: the pad poll stops it after PAD_PULSE_HOLD_MS. */
+    poll_wait(PAD_PULSE_HOLD_MS / 2);
+    assert(s_mot.lo == 40000);
+    poll_wait(PAD_PULSE_HOLD_MS / 2 + 20);
+    assert(s_mot.lo == 0 && s_mot.hi == 0 && s_mot.ms == 0);
+    assert(s_rumble[0].sent_ms == 0);                         /* nothing left to renew */
+
+    /* A held level is renewed like the title's rumble (SDL's runs for 1 s). */
+    cellPad_host_pulse(0, 20000, 0);
+    const int n1 = s_mot.n;
+    for (int i = 0; i < 5; i++) { cellPad_host_pulse(0, 20000, 0); poll_wait(100); }
+    assert(s_mot.n == n1 + 1 && s_mot.lo == 20000 && s_mot.ms == PAD_RUMBLE_HOLD_MS);   /* once, past 400 ms */
+    cellPad_host_pulse(0, 0, 0);
+
+    /* Strength: half scales it, off silences it (the in-game menu's switch). */
+    cellPad_host_set_rumble_strength(50);
+    cellPad_host_pulse(0, 40000, 12000);
+    assert(s_mot.lo == 20000 && s_mot.hi == 6000);
+    cellPad_host_pulse(0, 0, 0);
+    cellPad_host_set_rumble_strength(0);
+    const int n2 = s_mot.n;
+    cellPad_host_pulse(0, 40000, 12000);
+    assert(s_mot.n == n2 && s_rumble[0].lo == 0 && s_rumble[0].hi == 0);
+    poll_wait(PAD_LIGHT_MIN_GAP_MS + 5);
+    assert(light_is(0x1e78ff));                               /* and no glow: the light follows the motors */
+    cellPad_host_pulse(0, 0, 0);
+    cellPad_host_set_rumble_strength(100);
+
+    /* A port with no host pad, and a pad that went away: harmless. */
+    cellPad_host_pulse(-1, 1000, 1000);
+    cellPad_host_pulse(PAD_MAX_HOST_PORTS, 1000, 1000);
+    cellPad_host_pulse(0, 99999, 99999);                      /* clamped */
+    assert(s_mot.lo == 65535 && s_mot.hi == 65535);
+    s_pad.present = 0;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_pad.closed);
+    cellPad_host_pulse(0, 30000, 0);                          /* kept for a pad that comes back, sent nowhere */
+    s_pad.present = 1;
+    assert(cellPadEnd() == CELL_OK);
+
+    printf("test_pad_pulse: all passed\n");
+    return 0;
+}
