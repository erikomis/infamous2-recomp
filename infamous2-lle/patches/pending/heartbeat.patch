+/* A host pulse on port's motors, on top of whatever the title asks for:
+ * lo = the large (low-frequency) motor, hi = the small one, 0-65535 each
+ * before PS3_RUMBLE_STRENGTH; 0, 0 ends it. The level holds until the next
+ * call, for at most PAD_PULSE_HOLD_MS: a caller shaping a pulse calls every
+ * few milliseconds with the level of the moment, from any thread. */
+void cellPad_host_pulse(int port, unsigned lo, unsigned hi)
+{
+    if (port < 0 || port >= PAD_MAX_HOST_PORTS) return;
+    if (lo > 65535u) lo = 65535u;
+    if (hi > 65535u) hi = 65535u;
+    pad_lock();
+    PadRumble* r = &s_rumble[port];
+    r->pulse_lo = (u16)lo;
+    r->pulse_hi = (u16)hi;
+    r->pulse_ms = lo || hi ? pad_now_ms() : 0;
+    if (pad_rumble_merge(r, pad_rumble_strength(), pad_now_ms())) {
+        static int log = -1; if (log < 0) log = getenv("PS3_RUMBLE_LOG") ? 1 : 0;
+        if (log) fprintf(stderr, "[cellPad] host pulse port %d: lo %u, hi %u -> motors %u, %u\n",
+                         port, lo, hi, r->lo, r->hi);
+        pad_rumble_out(port);
     }
-#endif
-
-#if PAD_BACKEND_SDL2
-    if (changed) { pad_lock(); pad_sdl_rumble_send((int)port_no); pad_unlock(); }
-#endif
-    (void)changed;
-    return CELL_OK;
+    pad_unlock();
 }
 
