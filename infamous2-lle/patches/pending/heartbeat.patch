 }
 
+/* The motors' levels from the title's request and the host pulse: the
+ * stronger of the two per motor. Drops a pulse that has lapsed. Returns 1
+ * when the levels changed (they then have to go to the controller). */
+static int pad_rumble_merge(PadRumble* r, int pct, unsigned long long now)
+{
+    unsigned long plo = 0, phi = 0;
+    if (r->pulse_ms && now - r->pulse_ms < PAD_PULSE_HOLD_MS) {
+        plo = (unsigned long)r->pulse_lo * (unsigned long)pct / 100ul;
+        phi = (unsigned long)r->pulse_hi * (unsigned long)pct / 100ul;
+        if (plo > 65535ul) plo = 65535ul;
+        if (phi > 65535ul) phi = 65535ul;
+    } else {
+        r->pulse_lo = r->pulse_hi = 0;
+        r->pulse_ms = 0;
+    }
+    const u16 lo = r->game_lo > plo ? r->game_lo : (u16)plo;
+    const u16 hi = r->game_hi > phi ? r->game_hi : (u16)phi;
+    const int changed = lo != r->lo || hi != r->hi;
+    r->lo = lo;
+    r->hi = hi;
+    return changed;
+}
