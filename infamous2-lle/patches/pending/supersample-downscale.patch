+#!/usr/bin/env python3
+"""PS3_DOWNSCALE: the present's Lanczos reduction on a real macOS Metal device."""
+import pathlib
+import platform
+import subprocess
+import tempfile
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+if platform.system() != "Darwin":
+    print("SKIP: Metal requires macOS")
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix="metal-downscale-") as tmp:
+    binary = pathlib.Path(tmp) / "test"
+    subprocess.run(["clang", "-fobjc-arc", "-Iinclude", "-Ilibs/video",
+                    "libs/video/tests/test_metal_downscale.m",
+                    "libs/video/rsx_texture_layout.c", "-Wl,-dead_strip",
+                    "-framework", "Metal", "-framework", "Cocoa",
+                    "-framework", "QuartzCore", "-weak_framework", "MetalFX", "-o", str(binary)],
+                   cwd=ROOT, check=True, timeout=120)
+    for mode in ("fit", "reduce", "old", "fallback", "unreadable"):
+        subprocess.run([str(binary), mode], check=True, timeout=30)
