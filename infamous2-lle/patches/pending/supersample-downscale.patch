+/* PS3_DOWNSCALE: the present's supersampling reduction on a real Metal device,
+ * with no window (python3 tools/test_metal_downscale.py builds and runs it).
+ *
+ *   fit       the drawable sizing (gfx_drawable_fit) and the option's parsing
+ *   reduce    a one-pixel checkerboard -- the finest detail a picture holds,
+ *             the kind that shimmers on edges -- through eng_blit_to_display
+ *             into a drawable three (and one and a half) times smaller must
+ *             come out an even grey, every source pixel weighed in; the layer
+ *             shrinking the drawable samples instead (bilinear: at 3x one
+ *             source pixel in nine, black or white). A flat picture keeps its
+ *             value up to the borders, and two reductions in one command
+ *             buffer (PS3_FRAMEGEN's two pictures) each get their own result
+ *   old       PS3_DOWNSCALE=0, or an internal resolution of 1, or a drawable
+ *             as large as the picture: the old present, pixel for pixel
+ *   fallback  MetalPerformanceShaders missing: one line, the option off, the
+ *             frame still presented (sampled)
+ *   unreadable a display buffer a shader may not read turns it off; without a
+ *             window the drawable stays the internal size (both checks after
+ *             the inFAMOUS 1 port's test of the same path) */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+
+/* What eng_blit_to_display (and the window code the file carries) reaches
+ * outside it. The menu stays closed. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+volatile int g_ps3_overlay_active;
+void ps3_overlay_render(void* cb, void* dst) { (void)cb; (void)dst; assert(!"menu closed"); }
+volatile uint32_t g_pad_mouse_buttons;
+
+static id<MTLTexture> tex(NSUInteger w, NSUInteger h, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [s_dev newTextureWithDescriptor:td];
+    assert(t);
+    return t;
+}
+
+enum { PAT_CHECKER, PAT_FLAT, PAT_RAMP };
+static id<MTLTexture> picture(NSUInteger w, NSUInteger h, int pat)
+{
+    id<MTLTexture> t = tex(w, h, MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget);
+    uint8_t* px = malloc(w * h * 4);
+    for (NSUInteger y = 0; y < h; y++)
+        for (NSUInteger x = 0; x < w; x++) {
+            uint8_t* p = px + (y * w + x) * 4;
+            const uint8_t v = pat == PAT_CHECKER ? (((x ^ y) & 1) ? 255 : 0)
+                            : pat == PAT_FLAT    ? 200
+                            : (uint8_t)(x * 255 / (w - 1));
+            p[0] = p[1] = p[2] = v; p[3] = 255;
+        }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+static id<MTLTexture> drawable(NSUInteger w, NSUInteger h)
+{
+    return tex(w, h, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+}
+
+static uint8_t* pixels(id<MTLTexture> t)
+{
+    uint8_t* px = malloc([t width] * [t height] * 4);
+    [t getBytes:px bytesPerRow:[t width] * 4 fromRegion:MTLRegionMake2D(0, 0, [t width], [t height]) mipmapLevel:0];
+    return px;
+}
+
+static void present(id<MTLTexture> src, id<MTLTexture> dst)
+{
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    eng_blit_to_display(cb, src, dst);
+    [cb commit];
+    [cb waitUntilCompleted];
+    assert(cb.status == MTLCommandBufferStatusCompleted);
+}
