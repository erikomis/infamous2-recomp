+/* The green channel's range away from the borders (m pixels in). */
+static void range(id<MTLTexture> t, int m, int* lo, int* hi)
+{
+    uint8_t* px = pixels(t);
+    const int w = (int)[t width], h = (int)[t height];
+    *lo = 255; *hi = 0;
+    for (int y = m; y < h - m; y++)
+        for (int x = m; x < w - m; x++) {
+            const int v = px[(y * w + x) * 4 + 1];
+            if (v < *lo) *lo = v;
+            if (v > *hi) *hi = v;
+        }
+    free(px);
+}
+
+static void set_down(const char* env, float scale)
+{
+    if (env) setenv("PS3_DOWNSCALE", env, 1); else unsetenv("PS3_DOWNSCALE");
+    s_res_scale = scale;
+    gfx_downscale_load();
+}
+
+static void check_fit(void)
+{
+    double w, h;
+    /* this Mac's 1280x720-point window on a Retina screen: 2560x1440 pixels */
+    gfx_drawable_fit(2560, 1440, 3840, 2160, 0, 1, &w, &h); assert(w == 2560 && h == 1440);   /* x3 */
+    gfx_drawable_fit(2560, 1440, 3200, 1800, 0, 1, &w, &h); assert(w == 2560 && h == 1440);   /* x2.5 */
+    gfx_drawable_fit(2560, 1440, 2560, 1440, 0, 1, &w, &h); assert(w == 2560 && h == 1440);   /* x2: as large */
+    gfx_drawable_fit(2560, 1440, 1920, 1080, 0, 1, &w, &h); assert(w == 1920 && h == 1080);   /* x1.5: smaller */
+    /* fullscreen on its 3024x1964 pixels: fitted 3024x1701 */
+    gfx_drawable_fit(3024, 1964, 3840, 2160, 0, 1, &w, &h); assert(w == 3024 && h == 1701);
+    gfx_drawable_fit(3024, 1964, 2560, 1440, 0, 1, &w, &h); assert(w == 2560 && h == 1440);
+    /* PS3_ASPECT=21:9 at x3 (5040x2160) in the 16:9 window: the wide shape */
+    gfx_drawable_fit(2560, 1440, 5040, 2160, 0, 1, &w, &h); assert(w == 2560 && h == 1097);
+    /* off, or MetalFX up only: the picture's size; MetalFX as it was */
+    gfx_drawable_fit(2560, 1440, 3840, 2160, 0, 0, &w, &h); assert(w == 3840 && h == 2160);
+    gfx_drawable_fit(2560, 1440, 3840, 2160, 1, 0, &w, &h); assert(w == 3840 && h == 2160);
+    gfx_drawable_fit(2560, 1440, 1280, 720, 1, 1, &w, &h);  assert(w == 2560 && h == 1440);
+    gfx_drawable_fit(0, 0, 3840, 2160, 1, 1, &w, &h);       assert(w == 3840 && h == 2160);   /* no view yet */
+    assert(gfx_downscale_from(NULL) == 1 && gfx_downscale_from("") == 1);
+    assert(gfx_downscale_from("1") == 1 && gfx_downscale_from("lanczos") == 1 && gfx_downscale_from("on") == 1);
+    assert(gfx_downscale_from("0") == 0 && gfx_downscale_from("off") == 0 && gfx_downscale_from("OFF") == 0);
+    set_down(NULL, 3.0f);  assert(s_gfx_down && s_gfx_down_on);
+    set_down("0", 3.0f);   assert(!s_gfx_down && !s_gfx_down_on);
+    set_down(NULL, 1.0f);  assert(!s_gfx_down && !s_gfx_down_on);   /* native: the old path */
+    set_down(NULL, 1.5f);  assert(s_gfx_down);
+    puts("[downscale] fit and parsing passed");
+}
+
+static void check_reduce(void)
+{
+    set_down(NULL, 3.0f);
+    id<MTLTexture> src = picture(192, 108, PAT_CHECKER), dst = drawable(64, 36);
+    present(src, dst);
+    if (!s_gfx_down_on) { puts("[downscale] MetalPerformanceShaders not available here; fallback taken"); return; }
+    assert(s_gfx_ds_out && [s_gfx_ds_out width] == 64 && [s_gfx_ds_out height] == 36 &&
+           [s_gfx_ds_out storageMode] == MTLStorageModePrivate);
+    int lo, hi;
+    range(dst, 0, &lo, &hi);
+    printf("[downscale] checkerboard 192x108 -> 64x36 (x3): %d..%d, borders included\n", lo, hi);
+    assert(lo >= 120 && hi <= 135);           /* an even grey; sampling gives 0 and 255 */
+
+    /* the same sizes keep the output */
+    id<MTLTexture> again = s_gfx_ds_out;
+    present(src, dst);
+    assert(s_gfx_ds_out == again);
+
+    /* x1.5, the 3840x2160 picture in this Mac's 2560x1440-pixel window */
+    id<MTLTexture> src15 = picture(384, 216, PAT_CHECKER), dst15 = drawable(256, 144);
+    present(src15, dst15);
+    range(dst15, 0, &lo, &hi);
+    printf("[downscale] checkerboard 384x216 -> 256x144 (x1.5): %d..%d\n", lo, hi);
+    assert(lo >= 110 && hi <= 145);
+    { /* what the layer did with it: bilinear, the same sizes */
+      id<MTLTexture> lin = drawable(256, 144);
+      id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+      id<MTLRenderPipelineState> ps = s_eng_blit_pso;
+      MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+      rp.colorAttachments[0].texture = lin; rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+      rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+      id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+      [e setRenderPipelineState:ps];
+      [e setFragmentTexture:src15 atIndex:0];
+      [e setFragmentSamplerState:s_eng_linear_sampler atIndex:0];
+      const struct { float gamma, sharp, px[2], vib, con, vig, grain, time, lsz, lamt, pad,
+                     csh, cmid, chi, cla; } p = { 1.0f, 0.0f, { 1.0f / 256, 1.0f / 144 }, 0.0f, 1.0f };
+      [e setFragmentBytes:&p length:sizeof p atIndex:0];
+      [e setFragmentTexture:src15 atIndex:1];
+      [e setFragmentSamplerState:s_eng_linear_sampler atIndex:1];
+      [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+      [e endEncoding];
+      [cb commit]; [cb waitUntilCompleted];
+      int blo, bhi; range(lin, 0, &blo, &bhi);
+      printf("[downscale] the same with the layer's bilinear sampling: %d..%d\n", blo, bhi);
+      assert(bhi - blo > 2 * (hi - lo)); }
+
+    /* a flat picture stays flat up to the borders (the edge mode clamps) */
+    id<MTLTexture> flat = picture(192, 108, PAT_FLAT);
+    present(flat, dst);
+    range(dst, 0, &lo, &hi);
+    assert(lo >= 199 && hi <= 201);
+
+    /* PS3_FRAMEGEN: two pictures reduced in one command buffer, each into its
+     * own target, share the kernel's output in turn and must not mix */
+    id<MTLTexture> ramp = picture(192, 108, PAT_RAMP), d1 = drawable(64, 36), d2 = drawable(64, 36);
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    eng_blit_to_display(cb, src, d1);
+    eng_blit_to_display(cb, ramp, d2);
+    [cb commit]; [cb waitUntilCompleted];
+    assert(cb.status == MTLCommandBufferStatusCompleted);
+    range(d1, 0, &lo, &hi);
+    assert(lo >= 120 && hi <= 135);
+    uint8_t* px = pixels(d2);
+    for (int y = 0; y < 36; y++)
+        for (int x = 1; x < 64; x++) assert(px[(y * 64 + x) * 4 + 1] >= px[(y * 64 + x - 1) * 4 + 1]);
+    assert(px[1] < 10 && px[63 * 4 + 1] > 245);
+    free(px);
+    puts("[downscale] reduce passed");
+}
+
+/* The old present for a 3x smaller drawable: the point sampler takes the
+ * pixel under each centre, (3x+1, 3y+1). */
+static void check_old(void)
+{
+    id<MTLTexture> src = picture(192, 108, PAT_CHECKER);
+    const char* envs[] = { "0", "off" };
+    for (int k = 0; k < 3; k++) {
+        if (k < 2) set_down(envs[k], 3.0f); else set_down(NULL, 1.0f);   /* or native */
+        assert(!s_gfx_down_on);
+        id<MTLTexture> dst = drawable(64, 36);
+        present(src, dst);
+        uint8_t* px = pixels(dst);
+        for (int y = 0; y < 36; y++)
+            for (int x = 0; x < 64; x++) {
+                const uint8_t want = (((3 * x + 1) ^ (3 * y + 1)) & 1) ? 255 : 0;
+                assert(px[(y * 64 + x) * 4 + 1] == want && px[(y * 64 + x) * 4 + 3] == 255);
+            }
+        free(px);
+        assert(!s_gfx_ds_out);                 /* the kernel never ran */
+    }
+    /* on, but the drawable as large as the picture: the same bytes as off */
+    id<MTLTexture> ramp = picture(192, 108, PAT_RAMP), a = drawable(192, 108), b = drawable(192, 108);
+    set_down("0", 3.0f);  present(ramp, a);
+    set_down(NULL, 3.0f); present(ramp, b);
+    assert(s_gfx_down_on && !s_gfx_ds_out);
+    uint8_t* pa = pixels(a), *pb = pixels(b);
+    assert(!memcmp(pa, pb, 192 * 108 * 4));
+    free(pa); free(pb);
+    puts("[downscale] old path passed");
+}
+
+static void check_fallback(void)
+{
+    s_gfx_ds_class = "PS3NoSuchLanczosScale";
+    set_down(NULL, 3.0f);
+    id<MTLTexture> src = picture(192, 108, PAT_FLAT), dst = drawable(64, 36);
+    present(src, dst);
+    assert(!s_gfx_down_on && !s_gfx_ds_kernel && !s_gfx_ds_out);
+    int lo, hi;
+    range(dst, 0, &lo, &hi);
+    assert(lo == 200 && hi == 200);           /* still presented, sampled */
+    present(src, dst);                        /* and the line is said once */
+    puts("[downscale] fallback passed");
+}
+
+/* A display buffer a shader may not read: the reduction gives up for good,
+ * and with no window (or after giving up) the drawable is the internal size. */
+static void check_unreadable(void)
+{
+    set_down(NULL, 3.0f);
+    res_axes_update();
+    s_width = 64; s_height = 36;
+    s_layer = [CAMetalLayer layer];
+    wm_keep_drawable();                       /* no window: the picture's size */
+    assert(s_layer.drawableSize.width == 192 && s_layer.drawableSize.height == 108);
+    id<MTLTexture> bad = tex(192, 108, MTLTextureUsageRenderTarget);
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    assert(gfx_downscale(cb, bad, 64, 36) == nil);
+    [cb commit]; [cb waitUntilCompleted];
+    assert(!s_gfx_down_on && !s_gfx_ds_out);
+    wm_keep_drawable();
+    assert(s_layer.drawableSize.width == 192 && s_layer.drawableSize.height == 108);
+    s_layer = nil;
+    puts("[downscale] unreadable source passed");
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        assert(argc == 2);
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { puts("[downscale] no Metal device; skipped"); return 0; }
+        s_queue = [s_dev newCommandQueue];
+        assert(s_queue && eng_init(NULL, 0, 0) == 0);
+        if      (!strcmp(argv[1], "fit"))      check_fit();
+        else if (!strcmp(argv[1], "reduce"))   check_reduce();
+        else if (!strcmp(argv[1], "old"))      check_old();
+        else if (!strcmp(argv[1], "fallback")) check_fallback();
+        else if (!strcmp(argv[1], "unreadable")) check_unreadable();
+        else return 2;
+    }
+    return 0;
+}
