+/* PS3_DOWNSCALE: src reduced with a Lanczos filter (MPSImageLanczosScale)
+ * into a private texture of ow x oh. Every source pixel is weighed into the
+ * result, which is what makes an internal resolution above the window's
+ * supersampling; a layer shrinking the drawable samples it instead (bilinear,
+ * no mipmaps: at 3x one source pixel in nine). The framework is opened and
+ * the class looked up the first time; nil when it cannot, and a failure that
+ * will not go away by itself turns the option off (gfx_downscale_fail). */
+static id<MTLTexture> gfx_downscale(id<MTLCommandBuffer> cb, id<MTLTexture> src,
+                                    NSUInteger ow, NSUInteger oh)
+{
+#if GFX_HAVE_MPS
+    static Class lanczos;
+    static int looked;
+    if (!looked) {
+        looked = 1;
+        dlopen("/System/Library/Frameworks/MetalPerformanceShaders.framework/MetalPerformanceShaders",
+               RTLD_LAZY | RTLD_LOCAL);
+        lanczos = NSClassFromString([NSString stringWithUTF8String:s_gfx_ds_class]);
+    }
+    if (!lanczos) { gfx_downscale_fail("MetalPerformanceShaders is not on this system"); return nil; }
+    if (!([src usage] & MTLTextureUsageShaderRead)) {
+        gfx_downscale_fail("the display buffer cannot be read by a shader");
+        return nil;
+    }
+    if (!s_gfx_ds_kernel) {
+        MPSImageLanczosScale* k = [[lanczos alloc] initWithDevice:s_dev];
+        if (!k) { gfx_downscale_fail("not supported on this GPU"); return nil; }
+        /* The default edge mode reads zeros past the picture: dark borders. */
+        k.edgeMode = MPSImageEdgeModeClamp;
+        s_gfx_ds_kernel = k;
+    }
+    if (!s_gfx_ds_out || [s_gfx_ds_out width] != ow || [s_gfx_ds_out height] != oh ||
+        [s_gfx_ds_out pixelFormat] != [src pixelFormat]) {
+        MTLTextureDescriptor* td =
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:[src pixelFormat] width:ow
+                                                              height:oh mipmapped:NO];
+        td.usage       = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead;
+        td.storageMode = MTLStorageModePrivate;
+        s_gfx_ds_out = [s_dev newTextureWithDescriptor:td];
+        if (!s_gfx_ds_out) { gfx_downscale_fail("no memory for its output"); return nil; }
+        static int n;
+        if (PS3_LOG_FIRST(n, 4))
+            fprintf(stderr, "[RSX metal] supersampling: %lux%lu reduced to %lux%lu (Lanczos)\n",
+                    (unsigned long)[src width], (unsigned long)[src height],
+                    (unsigned long)ow, (unsigned long)oh);
+    }
+    [(MPSImageLanczosScale*)s_gfx_ds_kernel encodeToCommandBuffer:cb sourceTexture:src
+                                               destinationTexture:s_gfx_ds_out];
+    return s_gfx_ds_out;
+#else
+    (void)cb; (void)src; (void)ow; (void)oh;
+    gfx_downscale_fail("built without MetalPerformanceShaders");
+    return nil;
+#endif
+}
