+static void gfx_drawable_fit(double pw, double ph, u32 bw, u32 bh, int up, int down,
+                             double* ow, double* oh)
+{
+    *ow = (double)bw; *oh = (double)bh;
+    if ((!up && !down) || !(pw >= 1.0) || !(ph >= 1.0) || !bw || !bh) return;
+    double fw = floor(pw), fh = floor(ph);
+    if (fw * bh > fh * bw) fw = floor(fh * bw / bh + 0.5);   /* PS3_ASPECT: the wide image's shape */
+    else                   fh = floor(fw * bh / bw + 0.5);
+    if (up && fw > bw && fh > bh) { *ow = fw; *oh = fh; }
+    else if (down && fw < bw && fh < bh && fw >= 1.0 && fh >= 1.0) { *ow = fw; *oh = fh; }
+}
