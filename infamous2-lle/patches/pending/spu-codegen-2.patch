+/* spu_shufb_lean (what spu_lifter.py emits by default; SPU_LIFT_LEAN_SHUFB=0 = spu_shufb):
+ * bit-identical to spu_shufb with no byte reversals. SPU byte P is host byte P^3 in a, b, c
+ * and the result alike, so the result's host byte h takes the control at host byte h, and
+ * concat SPU byte s (s < 32) is table byte s^3 of the host-order {a, b} pair (the xor leaves
+ * bit 4, the a/b choice, alone). Controls 0x80..0xFF: masked with 0x9F the index stays >= 0x80,
+ * out of TBL's range, so the lookup gives 0; then 0xC0..0xDF or in 0xFF and 0xE0..0xFF 0x80:
+ * (C >= 0xC0 ? 0xFF : 0) ^ (C >= 0xE0 ? 0x7F : 0). tests/test_spu_shufb_lean.c checks it. */
+#if defined(__ARM_NEON) && !defined(SPU_SCALAR_HELPERS)
+static inline __attribute__((always_inline)) u128 spu_shufb_lean(u128 a, u128 b, u128 c) {
+    uint8x16x2_t t;
+    t.val[0] = vld1q_u8(a._u8);
+    t.val[1] = vld1q_u8(b._u8);
+    const uint8x16_t C = vld1q_u8(c._u8);
+    const uint8x16_t r = vqtbl2q_u8(t, veorq_u8(vandq_u8(C, vdupq_n_u8(0x9F)), vdupq_n_u8(3)));
+    const uint8x16_t sp = veorq_u8(vcgeq_u8(C, vdupq_n_u8(0xC0)),
+                                   vandq_u8(vcgeq_u8(C, vdupq_n_u8(0xE0)), vdupq_n_u8(0x7F)));
+    u128 out; vst1q_u8(out._u8, vorrq_u8(r, sp)); return out;
+}
+#else
+#define spu_shufb_lean spu_shufb
+#endif
