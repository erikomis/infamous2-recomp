+ * SPU_LIFT_LEAN_LS=0 = the two above): the same accesses, the same debug hooks in the
+ * same order, with the four 32-bit byte swaps done as one 128-bit load or store and one
+ * REV32 (clang turned the four memcpy + bswap into LD2 + three shuffles + REV64 for a load).
+ * The value is the same bit for bit: SPU word i = big-endian bytes 4i..4i+3 at host word i.
+ * tests/test_spu_ls_lean.c checks both against the forms above. */
+#if defined(__ARM_NEON) && !defined(SPU_SCALAR_HELPERS)
+#include <arm_neon.h>
+static inline __attribute__((always_inline)) u128 spu_ls_read128_lean(const spu_context* ctx, uint32_t lsa)
+{
+    if (__builtin_expect(g_spu_ls_dbg != 0, 0)) {
+        spu_ls_read_probe(ctx, lsa);
+        spu_ls_watch_hit2(ctx, lsa & (SPU_LS_MASK & ~0xFu), 0, &ctx->ls[lsa & (SPU_LS_MASK & ~0xFu)],
+                          (uint32_t)ctx->pc & SPU_LS_MASK, ctx->gpr[0]._u32[0] & SPU_LS_MASK);
+    }
+    u128 v;
+    vst1q_u8(v._u8, vrev32q_u8(vld1q_u8(&ctx->ls[lsa & (SPU_LS_MASK & ~0xFu)])));
+    return v;
