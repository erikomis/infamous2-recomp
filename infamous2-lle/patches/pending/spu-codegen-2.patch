+/* With a debug hook armed, the whole store out of line: spu_ls_write128 itself, so the
+ * hooks run in the same order around the same store. One test of g_spu_ls_dbg per store
+ * instead of two (the second had to reload it after the byte store). */
+static __attribute__((noinline, cold)) void spu_ls_write128_dbg(spu_context* ctx, uint32_t lsa, u128 val)
+{
+    spu_ls_write128(ctx, lsa, val);
+}
+static inline __attribute__((always_inline)) void spu_ls_write128_lean(spu_context* ctx, uint32_t lsa, u128 val)
+{
+    if (__builtin_expect(g_spu_ls_dbg != 0, 0)) { spu_ls_write128_dbg(ctx, lsa, val); return; }
+    vst1q_u8(&ctx->ls[lsa & (SPU_LS_MASK & ~0xFu)], vrev32q_u8(vld1q_u8(val._u8)));
+}
+#else
+#define spu_ls_read128_lean  spu_ls_read128
+#define spu_ls_write128_lean spu_ls_write128
+#endif
