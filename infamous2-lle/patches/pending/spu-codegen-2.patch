+ * must be bit-identical to spu_ls_read128 / spu_ls_write128: the same value for every load and
+ * the same local store after every store, at any address (unaligned, past 256 KB, wrapping) and
+ * with any contents. Build on arm64:
+ *   cc -O2 -fno-strict-aliasing -fwrapv -I.. -I../../../include test_spu_ls_lean.c -o t && ./t [N]
+ * -DPLANT_BUG swaps two bytes of the lean load at one address: the test must then fail. */
+#include "../spu_context.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+/* the debug hooks' state and entry points (spu_channels.c in the runtime). The second pass arms
+ * them: every watch hit is hashed (address, kind, the 16 bytes it sees, pc, lr), and both forms
+ * must make the same hits in the same order. */
+int g_spu_ls_dbg = 0;
+int g_spu_ls_watch_n = 0;
+static uint64_t s_hook;
+void spu_ls_watch_slow(const struct spu_context* c, uint32_t lsa, int is_write, const uint8_t* p,
+                       uint32_t pc, uint32_t lr)
+{
+    (void)c;
+    uint64_t h = s_hook ^ lsa ^ ((uint64_t)is_write << 40) ^ ((uint64_t)pc << 20) ^ ((uint64_t)lr << 44);
+    for (int i = 0; i < 16; i++) h = (h ^ p[i]) * 0x100000001B3ull;
+    s_hook = h * 0x9E3779B97F4A7C15ull;
+}
+
+static uint64_t s_rng = 0x853C49E6748FEA9Bull;
+static uint32_t rnd32(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)(s_rng >> 16); }
+static uint32_t rnd_addr(void)
+{
+    switch (rnd32() % 4) {
+    case 0: return rnd32();                                   /* any 32-bit value: masked */
+    case 1: return (SPU_LS_SIZE - 16u) + (rnd32() & 31u);     /* the end of LS and past it */
+    case 2: return rnd32() & 0x3FFF0u;                        /* aligned */
+    default: return rnd32() & 0x3FFFFu;                       /* unaligned inside LS */
+    }
+}
+
+static u128 lean_read(const spu_context* c, uint32_t a)
+{
+    u128 v = spu_ls_read128_lean(c, a);
+#ifdef PLANT_BUG
+    if ((a & 0x3FFF0u) == 0x1230u) { uint8_t t = v._u8[0]; v._u8[0] = v._u8[1]; v._u8[1] = t; }
+#endif
+    return v;
+}
+
+int main(int argc, char** argv)
+{
+    const unsigned long long n = argc > 1 ? strtoull(argv[1], 0, 0) : 20000000ull;
+    static spu_context c1, c2;
+    uint8_t* ls1 = aligned_alloc(128, SPU_LS_SIZE); uint8_t* ls2 = aligned_alloc(128, SPU_LS_SIZE);
+    for (int i = 0; i < SPU_LS_SIZE; i++) ls1[i] = (uint8_t)rnd32();
+    memcpy(ls2, ls1, SPU_LS_SIZE);
+    c1.ls = ls1; c2.ls = ls2;
+    unsigned long long bad = 0, loads = 0, stores = 0;
+    /* every aligned line once, then random loads and stores interleaved */
+    for (uint32_t a = 0; a < SPU_LS_SIZE + 64u; a += 16) {
+        const u128 x = lean_read(&c1, a), y = spu_ls_read128(&c1, a); loads++;
+        if (memcmp(&x, &y, 16) && bad++ < 8) printf("LOAD MISMATCH at 0x%X\n", a);
+    }
+    for (unsigned long long it = 0; it < n; it++) {
+        const uint32_t a = rnd_addr();
+        if (rnd32() & 1) {
+            const u128 x = lean_read(&c1, a), y = spu_ls_read128(&c2, a); loads++;
+            if (memcmp(&x, &y, 16) && bad++ < 8) printf("LOAD MISMATCH at 0x%X\n", a);
+        } else {
+            u128 v; for (int i = 0; i < 4; i++) v._u32[i] = rnd32() ^ (rnd32() << 16);
+            spu_ls_write128_lean(&c1, a, v); spu_ls_write128(&c2, a, v); stores++;
+            const uint32_t l = a & (SPU_LS_MASK & ~0xFu);
+            if (memcmp(ls1 + l, ls2 + l, 16) && bad++ < 8) printf("STORE MISMATCH at 0x%X\n", a);
+        }
+    }
+    if (memcmp(ls1, ls2, SPU_LS_SIZE) && bad++ < 8) printf("LOCAL STORES DIFFER\n");
+    /* debug hooks armed: same values, same LS, same hook calls */
+    g_spu_ls_dbg = 1; g_spu_ls_watch_n = 1;
+    for (unsigned long long it = 0; it < n / 8; it++) {
+        const uint32_t a = rnd_addr();
+        c1.pc = c2.pc = rnd32(); c1.gpr[0]._u32[0] = c2.gpr[0]._u32[0] = rnd32();
+        uint64_t h1, h2;
+        if (rnd32() & 1) {
+            s_hook = 1; const u128 x = lean_read(&c1, a); h1 = s_hook;
+            s_hook = 1; const u128 y = spu_ls_read128(&c2, a); h2 = s_hook; loads++;
+            if ((memcmp(&x, &y, 16) || h1 != h2) && bad++ < 8) printf("DEBUG LOAD MISMATCH at 0x%X\n", a);
+        } else {
+            u128 v; for (int i = 0; i < 4; i++) v._u32[i] = rnd32() ^ (rnd32() << 16);
+            s_hook = 1; spu_ls_write128_lean(&c1, a, v); h1 = s_hook;
+            s_hook = 1; spu_ls_write128(&c2, a, v); h2 = s_hook; stores++;
+            const uint32_t l = a & (SPU_LS_MASK & ~0xFu);
+            if ((memcmp(ls1 + l, ls2 + l, 16) || h1 != h2) && bad++ < 8) printf("DEBUG STORE MISMATCH at 0x%X\n", a);
+        }
+    }
+    g_spu_ls_dbg = 0; g_spu_ls_watch_n = 0;
+    if (memcmp(ls1, ls2, SPU_LS_SIZE) && bad++ < 8) printf("LOCAL STORES DIFFER (debug pass)\n");
+    printf("test_spu_ls_lean: %llu loads, %llu stores, %llu mismatches\n", loads, stores, bad);
+    return bad != 0;
+}
diff --git a/runtime/spu/tests/test_spu_shufb_lean.c b/runtime/spu/tests/test_spu_shufb_lean.c
new file mode 100644
index 0000000..062fff5
--- /dev/null
+++ b/runtime/spu/tests/test_spu_shufb_lean.c
@@ -0,0 +1,64 @@
+/* spu_shufb_lean (what the lifter emits, no byte reversals) must be bit-identical to spu_shufb
+ * and to the byte-loop reference spu_shufb_ref for every control byte in every position: all 256
+ * control values in all 16 positions against random and patterned a/b, then random triples.
+ * Build on arm64:
+ *   cc -O2 -fno-strict-aliasing -fwrapv -I.. -I../../../include test_spu_shufb_lean.c -o t && ./t [N]
+ * -DPLANT_BUG breaks the lean form for one control value (0xDF): the test must then fail. */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static uint64_t s_rng = 0x2545F4914F6CDD1Dull;
+static uint8_t rnd8(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint8_t)(s_rng >> 24); }
+
+static u128 lean(u128 a, u128 b, u128 c)
+{
+    u128 r = spu_shufb_lean(a, b, c);
+#ifdef PLANT_BUG
+    for (int i = 0; i < 16; i++) if (c._u8[i] == 0xDF) r._u8[i] ^= 1;
+#endif
+    return r;
+}
+
+static unsigned long long s_n, s_bad;
+static void check(u128 a, u128 b, u128 c)
+{
+    const u128 x = lean(a, b, c), y = spu_shufb_ref(a, b, c), z = spu_shufb(a, b, c);
+    s_n++;
+    if ((memcmp(&x, &y, 16) || memcmp(&z, &y, 16)) && s_bad++ < 8) {
+        printf("MISMATCH c=");
+        for (int i = 0; i < 16; i++) printf("%02X", c._u8[i]);
+        printf(" lean=%08X%08X%08X%08X ref=%08X%08X%08X%08X\n", x._u32[0], x._u32[1], x._u32[2], x._u32[3],
+               y._u32[0], y._u32[1], y._u32[2], y._u32[3]);
+    }
+}
+
+int main(int argc, char** argv)
+{
+    const unsigned long long n = argc > 1 ? strtoull(argv[1], 0, 0) : 20000000ull;
+    u128 a, b, c;
+    /* every control value in every position: byte i of c = k + 37 i, k = 0..255, with
+     * random sources and with sources that name their own byte (a = 0..15, b = 16..31) */
+    for (int rep = 0; rep < 64; rep++)
+        for (int k = 0; k < 256; k++) {
+            for (int i = 0; i < 16; i++) {
+                c._u8[i] = (uint8_t)(k + 37 * i);
+                a._u8[i] = rep ? rnd8() : (uint8_t)i;
+                b._u8[i] = rep ? rnd8() : (uint8_t)(16 + i);
+            }
+            check(a, b, c);
+        }
+    /* random triples, controls biased to the 0x00..0x1F selectors and the specials' edges */
+    static const uint8_t edge[] = { 0x00, 0x0F, 0x10, 0x1F, 0x20, 0x3F, 0x60, 0x7F, 0x80, 0x9F,
+                                    0xA0, 0xBF, 0xC0, 0xDF, 0xE0, 0xFF };
+    for (unsigned long long it = 0; it < n; it++) {
+        for (int i = 0; i < 16; i++) {
+            a._u8[i] = rnd8(); b._u8[i] = rnd8();
+            const uint8_t r = rnd8();
+            c._u8[i] = (r & 3) == 0 ? edge[r >> 4] : (r & 3) == 1 ? (uint8_t)(rnd8() & 0x1F) : rnd8();
+        }
+        check(a, b, c);
+    }
+    printf("test_spu_shufb_lean: %llu vectors, %llu mismatches\n", s_n, s_bad);
+    return s_bad != 0;
+}
