+/* ---- DualSense extras: light bar, player lights, gyro aim -----------------
+ * A PS3 pad has none of these; on a DualSense (and a DualShock 4 for the
+ * light bar and the gyro):
+ *   - the player lights show the port (one lit for the first player);
+ *   - the light bar takes PS3_PAD_LIGHT=<RRGGBB> (a port sets its game's
+ *     colour; inFAMOUS 2 sets Cole's electric blue) or goes dark with "off";
+ *     unset leaves SDL's own colour. While the title runs the motors (hits,
+ *     explosions) it glows towards red with them, re-sent at most every
+ *     PAD_LIGHT_MIN_GAP_MS (PS3_PAD_LIGHT_HIT=0: a steady colour);
+ *   - gyro aim, PS3_PAD_GYRO=<percent> (0 off, 100 = full right-stick
+ *     deflection at 2 rad/s, about 115 degrees a second): turning and
+ *     tilting the controller adds to the right stick, only while the input
+ *     bound to the PS3's L1 (aim in inFAMOUS 2) is held, through the input
+ *     map so a rebind follows, unless PS3_PAD_GYRO_MODE=always. Turning left
+ *     looks left, tilting the top back looks up (PS3_PAD_GYRO_INVERT_Y=1
+ *     flips it). The resting gyro's jitter (under 0.015 rad/s) is dropped
+ *     and a small motion is lifted past the title's stick dead zone
+ *     (PS3_PAD_GYRO_DZ, 0.10 of the travel).
+ * -------------------------------------------------------------------------*/
+#define PAD_LIGHT_MIN_GAP_MS   40   /* light-bar reports at most this often */
+#define PAD_GYRO_AIM_CONTROL   PIM_L1
+#define PAD_GYRO_NOISE         0.015f   /* rad/s */
+
+typedef struct {
+    uint8_t r, g, b;              /* the colour last sent */
+    int led;                      /* the light bar takes colours */
+    unsigned long long led_ms;
+    int gyro;                     /* the gyro is on for this controller */
+} PadExtras;
+static PadExtras s_extra[PAD_MAX_HOST_PORTS];
+
+/* PS3_PAD_LIGHT: 1 a colour (in rgb), 0 unset, -1 off. */
+static int pad_light_cfg(uint8_t rgb[3])
+{
+    static int mode = -2;
+    static uint8_t c[3];
+    if (mode == -2) {
+        const char* e = getenv("PS3_PAD_LIGHT");
+        unsigned v = 0;
+        if (e && e[0] == '#') e++;
+        if (!e || !*e) mode = 0;
+        else if (!strcmp(e, "off")) mode = -1;
+        else if (strlen(e) == 6 && strspn(e, "0123456789abcdefABCDEF") == 6 && sscanf(e, "%6x", &v) == 1) {
+            mode = 1;
+            c[0] = (uint8_t)(v >> 16); c[1] = (uint8_t)(v >> 8); c[2] = (uint8_t)v;
+        } else {
+            fprintf(stderr, "[cellPad] PS3_PAD_LIGHT=%s: not RRGGBB or off, ignored\n", e);
+            mode = 0;
+        }
+    }
+    memcpy(rgb, c, 3);
+    if (mode < 0) rgb[0] = rgb[1] = rgb[2] = 0;
+    return mode;
+}
+static int pad_light_hit(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3_PAD_LIGHT_HIT"); on = !(e && e[0] == '0'); }
+    return on;
+}
+/* PS3_PAD_GYRO in percent, as a factor (0 = off, at most 4). */
+static float pad_gyro_sens(void)
+{
+    static float v = -1.0f;
+    if (v < 0.0f) {
+        const char* e = getenv("PS3_PAD_GYRO");
+        v = e && *e ? (float)atof(e) / 100.0f : 0.0f;
+        if (!(v >= 0.0f)) v = 0.0f;
+        if (v > 4.0f) v = 4.0f;
+    }
+    return v;
+}
+
+/* A new controller on port p: player lights, light bar, gyro. */
+static void pad_extras_open(int p, SDL_GameController* gc)
+{
+    PadExtras* x = &s_extra[p];
+    memset(x, 0, sizeof *x);
+    SDL_GameControllerSetPlayerIndex(gc, p);   /* the DualSense's player lights */
+    uint8_t c[3];
+    if (pad_light_cfg(c) && SDL_GameControllerHasLED(gc) && SDL_GameControllerSetLED(gc, c[0], c[1], c[2]) == 0) {
+        x->led = 1;
+        x->r = c[0]; x->g = c[1]; x->b = c[2];
+        x->led_ms = pad_now_ms();
+    }
+    if (pad_gyro_sens() > 0.0f && SDL_GameControllerHasSensor(gc, SDL_SENSOR_GYRO) &&
+        SDL_GameControllerSetSensorEnabled(gc, SDL_SENSOR_GYRO, SDL_TRUE) == 0) {
+        x->gyro = 1;
+        fprintf(stderr, "[cellPad] port %d: gyro aim on (%.0f%%)\n", p, pad_gyro_sens() * 100.0f);
+    }
+}
+
+/* The light bar for this poll: the colour, pulled towards red by the rumble. */
+static void pad_extras_light(int p, SDL_GameController* gc)
+{
+    PadExtras* x = &s_extra[p];
+    if (!x->led) return;
+    uint8_t c[3];
+    pad_light_cfg(c);
+    if (pad_light_hit()) {
+        const PadRumble* r = &s_rumble[p];
+        const unsigned level = r->lo > r->hi ? r->lo : r->hi;
+        const float t = (float)level / 65535.0f;
+        c[0] = (uint8_t)(c[0] + (255 - c[0]) * t);
+        c[1] = (uint8_t)(c[1] * (1.0f - t));
+        c[2] = (uint8_t)(c[2] * (1.0f - t));
+    }
+    if (c[0] == x->r && c[1] == x->g && c[2] == x->b) return;
+    const unsigned long long now = pad_now_ms();
+    if (now - x->led_ms < PAD_LIGHT_MIN_GAP_MS) return;
+    if (SDL_GameControllerSetLED(gc, c[0], c[1], c[2]) == 0) { x->r = c[0]; x->g = c[1]; x->b = c[2]; x->led_ms = now; }
+}
+
+/* Gyro aim: what the controller's turn this poll adds to the right stick
+ * (SDL axis units). `aim`: the input bound to aim is held. */
+static void pad_extras_gyro(int p, SDL_GameController* gc, int aim, int* rx, int* ry)
+{
+    PadExtras* x = &s_extra[p];
+    if (!x->gyro) return;
+    static int always = -1, inv_y = -1;
+    static float dz = -1.0f;
+    if (always < 0) { const char* e = getenv("PS3_PAD_GYRO_MODE"); always = e && !strcmp(e, "always"); }
+    if (inv_y < 0) { const char* e = getenv("PS3_PAD_GYRO_INVERT_Y"); inv_y = e && e[0] == '1'; }
+    if (dz < 0.0f) {
+        const char* e = getenv("PS3_PAD_GYRO_DZ");
+        dz = e && *e ? (float)atof(e) : 0.10f;
+        if (!(dz >= 0.0f) || dz > 0.5f) dz = 0.10f;
+    }
+    if (!always && !aim) return;
+    float g[3] = { 0, 0, 0 };   /* rad/s: pitch (x), yaw (y), roll (z) */
+    if (SDL_GameControllerGetSensorData(gc, SDL_SENSOR_GYRO, g, 3) != 0) return;
+    const float full = 2.0f / pad_gyro_sens();   /* rad/s for a full stick */
+    float a[2] = { -g[1], inv_y ? g[0] : -g[0] };
+    for (int k = 0; k < 2; k++) {
+        if (fabsf(a[k]) < PAD_GYRO_NOISE) { a[k] = 0.0f; continue; }
+        const float m = fminf(1.0f, fabsf(a[k]) / full);
+        a[k] = (a[k] > 0 ? 1.0f : -1.0f) * (dz + (1.0f - dz) * m);
+    }
+    const int nx = *rx + (int)(a[0] * 32767.0f), ny = *ry + (int)(a[1] * 32767.0f);
+    *rx = nx < -32768 ? -32768 : nx > 32767 ? 32767 : nx;
+    *ry = ny < -32768 ? -32768 : ny > 32767 ? 32767 : ny;
+}
