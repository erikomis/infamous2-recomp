shading-fixes.patch (2026-10-24, branch fix/shading): toolkit changes on top of the toolkit patch of main cdd1f41.

NV4097_SET_ZMIN_MAX_CONTROL depth clamp for the sun-shadow casters (set_depth_clamp,
PS3RECOMP_ENG_DEPTH_CLAMP=0 = old), vertex-cache prune of one-frame keys
(PS3RECOMP_ENG_VCACHE_PRUNE=1 = old), PS3RECOMP_ENG_CLAMP_CULL_FLIP (diagnostic),
PS3RECOMP_METAL_FRAME_DUMP_EVERY. Apply with: git apply -p1 inside ps3recomp-fork/.

--- a/include/ps3emu/ps3_toggles.h
+++ b/include/ps3emu/ps3_toggles.h
@@ -82,6 +82,8 @@
     PS3T_ENG_SHADOW_CMP,     /* rsx_draw_engine.c: RSX order of the depth compare */
     PS3T_ENG_ZTEX_CROP,      /* rsx_draw_engine.c: depth textures read their crop */
     PS3T_ENG_POLY_OFFSET,    /* rsx_draw_engine.c: polygon offset (depth bias)    */
+    PS3T_ENG_DEPTH_CLAMP,    /* rsx_draw_engine.c: ZMIN_MAX_CONTROL depth clamp   */
+    PS3T_ENG_CLAMP_CULL_FLIP,/* rsx_draw_engine.c: flip clamped draws (diagnostic)*/
     PS3T_COUNT
 };
 
@@ -134,6 +136,8 @@
         { "PS3RECOMP_ENG_SHADOW_CMP",   PS3_TK_NOT0, 1 },
         { "PS3RECOMP_ENG_ZTEX_CROP",    PS3_TK_NOT0, 1 },
         { "PS3RECOMP_ENG_POLY_OFFSET",  PS3_TK_ATOI, 1 },
+        { "PS3RECOMP_ENG_DEPTH_CLAMP",  PS3_TK_NOT0, 1 },
+        { "PS3RECOMP_ENG_CLAMP_CULL_FLIP", PS3_TK_ATOI, 0 },
     };
     return &d[id];
 }
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -174,6 +174,12 @@
      * clear consumers, mirroring COLOR_MASK/FRONT_FACE above. */
     rsx->regs[0x1D8C >> 2] = 0xFFFFFF00u;
 
+    /* NV40 reset ZMIN_MAX_CONTROL (0x1D78) is 1: cull (clip) at the near and
+     * far planes on, depth clamp off, the GCM default of
+     * cellGcmSetZMinMaxControl(CELL_GCM_TRUE, CELL_GCM_FALSE, CELL_GCM_FALSE).
+     * Seeded so a raw 0 means a game that turned clipping off. */
+    rsx->regs[0x1D78 >> 2] = 0x00000001u;
+
     /* Execution methods */
     mark_class(rsx, M_VERTEX_BEGIN_END,  1, RSX_DSP_CLASS_EXEC);
     mark_class(rsx, M_VB_VERTEX_BATCH,   1, RSX_DSP_CLASS_EXEC);
