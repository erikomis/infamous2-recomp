+/*
+ * ps3recomp - input mapping file for the host pad (cellPad.c)
+ *
+ * PS3_INPUT_MAP=<path> names a small text file (a TOML subset; an .ini
+ * written the same way reads the same) that rebinds the keyboard, the mouse
+ * buttons and a controller's buttons to PS3 controls, and holds the mouse
+ * camera's settings. Every control or setting the file leaves out keeps its
+ * built-in default, so an empty or missing file is exactly the old
+ * hard-coded layout. Names are case-insensitive; an unknown section, control
+ * or input name is reported once on stderr and ignored.
+ *
+ *   # comments start with '#' or ';'
+ *   [keyboard]                 # PS3 control = keys
+ *   cross    = "Space"
+ *   start    = "Return, KeypadEnter"     # several keys: a list ...
+ *   select   = ["Tab", "Backspace"]      # ... or a TOML array
+ *   l3       = ""                        # "" or "none": unbound
+ *   ls_up    = "W"
+ *
+ *   [mouse_buttons]            # PS3 control = mouse buttons
+ *   r1 = "Left"
+ *   r2 = "Right"
+ *   l1 = "Middle"
+ *   up = "WheelUp"
+ *
+ *   [mouse]                    # the mouse camera (right stick)
+ *   camera      = true         # PS3_MOUSE
+ *   sensitivity = 1.0          # PS3_MOUSE_SENS
+ *   invert_x    = false        # PS3_MOUSE_INVERT_X
+ *   invert_y    = false        # PS3_MOUSE_INVERT_Y
+ *   deadzone    = 30           # PS3_MOUSE_DEADZONE (0-120)
+ *   capture     = true         # PS3_MOUSE_CAPTURE: a click captures the cursor
+ *
+ *   [controller]               # PS3 control = SDL GameController inputs
+ *   cross = "a"                # (Cross on a DualSense, A on an Xbox pad)
+ *   r2    = "righttrigger"
+ *
+ * The environment variables in the comments win over the file. An input the
+ * file binds leaves the controls the file does not mention: `cross = "Q"`
+ * takes Q off its default, circle (list it under both to keep both).
+ *
+ * PS3 controls: up down left right (D-pad), cross circle square triangle,
+ * l1 r1 l2 r2 l3 r3, start select, ls_up ls_down ls_left ls_right (left
+ * stick), rs_up rs_down rs_left rs_right (right stick).
+ *
+ * Keys (macOS virtual key codes, US layout positions): A-Z, 0-9, F1-F20,
+ * Space Return Tab Escape Backspace ForwardDelete Up Down Left Right Home
+ * End PageUp PageDown Help, Minus Equal LeftBracket RightBracket Backslash
+ * Semicolon Quote Comma Period Slash Grave Section, Keypad0-Keypad9
+ * KeypadEnter KeypadPlus KeypadMinus KeypadMultiply KeypadDivide
+ * KeypadDecimal KeypadEquals KeypadClear, Shift RightShift Control
+ * RightControl Option RightOption, or a raw code as 0x00-0x7F. Cmd is the
+ * window's (it releases the mouse) and cannot be bound.
+ *
+ * Mouse buttons: Left Right Middle Button4-Button8 WheelUp WheelDown.
+ *
+ * Controller inputs (SDL names): a b x y back guide start leftstick
+ * rightstick leftshoulder rightshoulder dpup dpdown dpleft dpright misc1
+ * paddle1-paddle4 touchpad lefttrigger righttrigger; PlayStation and Xbox
+ * names are accepted as aliases (cross circle square triangle, l1 r1 l2 r2
+ * l3 r3, share create options ps, view menu home). The physical sticks always
+ * drive the PS3 sticks; a stick direction bound to a button pushes that
+ * axis to the end while it is held.
+ *
+ * This header is the parser only (no SDL, no AppKit), so it builds into a
+ * standalone test: libs/input/tests/test_pad_input_map.c.
+ */
+#ifndef PS3RECOMP_PAD_INPUT_MAP_H
+#define PS3RECOMP_PAD_INPUT_MAP_H
+
+#include <ctype.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* PS3 controls. 0-15 are the CELL_PAD_CTRL_* bit numbers, so a mask of
+ * pressed controls is the cellPad button word in its low 16 bits. */
+enum {
+    PIM_SELECT, PIM_L3, PIM_R3, PIM_START, PIM_UP, PIM_RIGHT, PIM_DOWN, PIM_LEFT,
+    PIM_L2, PIM_R2, PIM_L1, PIM_R1, PIM_TRIANGLE, PIM_CIRCLE, PIM_CROSS, PIM_SQUARE,
+    PIM_LS_UP, PIM_LS_DOWN, PIM_LS_LEFT, PIM_LS_RIGHT,
+    PIM_RS_UP, PIM_RS_DOWN, PIM_RS_LEFT, PIM_RS_RIGHT,
+    PIM_N_CONTROLS
+};
+
+/* Mouse inputs: bit n = NSEvent buttonNumber n (1 left, 2 right, 4 middle,
+ * 8 button 4, ...), as the window keeps them in g_pad_mouse_buttons; the
+ * wheel's two directions are synthetic presses above them. */
+#define PIM_MOUSE_WHEEL_UP    (1u << 24)
+#define PIM_MOUSE_WHEEL_DOWN  (1u << 25)
+
+/* Controller inputs: bit n = SDL_GameControllerButton n (stable values since
+ * SDL 2.0; 15-20 need SDL 2.0.14+), plus the two triggers read as buttons. */
+#define PIM_PAD_TRIGGER_LEFT   21
+#define PIM_PAD_TRIGGER_RIGHT  22
+
+typedef struct {
+    uint32_t key[PIM_N_CONTROLS][4];   /* 128 key codes, like g_pad_host_keys */
+    uint32_t mouse[PIM_N_CONTROLS];
+    uint32_t pad[PIM_N_CONTROLS];
+    /* [mouse]; -1 (or 0 for sens) = not in the file */
+    int   mouse_camera, mouse_invert_x, mouse_invert_y, mouse_deadzone, mouse_capture;
+    float mouse_sens;
+    int   n_set;        /* controls/settings the file changed */
+    int   n_warnings;   /* names it did not know */
+} PadInputMap;
+
+typedef struct { const char* name; int id; } PimName;
+
+static const PimName pim_controls[] = {
+    {"select", PIM_SELECT}, {"l3", PIM_L3}, {"r3", PIM_R3}, {"start", PIM_START},
+    {"up", PIM_UP}, {"right", PIM_RIGHT}, {"down", PIM_DOWN}, {"left", PIM_LEFT},
+    {"l2", PIM_L2}, {"r2", PIM_R2}, {"l1", PIM_L1}, {"r1", PIM_R1},
+    {"triangle", PIM_TRIANGLE}, {"circle", PIM_CIRCLE}, {"cross", PIM_CROSS}, {"square", PIM_SQUARE},
+    {"ls_up", PIM_LS_UP}, {"ls_down", PIM_LS_DOWN}, {"ls_left", PIM_LS_LEFT}, {"ls_right", PIM_LS_RIGHT},
+    {"rs_up", PIM_RS_UP}, {"rs_down", PIM_RS_DOWN}, {"rs_left", PIM_RS_LEFT}, {"rs_right", PIM_RS_RIGHT},
+    /* aliases */
+    {"dpad_up", PIM_UP}, {"dpad_down", PIM_DOWN}, {"dpad_left", PIM_LEFT}, {"dpad_right", PIM_RIGHT},
+    {"left_stick_up", PIM_LS_UP}, {"left_stick_down", PIM_LS_DOWN},
+    {"left_stick_left", PIM_LS_LEFT}, {"left_stick_right", PIM_LS_RIGHT},
+    {"right_stick_up", PIM_RS_UP}, {"right_stick_down", PIM_RS_DOWN},
+    {"right_stick_left", PIM_RS_LEFT}, {"right_stick_right", PIM_RS_RIGHT},
+};
+
+static const PimName pim_keys[] = {
+    {"a", 0x00}, {"s", 0x01}, {"d", 0x02}, {"f", 0x03}, {"h", 0x04}, {"g", 0x05},
+    {"z", 0x06}, {"x", 0x07}, {"c", 0x08}, {"v", 0x09}, {"section", 0x0A}, {"b", 0x0B},
+    {"q", 0x0C}, {"w", 0x0D}, {"e", 0x0E}, {"r", 0x0F}, {"y", 0x10}, {"t", 0x11},
+    {"1", 0x12}, {"2", 0x13}, {"3", 0x14}, {"4", 0x15}, {"6", 0x16}, {"5", 0x17},
+    {"equal", 0x18}, {"9", 0x19}, {"7", 0x1A}, {"minus", 0x1B}, {"8", 0x1C}, {"0", 0x1D},
+    {"rightbracket", 0x1E}, {"o", 0x1F}, {"u", 0x20}, {"leftbracket", 0x21}, {"i", 0x22},
+    {"p", 0x23}, {"return", 0x24}, {"l", 0x25}, {"j", 0x26}, {"quote", 0x27}, {"k", 0x28},
+    {"semicolon", 0x29}, {"backslash", 0x2A}, {"comma", 0x2B}, {"slash", 0x2C},
+    {"n", 0x2D}, {"m", 0x2E}, {"period", 0x2F}, {"tab", 0x30}, {"space", 0x31},
+    {"grave", 0x32}, {"backspace", 0x33}, {"escape", 0x35},
+    {"shift", 0x38}, {"option", 0x3A}, {"control", 0x3B},
+    {"rightshift", 0x3C}, {"rightoption", 0x3D}, {"rightcontrol", 0x3E},
+    {"f17", 0x40}, {"keypaddecimal", 0x41}, {"keypadmultiply", 0x43}, {"keypadplus", 0x45},
+    {"keypadclear", 0x47}, {"keypaddivide", 0x4B}, {"keypadenter", 0x4C},
+    {"keypadminus", 0x4E}, {"f18", 0x4F}, {"f19", 0x50}, {"keypadequals", 0x51},
+    {"keypad0", 0x52}, {"keypad1", 0x53}, {"keypad2", 0x54}, {"keypad3", 0x55},
+    {"keypad4", 0x56}, {"keypad5", 0x57}, {"keypad6", 0x58}, {"keypad7", 0x59},
+    {"f20", 0x5A}, {"keypad8", 0x5B}, {"keypad9", 0x5C},
+    {"f5", 0x60}, {"f6", 0x61}, {"f7", 0x62}, {"f3", 0x63}, {"f8", 0x64}, {"f9", 0x65},
+    {"f11", 0x67}, {"f13", 0x69}, {"f16", 0x6A}, {"f14", 0x6B}, {"f10", 0x6D},
+    {"f12", 0x6F}, {"f15", 0x71}, {"help", 0x72}, {"home", 0x73}, {"pageup", 0x74},
+    {"forwarddelete", 0x75}, {"f4", 0x76}, {"end", 0x77}, {"f2", 0x78},
+    {"pagedown", 0x79}, {"f1", 0x7A}, {"left", 0x7B}, {"right", 0x7C},
+    {"down", 0x7D}, {"up", 0x7E},
+    /* aliases */
+    {"enter", 0x24}, {"esc", 0x35}, {"delete", 0x33}, {"backquote", 0x32},
+    {"leftshift", 0x38}, {"leftcontrol", 0x3B}, {"leftoption", 0x3A},
+    {"ctrl", 0x3B}, {"alt", 0x3A}, {"rightctrl", 0x3E}, {"rightalt", 0x3D},
+    {"insert", 0x72}, {"numlock", 0x47},
+    {"arrowup", 0x7E}, {"arrowdown", 0x7D}, {"arrowleft", 0x7B}, {"arrowright", 0x7C},
+};
+
+static const PimName pim_mouse_buttons[] = {
+    {"left", 1}, {"right", 2}, {"middle", 4}, {"button4", 8}, {"button5", 16},
+    {"button6", 32}, {"button7", 64}, {"button8", 128},
+    {"wheelup", (int)PIM_MOUSE_WHEEL_UP}, {"wheeldown", (int)PIM_MOUSE_WHEEL_DOWN},
+    {"back", 8}, {"forward", 16},
+};
+
+static const PimName pim_pad_inputs[] = {
+    {"a", 0}, {"b", 1}, {"x", 2}, {"y", 3}, {"back", 4}, {"guide", 5}, {"start", 6},
+    {"leftstick", 7}, {"rightstick", 8}, {"leftshoulder", 9}, {"rightshoulder", 10},
+    {"dpup", 11}, {"dpdown", 12}, {"dpleft", 13}, {"dpright", 14}, {"misc1", 15},
+    {"paddle1", 16}, {"paddle2", 17}, {"paddle3", 18}, {"paddle4", 19}, {"touchpad", 20},
+    {"lefttrigger", PIM_PAD_TRIGGER_LEFT}, {"righttrigger", PIM_PAD_TRIGGER_RIGHT},
+    /* PlayStation / Xbox names */
+    {"cross", 0}, {"circle", 1}, {"square", 2}, {"triangle", 3},
+    {"share", 4}, {"create", 4}, {"select", 4}, {"view", 4},
+    {"ps", 5}, {"home", 5}, {"options", 6}, {"menu", 6},
+    {"l3", 7}, {"r3", 8}, {"l1", 9}, {"r1", 10}, {"lb", 9}, {"rb", 10},
+    {"up", 11}, {"down", 12}, {"left", 13}, {"right", 14},
+    {"l2", PIM_PAD_TRIGGER_LEFT}, {"r2", PIM_PAD_TRIGGER_RIGHT},
+    {"lt", PIM_PAD_TRIGGER_LEFT}, {"rt", PIM_PAD_TRIGGER_RIGHT},
+};
+
+#define PIM_COUNT(a) (int)(sizeof(a) / sizeof((a)[0]))
+
+static int pim_lookup(const PimName* t, int n, const char* name)
+{
+    for (int i = 0; i < n; i++)
+        if (!strcmp(t[i].name, name)) return t[i].id;
+    return -1;
+}
+
+static void pim_key_set(uint32_t m[4], unsigned vk) { m[(vk >> 5) & 3] |= 1u << (vk & 31); }
+
+/* The built-in layout: what cellPad.c hard-coded before the file existed. */
+static void pim_defaults(PadInputMap* m)
+{
+    memset(m, 0, sizeof *m);
+    static const struct { int ctl; unsigned char vk; } keys[] = {
+        {PIM_UP, 0x7E}, {PIM_DOWN, 0x7D}, {PIM_LEFT, 0x7B}, {PIM_RIGHT, 0x7C},
+        {PIM_CROSS, 0x31}, {PIM_CIRCLE, 0x0C}, {PIM_SQUARE, 0x0E}, {PIM_TRIANGLE, 0x0F},
+        {PIM_L1, 0x20}, {PIM_R1, 0x1F}, {PIM_L2, 0x10}, {PIM_R2, 0x23},
+        {PIM_L3, 0x05}, {PIM_R3, 0x04},
+        {PIM_START, 0x24}, {PIM_START, 0x4C},          /* Return, keypad Enter */
+        {PIM_SELECT, 0x30},
+        {PIM_LS_UP, 0x0D}, {PIM_LS_LEFT, 0x00}, {PIM_LS_DOWN, 0x01}, {PIM_LS_RIGHT, 0x02},   /* WASD */
+        {PIM_RS_UP, 0x22}, {PIM_RS_LEFT, 0x26}, {PIM_RS_DOWN, 0x28}, {PIM_RS_RIGHT, 0x25},   /* IJKL */
+    };
+    for (int i = 0; i < PIM_COUNT(keys); i++) pim_key_set(m->key[keys[i].ctl], keys[i].vk);
+    m->mouse[PIM_R1] = 1;   /* left: bolt */
+    m->mouse[PIM_R2] = 2;   /* right: grenade */
+    m->mouse[PIM_L1] = 0xFC;   /* middle: aim (and buttons 4-8, which the window
+                                  * once reported as the middle one) */
+    static const struct { int ctl; int in; } pad[] = {
+        {PIM_SELECT, 4}, {PIM_L3, 7}, {PIM_R3, 8}, {PIM_START, 6},
+        {PIM_UP, 11}, {PIM_RIGHT, 14}, {PIM_DOWN, 12}, {PIM_LEFT, 13},
+        {PIM_L1, 9}, {PIM_R1, 10}, {PIM_TRIANGLE, 3}, {PIM_CIRCLE, 1},
+        {PIM_CROSS, 0}, {PIM_SQUARE, 2},
+        {PIM_L2, PIM_PAD_TRIGGER_LEFT}, {PIM_R2, PIM_PAD_TRIGGER_RIGHT},
+    };
+    for (int i = 0; i < PIM_COUNT(pad); i++) m->pad[pad[i].ctl] |= 1u << pad[i].in;
+    m->mouse_camera = m->mouse_invert_x = m->mouse_invert_y = m->mouse_deadzone = m->mouse_capture = -1;
+    m->mouse_sens = 0.0f;
+}
+
+/* ---- parsing ---------------------------------------------------------- */
+
+enum { PIM_SEC_NONE, PIM_SEC_KEYBOARD, PIM_SEC_MOUSE_BUTTONS, PIM_SEC_MOUSE,
+       PIM_SEC_CONTROLLER, PIM_SEC_UNKNOWN };
+
+static void pim_lower(char* s) { for (; *s; s++) *s = (char)tolower((unsigned char)*s); }
+
+static char* pim_trim(char* s)
+{
+    while (*s == ' ' || *s == '\t') s++;
+    char* e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) *--e = 0;
+    return s;
+}
+
+static void pim_warn(PadInputMap* m, FILE* err, const char* src, int line, const char* what, const char* name)
+{
+    m->n_warnings++;
+    if (err) fprintf(err, "[cellPad] %s:%d: unknown %s '%s' (ignored)\n", src, line, what, name);
+}
+
+/* Cut a line's comment ('#' or ';' outside quotes). */
+static void pim_strip_comment(char* s)
+{
+    char q = 0;
+    for (; *s; s++) {
+        if (q) { if (*s == q) q = 0; continue; }
+        if (*s == '"' || *s == '\'') q = *s;
+        else if (*s == '#' || *s == ';') { *s = 0; return; }
+    }
+}
+
+/* A value is a string ("..." or '...'), an array of strings, or a bare word.
+ * Every form flattens to a list split on commas; quotes and brackets go. */
+static void pim_flatten(char* v)
+{
+    char* w = v;
+    for (char* r = v; *r; r++)
+        if (*r != '"' && *r != '\'' && *r != '[' && *r != ']') *w++ = *r;
+    *w = 0;
+}
+
+static int pim_bool(const char* v, int* out)
+{
+    if (!strcmp(v, "true") || !strcmp(v, "1") || !strcmp(v, "yes") || !strcmp(v, "on")) { *out = 1; return 1; }
+    if (!strcmp(v, "false") || !strcmp(v, "0") || !strcmp(v, "no") || !strcmp(v, "off")) { *out = 0; return 1; }
+    return 0;
+}
+
+static int pim_parse_key_name(const char* name)
+{
+    int id = pim_lookup(pim_keys, PIM_COUNT(pim_keys), name);
+    if (id >= 0) return id;
+    if (name[0] == '0' && name[1] == 'x' && name[2]) {
+        char* end; long v = strtol(name + 2, &end, 16);
+        if (!*end && v >= 0 && v < 128) return (int)v;
+    }
+    return -1;
+}
+
+/* One "control = inputs" line of a binding section. */
+static void pim_bind(PadInputMap* m, int sec, int ctl, char* list, FILE* err, const char* src, int line)
+{
+    uint32_t keys[4] = {0, 0, 0, 0}, bits = 0;
+    /* no strtok: cellPad's PS3_PAD_FILE reader uses it from the poll thread */
+    for (char *tok = list, *next; tok; tok = next) {
+        next = strchr(tok, ',');
+        if (next) *next++ = 0;
+        char* name = pim_trim(tok);
+        if (!*name || !strcmp(name, "none")) continue;
+        if (sec == PIM_SEC_KEYBOARD) {
+            int vk = pim_parse_key_name(name);
+            if (vk < 0) { pim_warn(m, err, src, line, "key", name); continue; }
+            pim_key_set(keys, (unsigned)vk);
+        } else if (sec == PIM_SEC_MOUSE_BUTTONS) {
+            int b = pim_lookup(pim_mouse_buttons, PIM_COUNT(pim_mouse_buttons), name);
+            if (b < 0) { pim_warn(m, err, src, line, "mouse button", name); continue; }
+            bits |= (uint32_t)b;
+        } else {
+            int b = pim_lookup(pim_pad_inputs, PIM_COUNT(pim_pad_inputs), name);
+            if (b < 0) { pim_warn(m, err, src, line, "controller input", name); continue; }
+            bits |= 1u << b;
+        }
+    }
+    if (sec == PIM_SEC_KEYBOARD) memcpy(m->key[ctl], keys, sizeof keys);
+    else if (sec == PIM_SEC_MOUSE_BUTTONS) m->mouse[ctl] = bits;
+    else m->pad[ctl] = bits;
+    m->n_set++;
+}
+
+static void pim_mouse_setting(PadInputMap* m, const char* key, const char* v, FILE* err, const char* src, int line)
+{
+    int b;
+    if (!strcmp(key, "camera") || !strcmp(key, "enabled")) {
+        if (pim_bool(v, &b)) { m->mouse_camera = b; m->n_set++; return; }
+    } else if (!strcmp(key, "capture")) {
+        if (pim_bool(v, &b)) { m->mouse_capture = b; m->n_set++; return; }
+    } else if (!strcmp(key, "invert_x")) {
+        if (pim_bool(v, &b)) { m->mouse_invert_x = b; m->n_set++; return; }
+    } else if (!strcmp(key, "invert_y")) {
+        if (pim_bool(v, &b)) { m->mouse_invert_y = b; m->n_set++; return; }
+    } else if (!strcmp(key, "sensitivity") || !strcmp(key, "sens")) {
+        char* end; float f = strtof(v, &end);
+        if (end != v && !*end && f > 0.0f) { m->mouse_sens = f; m->n_set++; return; }
+    } else if (!strcmp(key, "deadzone")) {
+        char* end; long n = strtol(v, &end, 10);
+        if (end != v && !*end) { m->mouse_deadzone = n < 0 ? 0 : n > 120 ? 120 : (int)n; m->n_set++; return; }
+    } else {
+        pim_warn(m, err, src, line, "mouse setting", key);
+        return;
+    }
+    pim_warn(m, err, src, line, "value for mouse setting", v);
+}
+
+/* Apply a whole file's text on top of what *m holds (call pim_defaults
+ * first). `src` names it in the warnings; `err` may be NULL. Returns the
+ * number of warnings. */
+static int pim_parse(PadInputMap* m, const char* text, FILE* err, const char* src)
+{
+    int sec = PIM_SEC_NONE, line_no = 0;
+    const int start_warnings = m->n_warnings;
+    uint32_t set_key = 0, set_mouse = 0, set_pad = 0;   /* controls this text binds */
+    const char* p = text;
+    while (*p) {
+        const char* nl = strchr(p, '\n');
+        size_t len = nl ? (size_t)(nl - p) : strlen(p);
+        char buf[1024];
+        line_no++;
+        if (len >= sizeof buf) len = sizeof buf - 1;   /* overlong lines are cut, not fatal */
+        memcpy(buf, p, len); buf[len] = 0;
+        p = nl ? nl + 1 : p + strlen(p);
+
+        pim_strip_comment(buf);
+        char* s = pim_trim(buf);
+        if (!*s) continue;
+        if (*s == '[') {
+            char* e = strchr(s, ']');
+            if (e) *e = 0;
+            char* name = pim_trim(s + 1);
+            pim_lower(name);
+            if (!strcmp(name, "keyboard") || !strcmp(name, "keys")) sec = PIM_SEC_KEYBOARD;
+            else if (!strcmp(name, "mouse_buttons") || !strcmp(name, "mouse.buttons")) sec = PIM_SEC_MOUSE_BUTTONS;
+            else if (!strcmp(name, "mouse")) sec = PIM_SEC_MOUSE;
+            else if (!strcmp(name, "controller") || !strcmp(name, "gamepad") || !strcmp(name, "pad")) sec = PIM_SEC_CONTROLLER;
+            else { sec = PIM_SEC_UNKNOWN; pim_warn(m, err, src, line_no, "section", name); }
+            continue;
+        }
+        char* eq = strchr(s, '=');
+        if (!eq) { pim_warn(m, err, src, line_no, "line", s); continue; }
+        *eq = 0;
+        char* key = pim_trim(s);
+        char* val = pim_trim(eq + 1);
+        pim_flatten(key);
+        pim_flatten(val);
+        key = pim_trim(key);
+        val = pim_trim(val);
+        pim_lower(key);
+        pim_lower(val);
+        if (sec == PIM_SEC_UNKNOWN) continue;              /* already reported */
+        if (sec == PIM_SEC_NONE) { pim_warn(m, err, src, line_no, "setting outside a section", key); continue; }
+        if (sec == PIM_SEC_MOUSE) { pim_mouse_setting(m, key, val, err, src, line_no); continue; }
+        const int ctl = pim_lookup(pim_controls, PIM_COUNT(pim_controls), key);
+        if (ctl < 0) { pim_warn(m, err, src, line_no, "PS3 control", key); continue; }
+        pim_bind(m, sec, ctl, val, err, src, line_no);
+        if (sec == PIM_SEC_KEYBOARD) set_key |= 1u << ctl;
+        else if (sec == PIM_SEC_MOUSE_BUTTONS) set_mouse |= 1u << ctl;
+        else set_pad |= 1u << ctl;
+    }
+    /* An input bound here leaves the controls not mentioned here. */
+    uint32_t keys[4] = {0, 0, 0, 0}, mouse = 0, pad = 0;
+    for (int c = 0; c < PIM_N_CONTROLS; c++) {
+        if (set_key >> c & 1) for (int i = 0; i < 4; i++) keys[i] |= m->key[c][i];
+        if (set_mouse >> c & 1) mouse |= m->mouse[c];
+        if (set_pad >> c & 1) pad |= m->pad[c];
+    }
+    for (int c = 0; c < PIM_N_CONTROLS; c++) {
+        if (!(set_key >> c & 1)) for (int i = 0; i < 4; i++) m->key[c][i] &= ~keys[i];
+        if (!(set_mouse >> c & 1)) m->mouse[c] &= ~mouse;
+        if (!(set_pad >> c & 1)) m->pad[c] &= ~pad;
+    }
+    return m->n_warnings - start_warnings;
+}
+
+/* Defaults, then the file at `path` on top. Returns 1 if the file was read,
+ * 0 if it could not be opened (the defaults stand). */
+static int pim_load_file(PadInputMap* m, const char* path, FILE* err)
+{
+    pim_defaults(m);
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    size_t cap = 4096, n = 0;
+    char* text = (char*)malloc(cap);
+    if (!text) { fclose(f); return 0; }
+    for (;;) {
+        if (n + 1024 + 1 > cap) {
+            if (cap >= (1u << 20)) break;   /* a mapping is a few KB; stop at 1 MB */
+            char* t = (char*)realloc(text, cap * 2);
+            if (!t) break;
+            text = t; cap *= 2;
+        }
+        size_t r = fread(text + n, 1, 1024, f);
+        n += r;
+        if (r < 1024) break;
+    }
+    fclose(f);
+    text[n] = 0;
+    pim_parse(m, text, err, path);
+    free(text);
+    return 1;
+}
+
+/* Any key of control `ctl` held in a 128-bit key state. */
+static int pim_keys_hit(const PadInputMap* m, int ctl, const uint32_t keys[4])
+{
+    const uint32_t* k = m->key[ctl];
+    return ((k[0] & keys[0]) | (k[1] & keys[1]) | (k[2] & keys[2]) | (k[3] & keys[3])) != 0;
+}
+
+#endif /* PS3RECOMP_PAD_INPUT_MAP_H */
diff --git a/libs/input/tests/test_pad_input_map.c b/libs/input/tests/test_pad_input_map.c
new file mode 100644
index 0000000..cbc41d0
--- /dev/null
+++ b/libs/input/tests/test_pad_input_map.c
@@ -0,0 +1,230 @@
+/* The PS3_INPUT_MAP parser (pad_input_map.h): defaults, rebinding, the value
+ * forms, the [mouse] settings and unknown names.
+ *
+ *   cc -std=gnu17 -Wall -Wextra libs/input/tests/test_pad_input_map.c \
+ *      -o /tmp/test_pad_input_map && /tmp/test_pad_input_map
+ */
+#include "../pad_input_map.h"
+#include <assert.h>
+
+static int key_of(const PadInputMap* m, int ctl, unsigned vk)
+{
+    return (m->key[ctl][vk >> 5] >> (vk & 31)) & 1;
+}
+
+static int n_keys(const PadInputMap* m, int ctl)
+{
+    int n = 0;
+    for (unsigned vk = 0; vk < 128; vk++) n += key_of(m, ctl, vk);
+    return n;
+}
+
+/* The defaults are the layout cellPad.c hard-coded before the file. */
+static void test_defaults(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    static const struct { int ctl; unsigned vk; } old[] = {
+        {PIM_UP, 0x7E}, {PIM_DOWN, 0x7D}, {PIM_LEFT, 0x7B}, {PIM_RIGHT, 0x7C},
+        {PIM_CROSS, 0x31}, {PIM_CIRCLE, 0x0C}, {PIM_SQUARE, 0x0E}, {PIM_TRIANGLE, 0x0F},
+        {PIM_L1, 0x20}, {PIM_R1, 0x1F}, {PIM_L2, 0x10}, {PIM_R2, 0x23},
+        {PIM_L3, 0x05}, {PIM_R3, 0x04}, {PIM_START, 0x24}, {PIM_START, 0x4C},
+        {PIM_SELECT, 0x30},
+        {PIM_LS_RIGHT, 0x02}, {PIM_LS_LEFT, 0x00}, {PIM_LS_DOWN, 0x01}, {PIM_LS_UP, 0x0D},
+        {PIM_RS_RIGHT, 0x25}, {PIM_RS_LEFT, 0x26}, {PIM_RS_DOWN, 0x28}, {PIM_RS_UP, 0x22},
+    };
+    int total = 0;
+    for (unsigned i = 0; i < sizeof old / sizeof old[0]; i++) assert(key_of(&m, old[i].ctl, old[i].vk));
+    for (int c = 0; c < PIM_N_CONTROLS; c++) total += n_keys(&m, c);
+    assert(total == (int)(sizeof old / sizeof old[0]));   /* nothing else bound */
+    assert(m.mouse[PIM_R1] == 1 && m.mouse[PIM_R2] == 2 && m.mouse[PIM_L1] == 0xFC);   /* middle, 4-8 */
+    for (int c = 0; c < PIM_N_CONTROLS; c++)
+        if (c != PIM_R1 && c != PIM_R2 && c != PIM_L1) assert(m.mouse[c] == 0);
+    /* controller: each SDL button its namesake, triggers L2/R2, sticks unbound */
+    assert(m.pad[PIM_CROSS] == 1u << 0 && m.pad[PIM_CIRCLE] == 1u << 1);
+    assert(m.pad[PIM_SQUARE] == 1u << 2 && m.pad[PIM_TRIANGLE] == 1u << 3);
+    assert(m.pad[PIM_SELECT] == 1u << 4 && m.pad[PIM_START] == 1u << 6);
+    assert(m.pad[PIM_L3] == 1u << 7 && m.pad[PIM_R3] == 1u << 8);
+    assert(m.pad[PIM_L1] == 1u << 9 && m.pad[PIM_R1] == 1u << 10);
+    assert(m.pad[PIM_UP] == 1u << 11 && m.pad[PIM_DOWN] == 1u << 12);
+    assert(m.pad[PIM_LEFT] == 1u << 13 && m.pad[PIM_RIGHT] == 1u << 14);
+    assert(m.pad[PIM_L2] == 1u << PIM_PAD_TRIGGER_LEFT && m.pad[PIM_R2] == 1u << PIM_PAD_TRIGGER_RIGHT);
+    for (int c = PIM_LS_UP; c < PIM_N_CONTROLS; c++) assert(m.pad[c] == 0);
+    assert(m.mouse_camera == -1 && m.mouse_sens == 0.0f && m.mouse_deadzone == -1);
+    assert(m.n_set == 0 && m.n_warnings == 0);
+}
+
+static void test_empty_and_comments(void)
+{
+    PadInputMap a, b;
+    pim_defaults(&a);
+    pim_defaults(&b);
+    assert(pim_parse(&b, "", NULL, "t") == 0);
+    assert(pim_parse(&b, "# only a comment\n\n   ; another\n[keyboard]\n", NULL, "t") == 0);
+    assert(!memcmp(&a, &b, sizeof a));
+}
+
+static void test_rebind(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    const char* text =
+        "# a remap\r\n"
+        "[Keyboard]\r\n"
+        "cross = \"F\"            # one key\r\n"
+        "start = 'Return, Escape'\r\n"
+        "select = [\"Tab\", \"backspace\"]\r\n"
+        "L3 = \"\"\r\n"
+        "r3 = none\r\n"
+        "ls_up = Up\r\n"
+        "circle = \"Shift, RightOption, 0x0A\"\r\n"
+        "[mouse_buttons]\n"
+        "r1 = \"Right\"\n"
+        "r2 = \"Left\"\n"
+        "up = \"WheelUp\"\n"
+        "down = \"wheeldown, Button4\"\n"
+        "l1 = \"\"\n"
+        "[controller]\n"
+        "cross = \"b\"\n"
+        "circle = \"cross\"\n"
+        "select = \"touchpad, back\"\n"
+        "r1 = \"righttrigger\"\n"
+        "r2 = \"rightshoulder\"\n"
+        "rs_up = \"paddle1\"\n";
+    assert(pim_parse(&m, text, stderr, "rebind") == 0);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x03));
+    assert(n_keys(&m, PIM_START) == 2 && key_of(&m, PIM_START, 0x24) && key_of(&m, PIM_START, 0x35));
+    assert(n_keys(&m, PIM_SELECT) == 2 && key_of(&m, PIM_SELECT, 0x30) && key_of(&m, PIM_SELECT, 0x33));
+    assert(n_keys(&m, PIM_L3) == 0 && n_keys(&m, PIM_R3) == 0);
+    assert(n_keys(&m, PIM_LS_UP) == 1 && key_of(&m, PIM_LS_UP, 0x7E));
+    assert(n_keys(&m, PIM_UP) == 0);                     /* Up left the D-pad, which the file does not mention */
+    assert(n_keys(&m, PIM_CIRCLE) == 3 && key_of(&m, PIM_CIRCLE, 0x38) &&
+           key_of(&m, PIM_CIRCLE, 0x3D) && key_of(&m, PIM_CIRCLE, 0x0A));
+    assert(key_of(&m, PIM_SQUARE, 0x0E));                /* untouched controls keep their defaults */
+    assert(m.mouse[PIM_R1] == 2 && m.mouse[PIM_R2] == 1 && m.mouse[PIM_L1] == 0);
+    assert(m.mouse[PIM_UP] == PIM_MOUSE_WHEEL_UP);
+    assert(m.mouse[PIM_DOWN] == (PIM_MOUSE_WHEEL_DOWN | 8u));
+    assert(m.pad[PIM_CROSS] == 1u << 1 && m.pad[PIM_CIRCLE] == 1u << 0);
+    assert(m.pad[PIM_SELECT] == ((1u << 20) | (1u << 4)));
+    assert(m.pad[PIM_R1] == 1u << PIM_PAD_TRIGGER_RIGHT && m.pad[PIM_R2] == 1u << 10);
+    assert(m.pad[PIM_RS_UP] == 1u << 16);
+    assert(m.pad[PIM_SQUARE] == 1u << 2);
+    assert(m.n_set == 18);
+}
+
+/* Bound here = gone from the controls the text does not mention; listed
+ * twice = kept twice. */
+static void test_steal_and_overlap(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[keyboard]\ncross = \"Q\"\n[mouse_buttons]\nr2 = \"Button4\"\n", NULL, "s") == 0);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && n_keys(&m, PIM_CIRCLE) == 0);
+    assert(m.mouse[PIM_R2] == 8 && m.mouse[PIM_L1] == (0xFCu & ~8u));
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[keyboard]\ncross = \"Q\"\ncircle = \"Q\"\n", NULL, "o") == 0);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && key_of(&m, PIM_CIRCLE, 0x0C));
+}
+
+static void test_mouse_settings(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[mouse]\ncamera = false\nsensitivity = 1.75\ninvert_x = yes\n"
+                         "invert_y = true\ndeadzone = 500\ncapture = off\n", stderr, "mouse") == 0);
+    assert(m.mouse_camera == 0 && m.mouse_invert_x == 1 && m.mouse_invert_y == 1);
+    assert(m.mouse_sens > 1.74f && m.mouse_sens < 1.76f);
+    assert(m.mouse_deadzone == 120);                     /* clamped */
+    assert(m.mouse_capture == 0);
+    /* bad values leave the setting alone */
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[mouse]\nsensitivity = fast\ndeadzone = -4\ninvert_y = maybe\n", NULL, "m") == 2);
+    assert(m.mouse_sens == 0.0f && m.mouse_deadzone == 0 && m.mouse_invert_y == -1);
+}
+
+static void test_unknown_names(void)
+{
+    PadInputMap m, d;
+    pim_defaults(&m);
+    pim_defaults(&d);
+    FILE* err = tmpfile();
+    assert(err);
+    const int n = pim_parse(&m,
+        "stray = 1\n"
+        "[keyboard]\n"
+        "cross = \"Space, Hyper\"\n"      /* Hyper unknown: Space still bound */
+        "jump = \"J\"\n"                  /* not a PS3 control */
+        "[joystick]\n"                    /* unknown section: its lines are skipped */
+        "cross = \"q\"\n"
+        "[mouse_buttons]\n"
+        "r1 = \"Button9\"\n"
+        "[controller]\n"
+        "cross = \"south\"\n"
+        "[mouse]\n"
+        "speed = 3\n"
+        "[keyboard]\n"
+        "this line has no equals sign\n",
+        err, "bad.toml");
+    assert(n == 8);
+    assert(m.n_warnings == 8);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x31));
+    assert(m.mouse[PIM_R1] == 0);                        /* the line still rebinds, to nothing known */
+    assert(m.pad[PIM_CROSS] == 0);
+    assert(n_keys(&m, PIM_CIRCLE) == n_keys(&d, PIM_CIRCLE));
+    rewind(err);
+    char buf[2048]; size_t r = fread(buf, 1, sizeof buf - 1, err); buf[r] = 0;
+    fclose(err);
+    assert(strstr(buf, "bad.toml:1: unknown setting outside a section 'stray'"));
+    assert(strstr(buf, "bad.toml:3: unknown key 'hyper'"));
+    assert(strstr(buf, "bad.toml:4: unknown PS3 control 'jump'"));
+    assert(strstr(buf, "bad.toml:5: unknown section 'joystick'"));
+    assert(strstr(buf, "bad.toml:8: unknown mouse button 'button9'"));
+    assert(strstr(buf, "bad.toml:10: unknown controller input 'south'"));
+    assert(strstr(buf, "bad.toml:12: unknown mouse setting 'speed'"));
+    assert(strstr(buf, "bad.toml:14: unknown line"));
+}
+
+static void test_load_file(void)
+{
+    PadInputMap m;
+    assert(pim_load_file(&m, "/nonexistent/input.toml", NULL) == 0);
+    PadInputMap d;
+    pim_defaults(&d);
+    assert(!memcmp(&m, &d, sizeof m));                   /* missing file = defaults */
+
+    char path[] = "/tmp/pim_testXXXXXX";
+    int fd = mkstemp(path);
+    assert(fd >= 0);
+    FILE* f = fdopen(fd, "w");
+    /* a long file: the reader grows its buffer past the first 4 KB */
+    for (int i = 0; i < 300; i++) fprintf(f, "# padding line %03d ...........................\n", i);
+    fprintf(f, "[keyboard]\ncross = \"Z\"\n");
+    fclose(f);
+    assert(pim_load_file(&m, path, stderr) == 1);
+    remove(path);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x06));
+}
+
+static void test_keys_hit(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    uint32_t keys[4] = {0, 0, 0, 0};
+    keys[0x4C >> 5] |= 1u << (0x4C & 31);                /* keypad Enter */
+    assert(pim_keys_hit(&m, PIM_START, keys));
+    assert(!pim_keys_hit(&m, PIM_SELECT, keys));
+}
+
+int main(void)
+{
+    test_defaults();
+    test_empty_and_comments();
+    test_rebind();
+    test_steal_and_overlap();
+    test_mouse_settings();
+    test_unknown_names();
+    test_load_file();
+    test_keys_hit();
+    printf("test_pad_input_map: ok\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_keymap.c b/libs/input/tests/test_pad_keymap.c
new file mode 100644
index 0000000..114a032
--- /dev/null
+++ b/libs/input/tests/test_pad_keymap.c
@@ -0,0 +1,169 @@
+/* cellPad's keyboard/mouse pad with PS3_INPUT_MAP: with no file every key
+ * does exactly what the hard-coded table did; with one, the keys, mouse
+ * buttons, wheel and capture setting follow it.
+ *
+ *   cc -std=gnu17 -I include -isystem /opt/homebrew/include \
+ *      -isystem /opt/homebrew/include/SDL2 libs/input/tests/test_pad_keymap.c \
+ *      -Wl,-dead_strip -o /tmp/test_pad_keymap && /tmp/test_pad_keymap
+ * (SDL's headers only: -dead_strip drops the SDL backend, nothing links SDL.)
+ */
+#include "../cellPad.c"
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+static void press_only(const unsigned* vks, int n)
+{
+    for (int i = 0; i < 4; i++) g_pad_host_keys[i] = 0;
+    for (int i = 0; i < n; i++) g_pad_host_keys[vks[i] >> 5] |= 1u << (vks[i] & 31);
+}
+
+/* What the hard-coded pad_poll_keys produced (before PS3_INPUT_MAP). */
+static void old_layout(const unsigned* vks, int n, u16* btns, int* lx, int* ly, int* rx, int* ry)
+{
+    static const struct { unsigned vk; u16 btn; } map[] = {
+        {0x7E, CELL_PAD_CTRL_UP}, {0x7D, CELL_PAD_CTRL_DOWN},
+        {0x7B, CELL_PAD_CTRL_LEFT}, {0x7C, CELL_PAD_CTRL_RIGHT},
+        {0x31, CELL_PAD_CTRL_CROSS}, {0x0C, CELL_PAD_CTRL_CIRCLE},
+        {0x0E, CELL_PAD_CTRL_SQUARE}, {0x0F, CELL_PAD_CTRL_TRIANGLE},
+        {0x20, CELL_PAD_CTRL_L1}, {0x1F, CELL_PAD_CTRL_R1},
+        {0x10, CELL_PAD_CTRL_L2}, {0x23, CELL_PAD_CTRL_R2},
+        {0x05, CELL_PAD_CTRL_L3}, {0x04, CELL_PAD_CTRL_R3},
+        {0x24, CELL_PAD_CTRL_START}, {0x4C, CELL_PAD_CTRL_START},
+        {0x30, CELL_PAD_CTRL_SELECT},
+    };
+    int down[128] = {0};
+    for (int i = 0; i < n; i++) down[vks[i]] = 1;
+    *btns = 0;
+    for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (down[map[i].vk]) *btns |= map[i].btn;
+    *lx = 128 + (down[0x02] ? 127 : 0) - (down[0x00] ? 128 : 0);
+    *ly = 128 + (down[0x01] ? 127 : 0) - (down[0x0D] ? 128 : 0);
+    *rx = 128 + (down[0x25] ? 127 : 0) - (down[0x26] ? 128 : 0);
+    *ry = 128 + (down[0x28] ? 127 : 0) - (down[0x22] ? 128 : 0);
+}
+
+static void expect_like_old(const unsigned* vks, int n)
+{
+    u16 b; int lx, ly, rx, ry;
+    old_layout(vks, n, &b, &lx, &ly, &rx, &ry);
+    press_only(vks, n);
+    pad_poll_keys(0);
+    const PadHostState* hs = &s_host_state[0];
+    assert(hs->buttons == b);
+    assert(hs->analog_lx == lx && hs->analog_ly == ly && hs->analog_rx == rx && hs->analog_ry == ry);
+    assert(hs->trigger_l2 == ((b & CELL_PAD_CTRL_L2) ? 255 : 0));
+}
+
+static void test_default_layout(void)
+{
+    unsetenv("PS3_INPUT_MAP");
+    s_map_state = 0;
+    pad_map_load();
+    for (unsigned vk = 0; vk < 128; vk++) expect_like_old(&vk, 1);
+    const unsigned combos[][4] = {
+        {0x00, 0x02, 0, 0}, {0x0D, 0x01, 0, 0}, {0x0D, 0x02, 0x31, 0x22},
+        {0x26, 0x25, 0x28, 0x24}, {0x10, 0x23, 0x20, 0x1F},
+    };
+    expect_like_old(combos[0], 2);
+    expect_like_old(combos[1], 2);
+    for (int i = 2; i < 5; i++) expect_like_old(combos[i], 4);
+    press_only(NULL, 0);
+    /* mouse buttons: left R1, right R2, middle and the side buttons L1 */
+    g_pad_mouse_buttons = 1; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R1);
+    g_pad_mouse_buttons = 2; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R2);
+    g_pad_mouse_buttons = 4; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);
+    g_pad_mouse_buttons = 8;  pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);   /* as before: */
+    g_pad_mouse_buttons = 64; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);   /* any other button */
+    g_pad_mouse_buttons = 0;
+    g_pad_mouse_wheel = 64; pad_poll_keys(0); assert(s_host_state[0].buttons == 0);   /* wheel unbound */
+    for (int i = 0; i < 8; i++) { usleep(100 * 1000); pad_poll_keys(0); }   /* let the queued notches pass */
+    assert(cellPad_host_mouse_capture_wanted() == 1);
+}
+
+static void test_mapped_layout(void)
+{
+    char path[] = "/tmp/pad_keymap_XXXXXX";
+    int fd = mkstemp(path);
+    FILE* f = fdopen(fd, "w");
+    fputs("[keyboard]\n"
+          "cross  = \"F, Shift\"\n"
+          "circle = \"\"\n"            /* Q no longer does anything */
+          "ls_up  = \"Up\"\n"          /* the arrow walks forward ... */
+          "up     = \"T\"\n"           /* ... and the D-pad up moved to T */
+          "rs_left = \"Q\"\n"
+          "[mouse_buttons]\n"
+          "r1 = \"Button4\"\n"
+          "up = \"WheelUp\"\n"
+          "[mouse]\n"
+          "capture = false\n", f);
+    fclose(f);
+    setenv("PS3_INPUT_MAP", path, 1);
+    s_map_state = 0;
+    pad_map_load();
+    remove(path);
+
+    unsigned k;
+    k = 0x03; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_CROSS);
+    k = 0x38; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_CROSS);
+    k = 0x31; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == 0);   /* Space unbound now */
+    k = 0x0C; press_only(&k, 1); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_rx == 0);                /* Q: camera left */
+    k = 0x7E; press_only(&k, 1); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_ly == 0);
+    k = 0x11; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    k = 0x0E; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_SQUARE);
+    press_only(NULL, 0);
+    g_pad_mouse_buttons = 1; pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    g_pad_mouse_buttons = 8; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R1);
+    g_pad_mouse_buttons = 2; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R2);
+    g_pad_mouse_buttons = 0;
+
+    /* two wheel notches up: two separate presses of UP */
+    g_pad_mouse_wheel = 32;
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    usleep(85 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    usleep(50 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    usleep(130 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    /* a turn down is not bound */
+    g_pad_mouse_wheel = -16;
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+
+    /* capture: the file says no, the variable wins */
+    unsetenv("PS3_MOUSE_CAPTURE");
+    unsetenv("PS3_MOUSE");
+    assert(cellPad_host_mouse_capture_wanted() == 0);
+    setenv("PS3_MOUSE_CAPTURE", "1", 1);
+    assert(cellPad_host_mouse_capture_wanted() == 1);
+    setenv("PS3_MOUSE", "0", 1);
+    assert(cellPad_host_mouse_capture_wanted() == 0);
+}
+
+static void test_sdl_triggers(void)
+{
+    const uint32_t lt = 1u << PIM_PAD_TRIGGER_LEFT, rt = 1u << PIM_PAD_TRIGGER_RIGHT;
+    assert(pad_sdl_analog(lt, 0, 77, 9) == 77);            /* default L2: the left trigger's own value */
+    assert(pad_sdl_analog(lt | rt, 0, 77, 99) == 99);      /* both triggers: the stronger */
+    assert(pad_sdl_analog(1u << 9, 0, 77, 99) == 0);       /* L1 bound, up */
+    assert(pad_sdl_analog(1u << 9, 1u << 9, 0, 0) == 255); /* L1 bound, down */
+}
+
+int main(void)
+{
+    test_default_layout();
+    test_mapped_layout();
+    test_sdl_triggers();
+    printf("test_pad_keymap: ok\n");
+    return 0;
+}
