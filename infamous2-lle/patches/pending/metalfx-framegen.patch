+    for (u32 i = 0; i < g.n_zdepths; i++) {
+        const eng_zdepth* z = &g.zdepths[i];
+        if (!z->handle || z->w != g.width || z->h != g.height) continue;
+        if (best == ENG_INVALID || z->stamp > g.zdepths[best].stamp) best = i;
+    }
+    if (best == ENG_INVALID) return 0;
+    if (s_fg.own_depth && g.be->texture_release) g.be->texture_release(g.be->user, s_fg.own_depth);
+    s_fg.own_depth = g.be->depth_snapshot(g.be->user, g.zdepths[best].handle, g.zdepths[best].w, g.zdepths[best].h);
+    return s_fg.own_depth;
