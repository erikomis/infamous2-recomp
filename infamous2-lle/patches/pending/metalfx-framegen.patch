new file mode 100644
index 0000000..4d55c73
--- /dev/null
+++ b/libs/video/rsx_metal_framegen.h
@@ -0,0 +1,656 @@
+/*
+ * PS3_FRAMEGEN=1 -- MetalFX frame interpolation for the draw engine's Metal
+ * backend (included by rsx_metal_backend.m; everything here is file-local).
+ *
+ * The title renders at its own rate (inFAMOUS 2: 30-37 fps on an M4 Pro) and
+ * every frame is presented twice as two different pictures: first a frame
+ * MTLFXFrameInterpolator (macOS 26+) makes between the previous one and this
+ * one, then, half a frame interval later, the frame itself. Opt-in, off by
+ * default, live (PS3_TOGGLE_FILE). When it cannot run (older macOS, a GPU
+ * without it, a title or port that supplies no camera) one line says why and
+ * the present is the old path, untouched.
+ *
+ * What the interpolator is given, all at the guest surface's size (so it runs
+ * before the present chain: FXAA, PS3_UPSCALE, sharpening and gamma apply to
+ * the interpolated picture and to the real one alike):
+ *
+ *   colour    the frame's 3D picture: a copy of the display surface taken
+ *             where the title's 2D overlay starts (framegen_scene, the draw
+ *             engine's PS3_FRAMEGEN_HUD_AFTER boundary), or the finished
+ *             surface when the frame has no overlay. Three copies are kept
+ *             (this frame, the previous one, the one before for the test).
+ *   depth     the engine's R32F copy of the depth buffer (0 near .. 1 far,
+ *             depthReversed = NO).
+ *   motion    RG16F, made here (fg_mv_fs): the frame's depth through the
+ *             engine's reprojection matrix gives where each pixel's world
+ *             point was on screen in the previous frame; the texture holds
+ *             previous - current in UV units and motionVectorScale is the
+ *             size in pixels, which is the convention the header documents
+ *             (an object that moved right by 10 px has -10) and that a
+ *             synthetic test confirmed: on a periodic pattern, where the
+ *             interpolator's own flow search is ambiguous, only that sign
+ *             lands the picture on the midpoint.
+ *   no scaler The guide pairs the interpolator with a temporal scaler; the
+ *             descriptor's `scaler` is nullable and with nil, colour at the
+ *             output size, the interpolator works on its own (same test).
+ *
+ * The HUD is put back over the interpolated picture by fg_hud_fs: wherever
+ * the finished frame differs from the 3D picture, the finished frame wins
+ * (exact compare: the 3D picture is a bit copy, so pixels the overlay did
+ * not touch are equal). HUD pixels are thus never warped and never smeared
+ * into the scene; under a translucent element the scene is the real frame's.
+ * PS3_FRAMEGEN_UI=metalfx hands the finished frame to the interpolator as a
+ * composited uiTexture instead and lets it do the same job its way.
+ *
+ * Pacing (windowed): the interpolated picture goes to the drawable in the
+ * frame's own command buffer, as the frame always did. The frame itself goes
+ * through the present chain a second time into a private texture of the
+ * drawable's size, and a pacer thread copies that to its own drawable half
+ * the last measured frame interval later (at most 50 ms; the title's frame
+ * time is irregular, 25-40 ms, so a fixed half-interval would be wrong every
+ * frame). A frame that arrives before the previous one's real picture went
+ * out makes it go out at once. Headless there is no pacing: the interpolation
+ * is encoded (so its GPU cost is in the frame) and the real frame is what the
+ * offscreen target and the frame dump hold, as before.
+ *
+ * PS3_FRAMEGEN_TEST=<dir> (headless, diagnostic): the objective test. Every
+ * other frame is withheld from a second interpolator, which is asked for the
+ * frame between N and N+2 with motion vectors across both steps; the result
+ * is dumped next to the real N+1 (and N, N+2, the motion, the depth, and the
+ * same interpolation with zero motion vectors) every
+ * PS3_FRAMEGEN_TEST_EVERY-th triple (default 20), at most
+ * PS3_FRAMEGEN_TEST_MAX (default 30), from PS3_FRAMEGEN_TEST_AT (a unix
+ * time) on. Raw files, read by the port's tools/framegen_test.py.
+ */
+
+#if GFX_HAVE_METALFX
+#  define FG_HAVE 1
+#else
+#  define FG_HAVE 0
+#endif
+
+@interface FgFrame : NSObject {
+@public
+    id<MTLTexture> scene, prev, prev2, depth;
+    float reproj[16], reproj2[16];
+    int   have_prev, have_prev2, has_hud;
+    float near_, far_, fovy, aspect, dt;
+    float m[16], eye_step[3], eye_step2[3];     /* PS3_FRAMEGEN_TEST's meta file */
+    u32   run;                  /* 1-based count of consecutive frames with a camera */
+}
+@end
+@implementation FgFrame
+@end
+
+static struct {
+    volatile int on;            /* PS3_FRAMEGEN (live); -1 unread */
+    int failed;                 /* gave up for good (one log line) */
+    int said;                   /* the "on" line was printed */
+    int ui_metalfx;             /* PS3_FRAMEGEN_UI=metalfx */
+    u32 scene_h[3];             /* the 3D picture ring (engine objects) */
+    u32 n;                      /* frames taken: scene_h[n % 3] is the one being recorded */
+    int scene_recorded;
+    u32 run;
+    u64 last_ns;                /* when the previous frame was handed over */
+    FgFrame* pending;           /* this present's frame (RSX thread) */
+    /* encode side */
+    id<MTLLibrary> lib;
+    id<MTLRenderPipelineState> mv_pso, hud_pso, copy_pso;
+    MTLPixelFormat hud_fmt, copy_fmt;
+    id<MTLTexture> mv, out, hud_out, real[3];
+    u32 real_n;
+    id fi[3];                   /* id<MTLFXFrameInterpolator>: live, test, test with zero motion */
+    int fi_ui[3];
+    u32 calls[3];               /* encodes since the last history reset */
+    u32 frames, interpolated;   /* for the periodic line */
+    u64 stat_ns;
+} s_fg = { .on = -1 };
+
+static void fg_set(int id, int v) { (void)id; __atomic_store_n(&s_fg.on, v != 0, __ATOMIC_RELAXED); }
+static int fg_on(void)
+{
+    if (__builtin_expect(__atomic_load_n(&s_fg.on, __ATOMIC_RELAXED) < 0, 0)) {
+        ps3_toggle_watch(PS3T_FRAMEGEN, fg_set);
+        const char* e = getenv("PS3_FRAMEGEN_UI");
+        s_fg.ui_metalfx = e && !strcmp(e, "metalfx");
+    }
+    return __atomic_load_n(&s_fg.on, __ATOMIC_RELAXED) && !s_fg.failed;
+}
+static void fg_fail(const char* why)
+{
+    if (!s_fg.failed)
+        fprintf(stderr, "[RSX metal] PS3_FRAMEGEN: frame interpolation unavailable (%s); presenting as usual\n", why);
+    s_fg.failed = 1;
+}
+/* PS3_FRAMEGEN_HEADLESS_PACE=1 (diagnostic): a headless run takes the
+ * windowed path -- interpolated picture first, the frame itself from the
+ * pacer half an interval later -- with the offscreen target as its drawable,
+ * so everything but the layer's own calls can be exercised without a window. */
+static int fg_headless_pace(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("PS3_FRAMEGEN_HEADLESS_PACE"); v = e && *e == '1'; }
+    return v;
+}
+static const char* fg_test_dir(void)
+{
+    static const char* d = (const char*)-1;
+    if (d == (const char*)-1) { d = getenv("PS3_FRAMEGEN_TEST"); if (d && !*d) d = NULL; }
+    return d;
+}
+
+/* ---- the engine's two hooks (RSX thread, record time) -------------------- */
+
+static void eng_framegen_scene(void* user, u32 surface)
+{
+    (void)user;
+    if (!fg_on()) return;
+    id<MTLTexture> src = eng_obj(surface);
+    if (!src) return;
+    id<MTLTexture> have = eng_obj(s_fg.scene_h[0]);
+    if (!have || [have width] != [src width] || [have height] != [src height] ||
+        [have pixelFormat] != [src pixelFormat]) {
+        for (int k = 0; k < 3; k++) {
+            if (s_fg.scene_h[k]) eng_obj_release(NULL, s_fg.scene_h[k]);
+            MTLTextureDescriptor* td =
+                [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:[src pixelFormat]
+                                                                   width:[src width] height:[src height]
+                                                               mipmapped:NO];
+            td.usage       = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+            td.storageMode = MTLStorageModePrivate;
+            s_fg.scene_h[k] = eng_obj_add_scaled([s_dev newTextureWithDescriptor:td], eng_obj_is_scaled(surface));
+        }
+        s_fg.run = 0;
+        if (!s_fg.scene_h[0] || !s_fg.scene_h[1] || !s_fg.scene_h[2]) { fg_fail("no memory for the colour copies"); return; }
+    }
+    if (s_eng_rec_count >= ENG_MAX_RECORDS) { s_eng_dropped++; return; }
+    EngRecord* r = &s_eng_rec[s_eng_rec_count++];
+    memset(r, 0, sizeof *r);
+    r->kind = ENG_REC_COLOR_COPY;
+    r->rt[0] = surface;
+    r->resolve_dst = s_fg.scene_h[s_fg.n % 3u];
+    s_fg.scene_recorded = 1;
+}
+
+static void eng_framegen_frame(void* user, const struct rsx_framegen_frame* f)
+{
+    (void)user;
+    s_fg.pending = nil;
+    const int ok = fg_on() && f && f->depth && s_fg.scene_recorded && eng_obj(f->depth);
+    s_fg.scene_recorded = 0;
+    if (!ok) { s_fg.run = 0; return; }
+    FgFrame* j = [FgFrame new];
+    j->scene = eng_obj(s_fg.scene_h[s_fg.n % 3u]);
+    j->prev  = eng_obj(s_fg.scene_h[(s_fg.n + 2u) % 3u]);
+    j->prev2 = eng_obj(s_fg.scene_h[(s_fg.n + 1u) % 3u]);
+    j->depth = eng_obj(f->depth);
+    memcpy(j->reproj, f->reproj, sizeof j->reproj);
+    memcpy(j->reproj2, f->reproj2, sizeof j->reproj2);
+    j->have_prev  = f->have_prev && s_fg.run >= 1;
+    j->have_prev2 = f->have_prev2 && s_fg.run >= 2;
+    if (!j->have_prev) s_fg.run = 0;            /* a camera cut starts a new run */
+    j->has_hud = (int)f->has_hud;
+    memcpy(j->m, f->m, sizeof j->m);
+    memcpy(j->eye_step, f->eye_step, sizeof j->eye_step);
+    memcpy(j->eye_step2, f->eye_step2, sizeof j->eye_step2);
+    j->near_ = f->near_; j->far_ = f->far_; j->fovy = f->fovy_deg; j->aspect = f->aspect;
+    const u64 now = eng_pt_now();
+    j->dt = s_fg.last_ns ? (float)((double)(now - s_fg.last_ns) * 1e-9) : 1.0f / 30.0f;
+    if (!(j->dt > 0.001f)) j->dt = 0.001f;
+    if (j->dt > 0.25f) j->dt = 0.25f;
+    s_fg.last_ns = now;
+    j->run = ++s_fg.run;
+    s_fg.n++;
+    if (!j->scene || !j->prev || !j->prev2 || !j->depth) return;
+    s_fg.pending = j;
+}
+
+/* ---- encode side ---------------------------------------------------------- */
+
+#if FG_HAVE
+static NSString* const kFgMSL = @
+"#include <metal_stdlib>\n"
+"using namespace metal;\n"
+"struct FgOut { float4 pos [[position]]; float2 uv; };\n"
+"vertex FgOut fg_vs(uint vid [[vertex_id]]) {\n"
+"    float2 p = float2((vid << 1) & 2, vid & 2);\n"
+"    FgOut o; o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+"    o.uv = float2(p.x, 1.0 - p.y);\n"
+"    return o;\n"
+"}\n"
+/* Camera motion vectors: (u, v, z, 1) . R is the same world point in the
+ * previous frame, homogeneous; previous - current, in UV units. A point that
+ * was behind the previous camera has no previous position: zero. */
+"struct FgMv { float4 r[4]; float4 misc; };\n"
+"fragment float4 fg_mv_fs(FgOut i [[stage_in]],\n"
+"                         texture2d<float> zt [[texture(0)]],\n"
+"                         constant FgMv& p [[buffer(0)]]) {\n"
+"    float2 size = float2(zt.get_width(), zt.get_height());\n"
+"    float z = zt.read(uint2(i.pos.xy)).x;\n"
+"    float2 uv = i.pos.xy / size;\n"
+"    float4 h = uv.x * p.r[0] + uv.y * p.r[1] + z * p.r[2] + p.r[3];\n"
+"    float2 mv = float2(0.0);\n"
+"    if (h.w * p.misc.x > 0.0) mv = clamp(h.xy / h.w - uv, float2(-2.0), float2(2.0));\n"
+"    return float4(mv, 0.0, 1.0);\n"
+"}\n"
+/* The title's HUD back over the interpolated picture: wherever the finished
+ * frame is not the 3D picture, the finished frame. */
+"fragment float4 fg_hud_fs(FgOut i [[stage_in]],\n"
+"                          texture2d<float> interp [[texture(0)]],\n"
+"                          texture2d<float> scene [[texture(1)]],\n"
+"                          texture2d<float> fin [[texture(2)]]) {\n"
+"    uint2 px = uint2(i.pos.xy);\n"
+"    float4 a = scene.read(px), b = fin.read(px);\n"
+"    float3 d = abs(a.rgb - b.rgb);\n"
+"    return max(d.r, max(d.g, d.b)) > 0.0 ? b : interp.read(px);\n"
+"}\n"
+"fragment float4 fg_copy_fs(FgOut i [[stage_in]],\n"
+"                           texture2d<float> src [[texture(0)]],\n"
+"                           sampler s [[sampler(0)]]) {\n"
+"    return src.sample(s, i.uv);\n"
+"}\n";
+
+static id<MTLRenderPipelineState> fg_pso(NSString* fs, MTLPixelFormat fmt)
+{
+    if (!s_fg.lib) {
+        NSError* err = nil;
+        s_fg.lib = [s_dev newLibraryWithSource:kFgMSL options:nil error:&err];
+        if (!s_fg.lib) { fprintf(stderr, "[RSX metal] PS3_FRAMEGEN shaders: %s\n", [[err localizedDescription] UTF8String]); return nil; }
+    }
+    MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction   = [s_fg.lib newFunctionWithName:@"fg_vs"];
+    pd.fragmentFunction = [s_fg.lib newFunctionWithName:fs];
+    pd.colorAttachments[0].pixelFormat = fmt;
+    NSError* err = nil;
+    id<MTLRenderPipelineState> p = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+    if (!p) fprintf(stderr, "[RSX metal] PS3_FRAMEGEN pipeline %s: %s\n", [fs UTF8String], [[err localizedDescription] UTF8String]);
+    return p;
+}
+
+static id<MTLTexture> fg_tex(id<MTLTexture> have, MTLPixelFormat fmt, NSUInteger w, NSUInteger h, MTLTextureUsage usage)
+{
+    if (have && [have width] == w && [have height] == h && [have pixelFormat] == fmt &&
+        ([have usage] & usage) == usage) return have;
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt width:w height:h mipmapped:NO];
+    td.usage       = usage;
+    td.storageMode = MTLStorageModePrivate;
+    return [s_dev newTextureWithDescriptor:td];
+}
+
+static id<MTLRenderCommandEncoder> fg_pass(id<MTLCommandBuffer> cb, id<MTLTexture> dst)
+{
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture     = dst;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    return [cb renderCommandEncoderWithDescriptor:rp];
+}
+
+/* The motion vectors of `depth` through `reproj` (NULL: none, all zero) into `mv`. */
+static int fg_encode_mv(id<MTLCommandBuffer> cb, id<MTLTexture> depth, const float* reproj, id<MTLTexture> mv)
+{
+    if (!s_fg.mv_pso && !(s_fg.mv_pso = fg_pso(@"fg_mv_fs", MTLPixelFormatRG16Float))) return 0;
+    struct { float r[16]; float misc[4]; } p;
+    memset(&p, 0, sizeof p);
+    if (reproj) { memcpy(p.r, reproj, sizeof p.r); p.misc[0] = 1.0f; }
+    id<MTLRenderCommandEncoder> e = fg_pass(cb, mv);
+    if (!e) return 0;
+    [e setRenderPipelineState:s_fg.mv_pso];
+    [e setFragmentTexture:depth atIndex:0];
+    [e setFragmentBytes:&p length:sizeof p atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    return 1;
+}
+
+/* Interpolator `slot` for these sizes and formats, or nil (and frame
+ * generation is off for good). */
+static id fg_interpolator(int slot, id<MTLTexture> color, id<MTLTexture> depth, int ui) API_AVAILABLE(macos(26.0))
+{
+    id<MTLFXFrameInterpolator> fi = (id<MTLFXFrameInterpolator>)s_fg.fi[slot];
+    if (fi && [fi outputWidth] == [color width] && [fi outputHeight] == [color height] &&
+        [fi inputWidth] == [depth width] && [fi inputHeight] == [depth height] &&
+        [fi colorTextureFormat] == [color pixelFormat] && [fi depthTextureFormat] == [depth pixelFormat] &&
+        s_fg.fi_ui[slot] == ui)
+        return fi;
+    s_fg.fi[slot] = nil; s_fg.calls[slot] = 0;
+    if (![MTLFXFrameInterpolatorDescriptor supportsDevice:s_dev]) { fg_fail("not supported on this GPU"); return nil; }
+    MTLFXFrameInterpolatorDescriptor* d = [MTLFXFrameInterpolatorDescriptor new];
+    d.inputWidth   = [depth width];  d.inputHeight  = [depth height];
+    d.outputWidth  = [color width];  d.outputHeight = [color height];
+    d.colorTextureFormat  = [color pixelFormat];
+    d.outputTextureFormat = [color pixelFormat];
+    d.depthTextureFormat  = [depth pixelFormat];
+    d.motionTextureFormat = MTLPixelFormatRG16Float;
+    if (ui) d.uiTextureFormat = [color pixelFormat];
+    d.scaler = nil;                 /* no temporal scaler: colour is at the output size */
+    fi = [d newFrameInterpolatorWithDevice:s_dev];
+    if (!fi) { fg_fail("could not create the interpolator"); return nil; }
+    if (([color usage] & [fi colorTextureUsage]) != [fi colorTextureUsage] ||
+        ([depth usage] & [fi depthTextureUsage]) != [fi depthTextureUsage]) {
+        fg_fail("the colour or depth copy's usage does not allow it"); return nil; }
+    s_fg.fi[slot] = fi; s_fg.fi_ui[slot] = ui;
+    if (!s_fg.said++)
+        fprintf(stderr, "[RSX metal] PS3_FRAMEGEN: MetalFX frame interpolation %lux%lu (depth and motion %lux%lu)\n",
+                (unsigned long)[color width], (unsigned long)[color height],
+                (unsigned long)[depth width], (unsigned long)[depth height]);
+    return fi;
+}
+
+/* One interpolation into `out`: the frame between `prev` and `cur`. */
+static int fg_encode_interp(id<MTLCommandBuffer> cb, int slot, const FgFrame* j, id<MTLTexture> prev,
+                            id<MTLTexture> cur, id<MTLTexture> mv, id<MTLTexture> ui, int reset,
+                            float dt, id<MTLTexture> out) API_AVAILABLE(macos(26.0))
+{
+    id<MTLFXFrameInterpolator> fi = (id<MTLFXFrameInterpolator>)fg_interpolator(slot, cur, j->depth, ui != nil);
+    if (!fi) return 0;
+    fi.colorTexture     = cur;
+    fi.prevColorTexture = prev;
+    fi.depthTexture     = j->depth;
+    fi.motionTexture    = mv;
+    fi.outputTexture    = out;
+    fi.uiTexture        = ui;
+    fi.uiTextureComposited = ui != nil;
+    fi.motionVectorScaleX = (float)[mv width];      /* the texture holds UV differences */
+    fi.motionVectorScaleY = (float)[mv height];
+    fi.jitterOffsetX = 0.0f; fi.jitterOffsetY = 0.0f;
+    fi.depthReversed = NO;                          /* 1 is far */
+    fi.nearPlane = j->near_; fi.farPlane = j->far_;
+    fi.fieldOfView = j->fovy; fi.aspectRatio = j->aspect;
+    fi.deltaTime = dt;
+    fi.shouldResetHistory = reset ? YES : NO;
+    [fi encodeToCommandBuffer:cb];
+    if (reset) s_fg.calls[slot] = 0;
+    s_fg.calls[slot]++;
+    return 1;
+}
+#endif /* FG_HAVE */
+
+/* The live path: encode this frame's interpolation after its records.
+ * Returns the picture to show before the frame (the guest surface's size and
+ * format, HUD included), or nil when there is none this time. */
+static id<MTLTexture> fg_encode(id<MTLCommandBuffer> cb, FgFrame* j, id<MTLTexture> fin)
+{
+#if FG_HAVE
+    if (!j || s_fg.failed) return nil;
+    if (@available(macOS 26.0, *)) {
+        const NSUInteger w = [j->scene width], h = [j->scene height];
+        const MTLPixelFormat fmt = [j->scene pixelFormat];
+        if ([fin width] != w || [fin height] != h || [fin pixelFormat] != fmt) return nil;
+        s_fg.mv = fg_tex(s_fg.mv, MTLPixelFormatRG16Float, [j->depth width], [j->depth height],
+                         MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+        s_fg.out = fg_tex(s_fg.out, fmt, w, h, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+        if (!s_fg.mv || !s_fg.out) { fg_fail("no memory for its targets"); return nil; }
+        s_fg.frames++;
+        if (!j->have_prev) return nil;          /* nothing to interpolate from */
+        if (!fg_encode_mv(cb, j->depth, j->reproj, s_fg.mv)) { fg_fail("the motion pass failed"); return nil; }
+        const int ui = s_fg.ui_metalfx && j->has_hud;
+        if (!fg_encode_interp(cb, 0, j, j->prev, j->scene, s_fg.mv, ui ? fin : nil, j->run <= 2,
+                              j->dt, s_fg.out))
+            return nil;
+        s_fg.interpolated++;
+        if (!j->has_hud || ui) return s_fg.out;
+        if (!s_fg.hud_pso || s_fg.hud_fmt != fmt) {
+            s_fg.hud_pso = fg_pso(@"fg_hud_fs", fmt); s_fg.hud_fmt = fmt;
+            if (!s_fg.hud_pso) { fg_fail("the HUD pass failed"); return nil; }
+        }
+        s_fg.hud_out = fg_tex(s_fg.hud_out, fmt, w, h, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+        id<MTLRenderCommandEncoder> e = s_fg.hud_out ? fg_pass(cb, s_fg.hud_out) : nil;
+        if (!e) return s_fg.out;
+        [e setRenderPipelineState:s_fg.hud_pso];
+        [e setFragmentTexture:s_fg.out atIndex:0];
+        [e setFragmentTexture:j->scene atIndex:1];
+        [e setFragmentTexture:fin atIndex:2];
+        [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+        [e endEncoding];
+        return s_fg.hud_out;
+    }
+    fg_fail("needs macOS 26");
+    return nil;
+#else
+    (void)cb; (void)j; (void)fin;
+    fg_fail("built without MetalFX");
+    return nil;
+#endif
+}
+
+/* ---- the pacer: the real frame, half an interval after the interpolated one */
+
+static struct {
+    pthread_mutex_t mu;
+    pthread_cond_t  cv, done;
+    int started, pending, flush;
+    id<MTLTexture> tex;
+    u64 at_ns;
+    u32 shown, flushed;
+} s_fgp = { .mu = PTHREAD_MUTEX_INITIALIZER, .cv = PTHREAD_COND_INITIALIZER, .done = PTHREAD_COND_INITIALIZER };
+
+#if FG_HAVE && !TARGET_OS_IPHONE
+static void* fg_pacer_main(void* arg)
+{
+    (void)arg;
+    pthread_setname_np("ps3recomp.framegen.pacer");
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    pthread_mutex_lock(&s_fgp.mu);
+    for (;;) {
+        while (!s_fgp.pending) pthread_cond_wait(&s_fgp.cv, &s_fgp.mu);
+        while (!s_fgp.flush) {
+            const u64 now = eng_pt_now();
+            if (now >= s_fgp.at_ns) break;
+            const u64 left = s_fgp.at_ns - now;
+            struct timespec ts = { (time_t)(left / 1000000000ull), (long)(left % 1000000000ull) };
+            pthread_cond_timedwait_relative_np(&s_fgp.cv, &s_fgp.mu, &ts);
+        }
+        id<MTLTexture> tex = s_fgp.tex;
+        if (s_fgp.flush) s_fgp.flushed++;
+        pthread_mutex_unlock(&s_fgp.mu);
+        @autoreleasepool {
+            CAMetalLayer* layer = s_headless ? nil : s_layer;
+            id<CAMetalDrawable> drawable = (layer && tex && s_fg.copy_pso) ? [layer nextDrawable] : nil;
+            /* PS3_FRAMEGEN_HEADLESS_PACE: the offscreen target stands in for the drawable. */
+            id<MTLTexture> dst = s_headless ? s_offscreen : [drawable texture];
+            if (tex && s_fg.copy_pso && dst && [dst pixelFormat] == s_fg.copy_fmt) {
+                id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+                id<MTLRenderCommandEncoder> e = fg_pass(cb, dst);
+                if (e) {
+                    [e setRenderPipelineState:s_fg.copy_pso];
+                    [e setFragmentTexture:tex atIndex:0];
+                    [e setFragmentSamplerState:s_eng_linear_sampler atIndex:0];
+                    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+                    [e endEncoding];
+                }
+                if (drawable) { fps_track_drawable(drawable); [cb presentDrawable:drawable]; }
+                [cb commit];
+            }
+        }
+        pthread_mutex_lock(&s_fgp.mu);
+        s_fgp.shown++;
+        s_fgp.pending = 0; s_fgp.flush = 0; s_fgp.tex = nil;
+        pthread_cond_broadcast(&s_fgp.done);
+    }
+    return NULL;
+}
+#endif
+
+/* A real frame still waiting for its time goes out now (the next frame is
+ * here, or frame generation stopped). Called before a present takes a
+ * drawable, so the two threads never hold the layer at once. */
+static void fg_pacer_flush(void)
+{
+    if (!s_fgp.started) return;
+    pthread_mutex_lock(&s_fgp.mu);
+    if (s_fgp.pending) {
+        s_fgp.flush = 1;
+        pthread_cond_signal(&s_fgp.cv);
+        while (s_fgp.pending) pthread_cond_wait(&s_fgp.done, &s_fgp.mu);
+    }
+    pthread_mutex_unlock(&s_fgp.mu);
+}
+
+/* The private target the real frame's present chain renders into (the
+ * drawable's size and format). nil: no pacing possible, present as usual. */
+static id<MTLTexture> fg_real_target(id<MTLTexture> drawable_tex)
+{
+#if FG_HAVE && !TARGET_OS_IPHONE
+    const MTLPixelFormat fmt = [drawable_tex pixelFormat];
+    if (!s_fg.copy_pso || s_fg.copy_fmt != fmt) {
+        fg_pacer_flush();
+        s_fg.copy_pso = fg_pso(@"fg_copy_fs", fmt); s_fg.copy_fmt = fmt;
+        if (!s_fg.copy_pso) { fg_fail("the copy pass failed"); return nil; }
+    }
+    const u32 k = s_fg.real_n++ % 3u;
+    s_fg.real[k] = fg_tex(s_fg.real[k], fmt, [drawable_tex width], [drawable_tex height],
+                          MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+    return s_fg.real[k];
+#else
+    (void)drawable_tex;
+    return nil;
+#endif
+}
+
+/* After the frame's command buffer is committed: show `tex` in `after_s`. */
+static void fg_pacer_schedule(id<MTLTexture> tex, float after_s)
+{
+#if FG_HAVE && !TARGET_OS_IPHONE
+    if (!s_fgp.started) {
+        pthread_t th;
+        pthread_attr_t at;
+        pthread_attr_init(&at);
+        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+        if (pthread_create(&th, &at, fg_pacer_main, NULL) != 0) { fg_fail("no pacer thread"); return; }
+        s_fgp.started = 1;
+    }
+    pthread_mutex_lock(&s_fgp.mu);
+    s_fgp.tex = tex;
+    s_fgp.at_ns = eng_pt_now() + (u64)((double)after_s * 1e9);
+    s_fgp.pending = 1; s_fgp.flush = 0;
+    pthread_cond_signal(&s_fgp.cv);
+    pthread_mutex_unlock(&s_fgp.mu);
+#else
+    (void)tex; (void)after_s;
+#endif
+}
+
+/* PS3RECOMP_ENG_FPSLOG: what frame generation did, per 10 s. */
+static void fg_report(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3RECOMP_ENG_FPSLOG") ? 1 : 0;
+    if (!on || !s_fg.frames) return;
+    const u64 now = eng_pt_now();
+    if (!s_fg.stat_ns) s_fg.stat_ns = now;
+    if (now - s_fg.stat_ns < 10000000000ull) return;
+    pthread_mutex_lock(&s_fgp.mu);
+    const u32 shown = s_fgp.shown, flushed = s_fgp.flushed;
+    s_fgp.shown = s_fgp.flushed = 0;
+    pthread_mutex_unlock(&s_fgp.mu);
+    fprintf(stderr, "[rsx framegen] %u frames with a camera, %u interpolated; %u real frames paced"
+            " (%u early: the next frame came first)\n", s_fg.frames, s_fg.interpolated, shown, flushed);
+    s_fg.frames = s_fg.interpolated = 0; s_fg.stat_ns = now;
+}
+
+/* ---- PS3_FRAMEGEN_TEST ---------------------------------------------------- */
+
+static void eng_readback_body(id<MTLTexture> t, u32 x, u32 y, u32 w, u32 h, void* out, u32 out_pitch);
+
+static void fg_test_dump(const char* dir, u32 k, const char* name, id<MTLTexture> t, u32 bpp)
+{
+    const u32 w = (u32)[t width], h = (u32)[t height];
+    void* px = malloc((size_t)w * h * bpp);
+    if (!px) return;
+    eng_readback_body(t, 0, 0, w, h, px, w * bpp);
+    char path[1024];
+    snprintf(path, sizeof path, "%s/t%03u_%s_%ux%u.raw", dir, k, name, w, h);
+    FILE* f = fopen(path, "wb");
+    if (f) { fwrite(px, 1, (size_t)w * h * bpp, f); fclose(f); }
+    free(px);
+}
+
+/* After the present was committed (RSX thread, headless). Frames 1, 3, 5...
+ * of a run are the stream the test interpolator sees; the even ones are the
+ * truth it is compared with. */
+static void fg_test_step(FgFrame* j, id<MTLTexture> fin)
+{
+#if FG_HAVE
+    const char* dir = fg_test_dir();
+    if (!dir || !j || s_fg.failed) return;
+    if (@available(macOS 26.0, *)) {
+        static id<MTLTexture> mv2, mv0, out, out0;
+        static u32 triples, dumps, every, max_dumps, stream;
+        static long at;
+        static double gpu_ms; static u32 gpu_n;
+        if (!every) {
+            const char* e = getenv("PS3_FRAMEGEN_TEST_EVERY"); every = e && atoi(e) > 0 ? (u32)atoi(e) : 20u;
+            e = getenv("PS3_FRAMEGEN_TEST_MAX"); max_dumps = e && atoi(e) > 0 ? (u32)atoi(e) : 30u;
+            e = getenv("PS3_FRAMEGEN_TEST_AT"); at = e ? atol(e) : 0;
+        }
+        if (j->run < 3 || !(j->run & 1u)) { if (j->run < 3) stream = 0; return; }
+        if (!j->have_prev2) { stream = 0; return; }
+        const NSUInteger w = [j->scene width], h = [j->scene height];
+        const MTLPixelFormat fmt = [j->scene pixelFormat];
+        const MTLTextureUsage use = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+        mv2  = fg_tex(mv2, MTLPixelFormatRG16Float, [j->depth width], [j->depth height], use);
+        mv0  = fg_tex(mv0, MTLPixelFormatRG16Float, [j->depth width], [j->depth height], use);
+        out  = fg_tex(out, fmt, w, h, use);
+        out0 = fg_tex(out0, fmt, w, h, use);
+        if (!mv2 || !mv0 || !out || !out0) return;
+        eng_enc_join();
+        const int reset = (stream == 0);
+        id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+        if (!fg_encode_mv(cb, j->depth, j->reproj2, mv2) ||
+            !fg_encode_interp(cb, 1, j, j->prev2, j->scene, mv2, nil, reset, j->dt * 2.0f, out)) return;
+        [cb commit];
+        [cb waitUntilCompleted];
+        const double g1 = ([cb GPUEndTime] - [cb GPUStartTime]) * 1e3;
+        id<MTLCommandBuffer> cb0 = [s_queue commandBuffer];
+        if (!fg_encode_mv(cb0, j->depth, NULL, mv0) ||
+            !fg_encode_interp(cb0, 2, j, j->prev2, j->scene, mv0, nil, reset, j->dt * 2.0f, out0)) return;
+        [cb0 commit];
+        [cb0 waitUntilCompleted];
+        stream++;
+        if (stream > 3) { gpu_ms += g1; gpu_n++; }
+        triples++;
+        if (gpu_n && triples % 100u == 0)
+            fprintf(stderr, "[framegen test] %u triples; motion pass + interpolation %.2f ms GPU on average\n",
+                    triples, gpu_ms / gpu_n);
+        /* The interpolator's first two frames after a reset come out as the
+         * current frame: only a settled stream is worth dumping. */
+        if (stream <= 3 || dumps >= max_dumps || (triples % every) != 0) return;
+        if (at && time(NULL) < at) return;
+        const u32 k = dumps++;
+        fg_test_dump(dir, k, "c0", j->prev2, 4);
+        fg_test_dump(dir, k, "c1", j->prev, 4);
+        fg_test_dump(dir, k, "c2", j->scene, 4);
+        fg_test_dump(dir, k, "interp", out, 4);
+        fg_test_dump(dir, k, "interp0", out0, 4);
+        fg_test_dump(dir, k, "mv", mv2, 4);
+        fg_test_dump(dir, k, "depth", j->depth, 4);
+        /* The live path's own work for this frame: the picture shown before
+         * it (between N+1 and N+2, HUD put back) and the finished frame. */
+        if (j->have_prev && s_fg.out && fin) {
+            fg_test_dump(dir, k, "live", (j->has_hud && !s_fg.ui_metalfx && s_fg.hud_out) ? s_fg.hud_out : s_fg.out, 4);
+            fg_test_dump(dir, k, "final", fin, 4);
+        }
+        char path[1024];
+        snprintf(path, sizeof path, "%s/t%03u_meta.txt", dir, k);
+        FILE* f = fopen(path, "w");
+        if (f) {
+            fprintf(f, "time %ld\nrun %u\ngpu_ms %.3f\nbgra %d\nnear %g\nfar %g\nfovy %g\ndt %g\nhas_hud %d\nreproj2",
+                    (long)time(NULL), j->run, g1,
+                    (fmt == MTLPixelFormatBGRA8Unorm || fmt == MTLPixelFormatBGRA8Unorm_sRGB) ? 1 : 0,
+                    j->near_, j->far_, j->fovy, j->dt, j->has_hud);
+            for (int i = 0; i < 16; i++) fprintf(f, " %.9g", j->reproj2[i]);
+            fprintf(f, "\nreproj");
+            for (int i = 0; i < 16; i++) fprintf(f, " %.9g", j->reproj[i]);
+            fprintf(f, "\nm");
+            for (int i = 0; i < 16; i++) fprintf(f, " %.9g", j->m[i]);
+            fprintf(f, "\neye_step %.6f %.6f %.6f\neye_step2 %.6f %.6f %.6f\n", j->eye_step[0], j->eye_step[1],
+                    j->eye_step[2], j->eye_step2[0], j->eye_step2[1], j->eye_step2[2]);
+            fclose(f);
+        }
+        fprintf(stderr, "[framegen test] dumped triple %u (run frame %u, %.2f ms GPU) to %s\n", k, j->run, g1, dir);
+    }
+#else
+    (void)j; (void)fin;
+#endif
+}
