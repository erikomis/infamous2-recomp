+static void eng_m4_mul(const double* a, const double* b, double* o)
+{
+    double t[16];
+    for (int r = 0; r < 4; r++) for (int c = 0; c < 4; c++) {
+        double v = 0; for (int k = 0; k < 4; k++) v += a[r * 4 + k] * b[k * 4 + c];
+        t[r * 4 + c] = v; }
+    memcpy(o, t, sizeof t);
+}
+static int eng_m4_inv(const double* m, double* o)
+{
+    double a[4][8];
+    for (int r = 0; r < 4; r++) for (int c = 0; c < 8; c++)
+        a[r][c] = c < 4 ? m[r * 4 + c] : (c - 4 == r ? 1.0 : 0.0);
+    for (int i = 0; i < 4; i++) {
+        int p = i;
+        for (int r = i + 1; r < 4; r++) if (fabs(a[r][i]) > fabs(a[p][i])) p = r;
+        if (fabs(a[p][i]) < 1e-300) return 0;
+        if (p != i) for (int c = 0; c < 8; c++) { const double t = a[i][c]; a[i][c] = a[p][c]; a[p][c] = t; }
+        const double d = 1.0 / a[i][i];
+        for (int c = 0; c < 8; c++) a[i][c] *= d;
+        for (int r = 0; r < 4; r++) if (r != i) {
+            const double f = a[r][i];
+            if (f != 0.0) for (int c = 0; c < 8; c++) a[r][c] -= f * a[i][c]; }
+    }
+    for (int r = 0; r < 4; r++) for (int c = 0; c < 4; c++) o[r * 4 + c] = a[r][c + 4];
+    return 1;
+}
+/* The camera-relative position of a pixel: (u, v, z, 1) . M, divided. */
+static void eng_fg_point(const double* m, double u, double v, double z, double* p)
+{
+    double h[4];
+    for (int c = 0; c < 4; c++) h[c] = u * m[c] + v * m[4 + c] + z * m[8 + c] + m[12 + c];
+    const double w = fabs(h[3]) > 1e-300 ? h[3] : 1e-300;
+    p[0] = h[0] / w; p[1] = h[1] / w; p[2] = h[2] / w;
+}
+/* cur -> old: M_cur . T(eye_cur - eye_old) . inverse(M_old). 0 when the two
+ * cameras are not one camera a frame apart (a cut, tested below). */
+static int eng_fg_reproj(const double* mc, const double* ec, const double* mo, const double* eo, float* out)
+{
+    double inv[16], t[16], r[16];
+    if (!eng_m4_inv(mo, inv)) return 0;
+    memset(t, 0, sizeof t); t[0] = t[5] = t[10] = t[15] = 1.0;
+    for (int k = 0; k < 3; k++) t[12 + k] = ec[k] - eo[k];
+    eng_m4_mul(mc, t, r);
+    eng_m4_mul(r, inv, r);
+    /* A cut: the centre ray turned by more than 60 degrees, or the eye
+     * moved further than the centre of the near plane is far times 1000
+     * (40 cm in inFAMOUS 2: 400 m in one frame). */
+    double a[3], b[3], la = 0, lb = 0, dot = 0, d2 = 0;
+    eng_fg_point(mc, 0.5, 0.5, 0.0, a); eng_fg_point(mo, 0.5, 0.5, 0.0, b);
+    for (int k = 0; k < 3; k++) { la += a[k] * a[k]; lb += b[k] * b[k]; dot += a[k] * b[k]; d2 += t[12 + k] * t[12 + k]; }
+    if (!(la > 0) || !(lb > 0)) return 0;
+    if (dot < 0.5 * sqrt(la * lb)) return 0;
+    if (d2 > la * 1.0e6) return 0;
+    for (int i = 0; i < 16; i++) { if (!isfinite(r[i])) return 0; out[i] = (float)r[i]; }
+    return 1;
+}
