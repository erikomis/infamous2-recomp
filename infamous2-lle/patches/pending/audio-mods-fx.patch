+                    if (spp >= 3) { o[0] = r[0]; o[1] = r[1]; o[2] = r[2]; o[3] = spp == 4 ? r[3] : 255; }
+                    else          { o[0] = o[1] = o[2] = r[0]; o[3] = spp == 2 ? r[1] : 255; }
+                }
+            }
