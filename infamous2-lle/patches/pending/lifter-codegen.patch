+    out = ["u128 " + ", ".join(f"R_{r} = ctx->gpr[{r}]" for r in regs) + ";"]
+    pending = False                 # locals behind ctx->gpr (after a runtime call)
+    for i, (k, a, b) in enumerate(items):
