         { "PS3RECOMP_ENG_CLAMP_CULL_FLIP", PS3_TK_ATOI, 0 },
         { "PS3RECOMP_ENG_SHADOW_D24",   PS3_TK_ATOI, 0 },
+        { "PS3RECOMP_ENG_SHADE_BACKFACE", PS3_TK_NOT0, 1 },
     };
     return &d[id];
 }
