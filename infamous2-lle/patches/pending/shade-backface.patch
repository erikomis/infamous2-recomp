+    if (sb == -1000) { const char* e = getenv("PS3RECOMP_ENG_BACKFACE_CASTER_BIAS"); sb = e ? atoi(e) : 0; }
+    if (sb && !(en && mode) && rs->depth_write && rs->depth_test && rs->color_mask == 0 &&
+        rs->cull_enable && rs->cull_face == 0x0404u) {
