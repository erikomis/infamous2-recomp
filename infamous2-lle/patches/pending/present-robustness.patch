+++ b/tools/test_metal_present_status.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""The present path's GPU-failure handling, eng_blit_to_display's result and
+the screenshot, on a real macOS Metal device."""
+import os
+import pathlib
+import platform
+import subprocess
+import tempfile
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+if platform.system() != "Darwin":
+    print("SKIP: Metal requires macOS")
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix="metal-present-") as tmp:
+    binary = pathlib.Path(tmp) / "test"
+    subprocess.run(["clang", "-fobjc-arc", "-Iinclude", "-Ilibs/video",
+                    "libs/video/tests/test_metal_present_status.m",
+                    "libs/video/rsx_texture_layout.c", "-Wl,-dead_strip",
+                    "-framework", "Metal", "-framework", "Cocoa",
+                    "-framework", "QuartzCore", "-weak_framework", "MetalFX", "-o", str(binary)],
+                   cwd=ROOT, check=True, timeout=120)
+    env = dict(os.environ, TMPDIR=tmp)
+    for mode in ("health", "handler", "blit", "shot"):
+        subprocess.run([str(binary), mode], check=True, timeout=60, env=env)
