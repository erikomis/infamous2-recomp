+    const char* d = shot_dir();
+    NSString* dir = d ? @(d) : nil;
+    dispatch_async(q, ^{ @autoreleasepool {
+        if (!ok || !dir) {
+            fprintf(stderr, "[capture] screenshot lost: %s\n", ok ? "no folder" : "the frame failed on the GPU");
+            shot_finish();
+            return;
+        }
