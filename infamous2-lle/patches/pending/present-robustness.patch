diff --git a/libs/video/tests/test_metal_present_status.m b/libs/video/tests/test_metal_present_status.m
new file mode 100644
index 0000000..4dc6921
--- /dev/null
+++ b/libs/video/tests/test_metal_present_status.m
@@ -0,0 +1,339 @@
+/* The present path's failure handling and its screenshot, on a real Metal
+ * device with no window (python3 tools/test_metal_present_status.py builds
+ * and runs it).
+ *
+ *   health    present_health_note: failures are said the first 8 times and
+ *             every 100th; three frames in a row that used the Lanczos
+ *             reduction and failed turn it off; a completed frame, or a
+ *             failed one that did not reduce, resets that run; the frame
+ *             generation pacer's copy neither adds to it nor resets it
+ *   handler   present_health as a completion handler sees it: command
+ *             buffers that report MTLCommandBufferStatusError (a stand-in
+ *             object; a real GPU fault cannot be made on demand) turn
+ *             PS3_DOWNSCALE off after three, with gfx_downscale_fail's line;
+ *             a real completed command buffer counts as a success
+ *   blit      eng_blit_to_display's result: ENG_BLIT_OK for a drawn
+ *             picture, | ENG_BLIT_REDUCED when the reduction made it, 0 with
+ *             the target untouched when it cannot draw (no target, no helper
+ *             library, a present pipeline that does not build)
+ *   shot      the screenshot: nothing taken unless asked; a drawable of a
+ *             framebufferOnly layer is waited out while the layer is turned
+ *             readable, then copied, written as screen_<time>.png (RGBA,
+ *             opaque, the drawable's pixels) and the layer put back; F12's
+ *             notice comes after the file; no folder, no shot */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+#include <dirent.h>
+
+/* What the file reaches outside it. The menu stays closed. */
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+volatile int g_ps3_overlay_active;
+void ps3_overlay_render(void* cb, void* dst) { (void)cb; (void)dst; assert(!"menu closed"); }
+volatile uint32_t g_pad_mouse_buttons;
+static volatile int s_notices;
+void ps3_overlay_capture_notice(void) { __atomic_add_fetch(&s_notices, 1, __ATOMIC_RELAXED); }
+
+/* A command buffer's status and error, as a completion handler reads them. */
+@interface FakeDone : NSObject
+@property (nonatomic) MTLCommandBufferStatus status;
+@property (nonatomic, strong) NSError* error;
+@end
+@implementation FakeDone
+@end
+static id<MTLCommandBuffer> fake(int failed)
+{
+    FakeDone* f = [FakeDone new];
+    f.status = failed ? MTLCommandBufferStatusError : MTLCommandBufferStatusCompleted;
+    if (failed) f.error = [NSError errorWithDomain:MTLCommandBufferErrorDomain code:MTLCommandBufferErrorPageFault
+                                          userInfo:@{ NSLocalizedDescriptionKey: @"forced page fault (test)" }];
+    return (id<MTLCommandBuffer>)(id)f;
+}
+
+static id<MTLTexture> tex(NSUInteger w, NSUInteger h, MTLPixelFormat pf, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:pf
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [s_dev newTextureWithDescriptor:td];
+    assert(t);
+    return t;
+}
+/* BGRA bytes (b, g, r, a) = (x, y, 100, 7): every pixel tells where it is. */
+static id<MTLTexture> picture(NSUInteger w, NSUInteger h)
+{
+    id<MTLTexture> t = tex(w, h, MTLPixelFormatBGRA8Unorm, MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget);
+    uint8_t* px = malloc(w * h * 4);
+    for (NSUInteger y = 0; y < h; y++)
+        for (NSUInteger x = 0; x < w; x++) {
+            uint8_t* p = px + (y * w + x) * 4;
+            p[0] = (uint8_t)x; p[1] = (uint8_t)y; p[2] = 100; p[3] = 7;
+        }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+static void fill(id<MTLTexture> t, uint8_t v)
+{
+    const NSUInteger w = [t width], h = [t height];
+    uint8_t* px = malloc(w * h * 4);
+    memset(px, v, w * h * 4);
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+}
+static int all(id<MTLTexture> t, uint8_t v)
+{
+    const NSUInteger w = [t width], h = [t height];
+    uint8_t* px = malloc(w * h * 4);
+    [t getBytes:px bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    int ok = 1;
+    for (NSUInteger i = 0; i < w * h * 4; i++) if (px[i] != v) { ok = 0; break; }
+    free(px);
+    return ok;
+}
+static int blit(id<MTLTexture> src, id<MTLTexture> dst)
+{
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    const int r = eng_blit_to_display(cb, src, dst);
+    [cb commit];
+    [cb waitUntilCompleted];
+    assert(cb.status == MTLCommandBufferStatusCompleted);
+    return r;
+}
+
+static void check_health(void)
+{
+    PresentHealth h = { 0 };
+    /* the first 8 failures are said, then every 100th */
+    int said = 0;
+    for (int i = 1; i <= 300; i++) {
+        const int act = present_health_note(&h, 1, PH_FRAME);
+        assert(!(act & PH_DROP_REDUCTION));
+        if (act & PH_LOG) { said++; assert(i <= 8 || i % 100 == 0); }
+    }
+    assert(said == 8 + 3 && h.failed == 300 && h.run == 300 && h.reduced_run == 0);
+    assert(present_health_note(&h, 0, PH_FRAME) == 0 && h.run == 0 && h.failed == 300);
+
+    /* three reduced failures in a row: off, once; the run starts over */
+    h = (PresentHealth){ 0 };
+    assert(!(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION));
+    assert(!(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION));
+    assert(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION);
+    assert(h.reduced_run == 0 && h.run == 3);
+    /* a success between them resets the run */
+    h = (PresentHealth){ 0 };
+    present_health_note(&h, 1, PH_REDUCED); present_health_note(&h, 1, PH_REDUCED);
+    assert(present_health_note(&h, 0, PH_REDUCED) == 0 && h.reduced_run == 0 && h.run == 0);
+    assert(!(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION));
+    assert(!(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION));
+    assert(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION);
+    /* so does a plain frame completing, and a plain frame failing (then the
+     * reduction is not what fails) */
+    h = (PresentHealth){ 0 };
+    present_health_note(&h, 1, PH_REDUCED); present_health_note(&h, 1, PH_REDUCED);
+    present_health_note(&h, 0, PH_FRAME);
+    assert(h.reduced_run == 0);
+    present_health_note(&h, 1, PH_REDUCED); present_health_note(&h, 1, PH_REDUCED);
+    assert(!(present_health_note(&h, 1, PH_FRAME) & PH_DROP_REDUCTION));
+    assert(h.reduced_run == 0 && h.run == 3);
+    /* the pacer's copy: counted and said, but neither part of the run nor a reset */
+    h = (PresentHealth){ 0 };
+    present_health_note(&h, 1, PH_REDUCED);
+    assert(present_health_note(&h, 1, PH_COPY) & PH_LOG);
+    present_health_note(&h, 0, PH_COPY);
+    present_health_note(&h, 1, PH_REDUCED);
+    assert(h.reduced_run == 2 && h.failed == 3);
+    assert(present_health_note(&h, 1, PH_REDUCED) & PH_DROP_REDUCTION);
+    puts("[present status] health passed");
+}
+
+static void check_handler(void)
+{
+    setenv("PS3_DOWNSCALE", "1", 1);
+    s_res_scale = 3.0f;
+    gfx_downscale_load();
+    assert(s_gfx_down_on);
+    s_present_health = (PresentHealth){ 0 };
+    present_health(fake(1), PH_REDUCED);
+    present_health(fake(1), PH_REDUCED);
+    present_health(fake(0), PH_REDUCED);            /* a frame that completed */
+    present_health(fake(1), PH_REDUCED);
+    present_health(fake(1), PH_REDUCED);
+    assert(s_gfx_down_on);                           /* two in a row so far */
+    present_health(fake(1), PH_COPY);                /* the pacer's copy does not count */
+    assert(s_gfx_down_on);
+    present_health(fake(1), PH_REDUCED);
+    assert(!s_gfx_down_on);                          /* the third: off */
+    assert(s_present_health.failed == 6);
+    /* a real command buffer that completed is a success */
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    [cb commit]; [cb waitUntilCompleted];
+    present_health(cb, PH_FRAME);
+    assert(s_present_health.run == 0 && s_present_health.failed == 6);
+    puts("[present status] handler passed");
+}
+
+static void check_blit(void)
+{
+    setenv("PS3_DOWNSCALE", "1", 1);
+    s_res_scale = 3.0f;
+    gfx_downscale_load();
+    id<MTLTexture> src = picture(192, 108);
+    id<MTLTexture> same = tex(192, 108, MTLPixelFormatBGRA8Unorm, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+    assert(blit(src, same) == ENG_BLIT_OK);
+    id<MTLTexture> small = tex(64, 36, MTLPixelFormatBGRA8Unorm, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+    const int r = blit(src, small);
+    if (s_gfx_down_on) assert(r == (ENG_BLIT_OK | ENG_BLIT_REDUCED));
+    else               assert(r == ENG_BLIT_OK);   /* no MetalPerformanceShaders here */
+    setenv("PS3_DOWNSCALE", "0", 1);
+    gfx_downscale_load();
+    assert(blit(src, small) == ENG_BLIT_OK);       /* sampled, not reduced */
+
+    /* nothing to draw into, or nothing to draw */
+    assert(blit(src, nil) == 0 && blit(nil, small) == 0);
+    /* no helper library: 0, the target untouched */
+    fill(small, 0x5A);
+    id<MTLLibrary> lib = s_eng_helper_lib;
+    s_eng_helper_lib = nil;
+    assert(blit(src, small) == 0 && all(small, 0x5A));
+    s_eng_helper_lib = lib;
+    /* a present pipeline that does not build (a target format the present
+     * pass cannot render to): 0, untouched, and the next good target works */
+    id<MTLTexture> odd = tex(64, 36, MTLPixelFormatRGBA32Sint, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+    { const NSUInteger n = 64 * 36 * 16; uint8_t* px = malloc(n); memset(px, 0x33, n);
+      [odd replaceRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0 withBytes:px bytesPerRow:64 * 16];
+      free(px); }
+    assert(blit(src, odd) == 0);
+    { const NSUInteger n = 64 * 36 * 16; uint8_t* px = malloc(n);
+      [odd getBytes:px bytesPerRow:64 * 16 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+      for (NSUInteger i = 0; i < n; i++) assert(px[i] == 0x33);
+      free(px); }
+    assert(blit(src, small) == ENG_BLIT_OK && !all(small, 0x5A));
+    puts("[present status] blit passed");
+}
+
+/* The PNGs in dir named screen_*.png: how many, and the last name. */
+static int shots_in(const char* dir, char* last, size_t n)
+{
+    DIR* d = opendir(dir);
+    if (!d) return 0;
+    int k = 0;
+    struct dirent* e;
+    while ((e = readdir(d))) {
+        if (strncmp(e->d_name, "screen_", 7) || !strstr(e->d_name, ".png")) continue;
+        k++;
+        if (last) snprintf(last, n, "%s/%s", dir, e->d_name);
+    }
+    closedir(d);
+    return k;
+}
+static void run_main(double s) { CFRunLoopRunInMode(kCFRunLoopDefaultMode, s, false); }
+/* The present's part: the shot encoded on the frame's command buffer and
+ * written from its completion. */
+static id<MTLBuffer> frame_with_shot(id<MTLTexture> shown)
+{
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    NSUInteger w = 0, h = 0; int bgra = 0;
+    id<MTLBuffer> shot = shot_encode(cb, shown, &w, &h, &bgra);
+    [cb commit]; [cb waitUntilCompleted];
+    if (shot) shot_write(shot, w, h, bgra, [cb status] != MTLCommandBufferStatusError);
+    return shot;
+}
+
+static void check_shot(void)
+{
+    char dir[512];
+    const char* tmp = getenv("TMPDIR");
+    snprintf(dir, sizeof dir, "%s/metal-shot-XXXXXX", tmp && *tmp ? tmp : "/tmp");
+    assert(mkdtemp(dir));
+    /* not asked: nothing, whatever the texture */
+    id<MTLTexture> pic = picture(40, 24);
+    assert(!frame_with_shot(pic));
+    /* no debug folder: not taken */
+    unsetenv("PS3RECOMP_METAL_SURF_DUMP");
+    assert(!shot_request(1) && !s_shot_want);
+    setenv("PS3RECOMP_METAL_SURF_DUMP", dir, 1);
+
+    /* a window's drawables, display-only as the layer always has them */
+    s_layer = [CAMetalLayer layer];
+    s_layer.device = s_dev;
+    s_layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+    s_layer.framebufferOnly = YES;
+    s_layer.drawableSize = CGSizeMake(40, 24);
+    assert(shot_request(1));
+    id<CAMetalDrawable> d = [s_layer nextDrawable];
+    if (!d) { puts("[present status] no drawable without a window here; layer part skipped"); }
+    else {
+        assert([d.texture isFramebufferOnly]);
+        assert(!frame_with_shot(d.texture));           /* not readable: waited out */
+        assert(s_shot_readable && s_shot_want && s_shot_wait == 1);
+        run_main(0.05);                                /* the main thread turns the layer readable */
+        assert(!s_layer.framebufferOnly);
+        d = nil;
+        d = [s_layer nextDrawable];
+        assert(d && ![d.texture isFramebufferOnly]);
+        /* the drawable as the present pass left it */
+        id<MTLBlitCommandEncoder> b; id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+        b = [cb blitCommandEncoder]; [b copyFromTexture:pic toTexture:d.texture]; [b endEncoding];
+        [cb commit]; [cb waitUntilCompleted];
+        assert(frame_with_shot(d.texture) && !s_shot_want);
+        d = nil;
+        for (int i = 0; i < 100 && (shots_in(dir, NULL, 0) < 1 || s_notices < 1); i++) run_main(0.05);
+        char path[512];
+        assert(shots_in(dir, path, sizeof path) == 1 && s_notices == 1);
+        run_main(0.05);                                /* and back to display-only */
+        assert(s_layer.framebufferOnly && !s_shot_readable);
+        NSBitmapImageRep* rep = [NSBitmapImageRep imageRepWithData:[NSData dataWithContentsOfFile:@(path)]];
+        assert(rep && rep.pixelsWide == 40 && rep.pixelsHigh == 24 && rep.samplesPerPixel == 4);
+        for (NSInteger y = 0; y < 24; y++)
+            for (NSInteger x = 0; x < 40; x++) {
+                const uint8_t* p = rep.bitmapData + y * rep.bytesPerRow + x * 4;
+                assert(p[0] == 100 && p[1] == y && p[2] == x && p[3] == 255);   /* RGBA, opaque */
+            }
+        printf("[present status] screenshot of a drawable: %s\n", path);
+        unlink(path);
+    }
+    s_layer = nil;
+
+    /* the headless target (or PS3_FRAMEGEN's real picture): readable as is,
+     * taken at once; the trigger file asks without a notice */
+    s_notices = 0;
+    assert(shot_request(0));
+    assert(frame_with_shot(pic) && !s_shot_want && !s_shot_readable);
+    char path[512] = "";
+    for (int i = 0; i < 100 && shots_in(dir, NULL, 0) < 1; i++) run_main(0.05);
+    assert(shots_in(dir, path, sizeof path) == 1);
+    run_main(0.1);
+    assert(s_notices == 0);
+    unlink(path);
+
+    /* a frame that failed on the GPU: no file, the shot is over */
+    assert(shot_request(1));
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    NSUInteger w, h; int bgra;
+    id<MTLBuffer> shot = shot_encode(cb, pic, &w, &h, &bgra);
+    assert(shot);
+    [cb commit]; [cb waitUntilCompleted];
+    shot_write(shot, w, h, bgra, 0);
+    for (int i = 0; i < 40 && s_notices < 1; i++) run_main(0.05);
+    assert(s_notices == 1 && shots_in(dir, NULL, 0) == 0);
+    rmdir(dir);
+    puts("[present status] shot passed");
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        assert(argc == 2);
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { puts("[present status] no Metal device; skipped"); return 0; }
+        s_queue = [s_dev newCommandQueue];
+        assert(s_queue && eng_init(NULL, 0, 0) == 0);
+        if      (!strcmp(argv[1], "health"))  check_health();
+        else if (!strcmp(argv[1], "handler")) check_handler();
+        else if (!strcmp(argv[1], "blit"))    check_blit();
+        else if (!strcmp(argv[1], "shot"))    check_shot();
+        else return 2;
+    }
+    return 0;
+}
