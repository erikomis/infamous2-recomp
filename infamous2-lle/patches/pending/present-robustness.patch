+/* The layer's drawables readable (on) or display-only again; main thread. */
+static void shot_layer_readable(int on)
+{
+#if !TARGET_OS_IPHONE
+    if (s_headless) return;
+    dispatch_async(dispatch_get_main_queue(), ^{ if (s_layer) s_layer.framebufferOnly = on ? NO : YES; });
+#else
+    (void)on;
+#endif
+}
+/* 0: no folder to write it to (no debug mode). */
+static int shot_request(int from_key)
+{
+    if (!shot_dir()) return 0;
+    __atomic_store_n(&s_shot_notice, from_key, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_shot_want, 1, __ATOMIC_RELEASE);
+    return 1;
+}
+static void shot_finish(void)
+{
+    if (__atomic_exchange_n(&s_shot_readable, 0, __ATOMIC_ACQ_REL)) shot_layer_readable(0);
+    if (__atomic_exchange_n(&s_shot_notice, 0, __ATOMIC_ACQ_REL)) ps3_overlay_capture_notice();
+}
+static void shot_cancel(void)
+{
+    s_shot_wait = 0;
+    __atomic_store_n(&s_shot_want, 0, __ATOMIC_RELEASE);
+    shot_finish();
+}
+/* At a present, after the present pass and the overlay (t: what goes to the
+ * screen): t copied into a shared buffer on cb, or nil when no shot is
+ * wanted or t cannot be read yet. */
+static id<MTLBuffer> shot_encode(id<MTLCommandBuffer> cb, id<MTLTexture> t,
+                                 NSUInteger* ow, NSUInteger* oh, int* bgra)
+{
+    if (__builtin_expect(!__atomic_load_n(&s_shot_want, __ATOMIC_ACQUIRE), 1) || !t) return nil;
+    const MTLPixelFormat pf = [t pixelFormat];
+    const int is_bgra = pf == MTLPixelFormatBGRA8Unorm || pf == MTLPixelFormatBGRA8Unorm_sRGB;
+    if (!is_bgra && pf != MTLPixelFormatRGBA8Unorm && pf != MTLPixelFormatRGBA8Unorm_sRGB) {
+        fprintf(stderr, "[capture] screenshot: pixel format %lu not supported; none taken\n", (unsigned long)pf);
+        shot_cancel();
+        return nil;
