+/* ---- present command buffers that fail on the GPU --------------------------
+ * A present whose command buffer faults (a GPU hang, a bad resource, a
+ * kernel the GPU rejects) completes with MTLCommandBufferStatusError and the
+ * drawable is shown with whatever it held; without a look at the status
+ * nothing says so. Every asynchronous present -- the frame's command buffer,
+ * the vtable path's, PS3_FRAMEGEN's pacer copy -- reports its outcome here.
+ *
+ * Failures are said with the reason, the first 8 and then every 100th. Three
+ * frames in a row that used the Lanczos reduction (PS3_DOWNSCALE) and failed
+ * turn the reduction off, with gfx_downscale_fail's one line: it is the one
+ * stage of the present that is not ours (MetalPerformanceShaders), and
+ * without it the frame is what the old path gives. Only consecutive failures
+ * count: a frame that completes resets the run, and so does a failed frame
+ * that did not reduce (then the reduction is not what fails). The pacer's
+ * copy, which reduces nothing, neither adds to that run nor resets it. */
+typedef struct {
+    u32 failed;          /* every failed present command buffer so far */
+    u32 run;             /* failed in a row, of any kind */
+    u32 reduced_run;     /* frames that used the reduction, failed in a row */
+} PresentHealth;
+enum { PH_FRAME, PH_REDUCED, PH_COPY };              /* what the command buffer carried */
+enum { PH_LOG = 1, PH_DROP_REDUCTION = 2 };          /* what to do about it */
+static int present_health_note(PresentHealth* h, int failed, int kind)
+{
+    if (!failed) {
+        h->run = 0;
+        if (kind != PH_COPY) h->reduced_run = 0;
+        return 0;
+    }
+    int act = 0;
+    h->failed++; h->run++;
+    if (h->failed <= 8 || h->failed % 100 == 0) act |= PH_LOG;
+    if (kind == PH_REDUCED) {
+        if (++h->reduced_run >= 3) { act |= PH_DROP_REDUCTION; h->reduced_run = 0; }
+    } else if (kind == PH_FRAME) {
+        h->reduced_run = 0;
+    }
+    return act;
+}
+static PresentHealth   s_present_health;
+static pthread_mutex_t s_present_health_mu = PTHREAD_MUTEX_INITIALIZER;
+/* From a present's completion handler (any thread). */
+static void present_health(id<MTLCommandBuffer> done, int kind)
+{
+    const int failed = [done status] == MTLCommandBufferStatusError;
+    pthread_mutex_lock(&s_present_health_mu);
+    const int act = present_health_note(&s_present_health, failed, kind);
+    const u32 n = s_present_health.failed, run = s_present_health.run;
+    pthread_mutex_unlock(&s_present_health_mu);
+    if (act & PH_LOG) {
+        NSError* err = [done error];
+        fprintf(stderr, "[rsx engine/metal] a present failed on the GPU (%u so far, %u in a row%s): %s (code %ld)\n",
+                n, run, kind == PH_REDUCED ? ", supersampled" : kind == PH_COPY ? ", frame generation's copy" : "",
+                err ? [[err localizedDescription] UTF8String] : "no reason given", err ? (long)[err code] : 0L);
+    }
+    if (act & PH_DROP_REDUCTION) gfx_downscale_fail("3 supersampled presents in a row failed on the GPU");
+}
