+            u8* p = rep.bitmapData;
+            for (NSUInteger i = 0; i < w * h; i++, s += 4, p += 4) {   /* to RGBA, opaque */
+                p[0] = s[bgra ? 2 : 0]; p[1] = s[1]; p[2] = s[bgra ? 0 : 2]; p[3] = 255;
+            }
