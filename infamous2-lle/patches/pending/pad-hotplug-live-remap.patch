+    assert(a2->rumble_calls == 1 && a2->rumble_lo == 0 && a2->rumble_hi == 0);
+    a2->buttons = 1u << SDL_CONTROLLER_BUTTON_A;
+    assert(data_digital2(0) & CROSS_BIT);                   /* it plays again */
+    a2->buttons = 0;
