+/* PS3_SHADER_PARALLEL (default on; 0 = the serial path, live through
+ * PS3_TOGGLE_FILE): a pipeline miss returns its handle at once and its
+ * shaders are translated (glslang + spirv-cross, ~8 ms each), compiled and the
+ * pipeline state built on a pool of worker threads, so the misses of one frame
+ * overlap each other and the rest of the FIFO drain instead of running one
+ * after another on the RSX thread (in New Marais, 39 shaders new to the cache
+ * made a 331 ms frame; 2026-11-12, 3 workers: ~100 ms). Nothing is skipped:
+ * before a submission's draws are encoded (a flush, a present, on whichever
+ * thread encodes) every pipeline they use is waited for, and the waiting
+ * thread runs queued builds itself meanwhile. A build that fails leaves the pipeline not ready and its draws
+ * are dropped, as the serial path drops a pipeline it could not build.
+ * Workers: PS3_SHADER_WORKERS=<n>, default the performance cores minus five
+ * (five SPU threads, the PPU and the RSX thread are the game's busy ones),
+ * at least 2. PS3_SHADER_ASYNC=1 keeps its own serial queue and skips. */
+typedef struct EngParJob {
+    struct EngParJob* next;
+    u32   slot;
+    char* vs;            /* split VS HLSL (malloc) */
+    char* ps;            /* PS HLSL (malloc) */
+    void* pd;            /* MTLRenderPipelineDescriptor, CFBridgingRetain'd */
+} EngParJob;
+static pthread_mutex_t s_par_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_par_work = PTHREAD_COND_INITIALIZER;   /* a job was queued */
+static pthread_cond_t  s_par_done = PTHREAD_COND_INITIALIZER;   /* a job finished */
+static EngParJob *s_par_head, *s_par_tail;
+static volatile u32 s_par_inflight;     /* queued + running */
+static u32 s_par_workers;               /* threads started (0 = none yet) */
+static u32 s_par_jobs, s_par_waits;     /* stats: jobs submitted, encode waits */
+static double s_par_wait_ms;
+static int s_par_on = -1;               /* PS3T_SHADER_PARALLEL */
+static void eng_par_set(int id, int v) { (void)id; __atomic_store_n(&s_par_on, v != 0, __ATOMIC_RELAXED); }
+
+static void eng_par_run(EngParJob* j)
+{
+    @autoreleasepool {
+        MTLRenderPipelineDescriptor* pd = (MTLRenderPipelineDescriptor*)CFBridgingRelease(j->pd);
+        id<MTLFunction> v = eng_function(j->vs, RSX_SHADER_STAGE_VERTEX, "vp");
+        id<MTLFunction> f = v ? eng_function(j->ps, RSX_SHADER_STAGE_FRAGMENT, "fp") : nil;
+        id<MTLRenderPipelineState> built = nil;
+        if (v && f) {
+            pd.vertexFunction = v; pd.fragmentFunction = f;
+            NSError* e = nil;
+            const uint64_t t0 = PS3_FT_ON() ? ps3_ft_now() : 0;
+            built = [s_dev newRenderPipelineStateWithDescriptor:pd error:&e];
+            if (t0) ps3_ft_span(PS3_FT_COMPILE, 3, built != nil, 0, t0, ps3_ft_now());
+            if (!built) fprintf(stderr, "[rsx engine/metal] pipeline state failed: %s\n",
+                                [[e localizedDescription] UTF8String]);
+        }
+        if (!built) fprintf(stderr, "[rsx engine/metal] pipeline p=%u could not be built; its draws are dropped\n",
+                            j->slot + 1);
+        s_eng_pipe[j->slot].pso = built;
+        __atomic_store_n(&s_eng_pipe[j->slot].ready, built ? 1 : 0, __ATOMIC_RELEASE);
+    }
+    free(j->vs); free(j->ps);
+    const u32 slot = j->slot;
+    if (j->next != j) free(j);   /* next == j: a job on the caller's stack */
+    pthread_mutex_lock(&s_par_mu);
+    __atomic_store_n(&s_eng_pipe[slot].building, 0, __ATOMIC_RELEASE);
+    s_par_inflight--;
+    pthread_cond_broadcast(&s_par_done);
+    pthread_mutex_unlock(&s_par_mu);
+}
+
+/* Under s_par_mu: the queued job for `slot` (any slot when slot == ~0u: the
+ * oldest), unlinked, or NULL. */
+static EngParJob* eng_par_take_locked(u32 slot)
+{
+    EngParJob *prev = NULL, *j = s_par_head;
+    while (j && slot != ~0u && j->slot != slot) { prev = j; j = j->next; }
+    if (!j) return NULL;
+    if (prev) prev->next = j->next; else s_par_head = j->next;
+    if (s_par_tail == j) s_par_tail = prev;
+    j->next = NULL;
+    return j;
+}
+
+static void* eng_par_worker(void* arg)
+{
+    (void)arg;
+    pthread_setname_np("ps3recomp.shaders");
+    pthread_mutex_lock(&s_par_mu);
+    for (;;) {
+        EngParJob* j;
+        while (!(j = eng_par_take_locked(~0u))) pthread_cond_wait(&s_par_work, &s_par_mu);
+        pthread_mutex_unlock(&s_par_mu);
+        eng_par_run(j);
+        pthread_mutex_lock(&s_par_mu);
+    }
+    return NULL;
+}
+
+/* PS3_SHADER_PARALLEL is on (and PS3_SHADER_ASYNC off): the pool exists. */
+static int eng_par_ready(void)
+{
+    if (__builtin_expect(__atomic_load_n(&s_par_on, __ATOMIC_RELAXED) < 0, 0))
+        ps3_toggle_watch(PS3T_SHADER_PARALLEL, eng_par_set);
+    if (!__atomic_load_n(&s_par_on, __ATOMIC_RELAXED) || sc_async()) return 0;
+    if (s_par_workers) return 1;
+    /* The translator's own once-only state (glslang's process init, its
+     * knob reads) is set up here, on this thread, before any worker runs. */
+    { static const char warm[] = "float4 main() : SV_Target { return float4(0, 0, 0, 1); }\n";
+      char* out = (char*)malloc(64 * 1024); char log[256];
+      if (out) { (void)rsx_hlsl_to_msl(warm, RSX_SHADER_STAGE_FRAGMENT, out, 64 * 1024, log, sizeof log); free(out); } }
+    (void)sc_on();
+    int n = 0;
+    const char* e = getenv("PS3_SHADER_WORKERS");
+    if (e && atoi(e) > 0) n = atoi(e);
+    else {
+        int pc = 0; size_t sz = sizeof pc;
+        if (sysctlbyname("hw.perflevel0.physicalcpu", &pc, &sz, NULL, 0) != 0 || pc <= 0) pc = 4;
+        n = pc - 5;
+        if (n < 2) n = 2;
+    }
+    if (n > 16) n = 16;
+    pthread_attr_t at;
+    pthread_attr_init(&at);
+    pthread_attr_set_qos_class_np(&at, QOS_CLASS_USER_INITIATED, 0);
+    pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+    pthread_attr_setstacksize(&at, 8u << 20);   /* glslang recurses on deep expressions */
+    for (int i = 0; i < n; i++) {
+        pthread_t t;
+        if (pthread_create(&t, &at, eng_par_worker, NULL) == 0) s_par_workers++;
+    }
+    pthread_attr_destroy(&at);
+    if (!s_par_workers) { __atomic_store_n(&s_par_on, 0, __ATOMIC_RELAXED); return 0; }
+    fprintf(stderr, "[shader cache] PS3_SHADER_PARALLEL: new pipelines build on %u worker thread(s)"
+                    " and are waited for before their draws are encoded\n", s_par_workers);
+    return 1;
+}
+
+static void eng_par_submit(u32 slot, char* vs, char* ps, MTLRenderPipelineDescriptor* pd)
+{
+    EngParJob* j = (EngParJob*)calloc(1, sizeof *j);
+    if (!j) {   /* no memory for a job: build it here, as the serial path would */
+        EngParJob local = { NULL, slot, vs, ps, (void*)CFBridgingRetain(pd) };
+        local.next = &local;
+        pthread_mutex_lock(&s_par_mu); s_par_inflight++; pthread_mutex_unlock(&s_par_mu);
+        eng_par_run(&local);
+        return;
+    }
+    j->slot = slot; j->vs = vs; j->ps = ps; j->pd = (void*)CFBridgingRetain(pd);
+    pthread_mutex_lock(&s_par_mu);
+    if (s_par_tail) s_par_tail->next = j; else s_par_head = j;
+    s_par_tail = j;
+    s_par_inflight++;
+    s_par_jobs++;
+    pthread_cond_signal(&s_par_work);
+    pthread_mutex_unlock(&s_par_mu);
+}
+
+/* Wait until pipeline `slot` is built, or every queued/running build when
+ * slot == ~0u, running queued builds on this thread meanwhile (the one asked
+ * for first, else the oldest). */
+static void eng_par_wait(u32 slot)
+{
+    if (slot != ~0u ? !__atomic_load_n(&s_eng_pipe[slot].building, __ATOMIC_ACQUIRE)
+                    : !__atomic_load_n(&s_par_inflight, __ATOMIC_ACQUIRE)) return;
+    const uint64_t t0 = PS3_FT_ON() ? ps3_ft_now() : 0;
+    const double w0 = (double)clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    pthread_mutex_lock(&s_par_mu);
+    while (slot != ~0u ? s_eng_pipe[slot].building : s_par_inflight != 0) {
+        EngParJob* j = slot != ~0u ? eng_par_take_locked(slot) : NULL;
+        if (!j) j = eng_par_take_locked(~0u);
+        if (j) {
+            pthread_mutex_unlock(&s_par_mu);
+            eng_par_run(j);
+            pthread_mutex_lock(&s_par_mu);
+            continue;
+        }
+        pthread_cond_wait(&s_par_done, &s_par_mu);
+    }
+    s_par_waits++;
+    s_par_wait_ms += ((double)clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - w0) / 1e6;
+    pthread_mutex_unlock(&s_par_mu);
+    if (t0) ps3_ft_span(PS3_FT_COMPILE, 5, 1, slot != ~0u ? slot + 1 : 0, t0, ps3_ft_now());
+}
+
+/* Before a submission is encoded: every pipeline its draws use is built. */
+static void eng_par_wait_records(const EngRecord* recs, u32 n)
+{
+    if (!__atomic_load_n(&s_par_inflight, __ATOMIC_ACQUIRE)) return;
+    for (u32 i = 0; i < n; i++) {
+        const u32 p = recs[i].pipeline;
+        if (recs[i].kind == ENG_REC_DRAW && p && p <= s_eng_pipe_count &&
+            __atomic_load_n(&s_eng_pipe[p - 1].building, __ATOMIC_ACQUIRE))
+            eng_par_wait(p - 1);
+    }
+}
