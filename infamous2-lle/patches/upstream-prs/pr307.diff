+                "dim%u levels%u cube%u color%u raster%u\n", unit, s->w, s->h, (u32)s->fmt,
+                s->pitch, t->width, t->height, t->format, t->pitch,
+                t->dimension, t->mipmaps, t->cubemap, sf.color_format, sf.raster_type);
+    return ENG_INVALID;
+}
