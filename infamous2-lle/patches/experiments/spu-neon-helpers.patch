diff --git a/runtime/spu/tests/test_spu_fcmp_neon.c b/runtime/spu/tests/test_spu_fcmp_neon.c
new file mode 100644
index 0000000..7b7c081
--- /dev/null
+++ b/runtime/spu/tests/test_spu_fcmp_neon.c
@@ -0,0 +1,55 @@
+/* test_spu_fcmp_neon.c -- the NEON fceq/fcgt/fcmeq/fcmgt must match the scalar
+ * references (spu_*_ref) bit for bit: random words, plus every pairing of the
+ * edge classes (both zeros, denormals, the smallest/largest normals, infinities,
+ * NaNs, both signs). Build on arm64:
+ *   cc -O2 -I.. -I../../../include test_spu_fcmp_neon.c -o t && ./t */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static const uint32_t k_edge[] = {
+    0x00000000u, 0x80000000u, 0x00000001u, 0x807FFFFFu, 0x007FFFFFu, 0x00800000u,
+    0x80800000u, 0x3F800000u, 0xBF800000u, 0x3F800001u, 0x7F7FFFFFu, 0xFF7FFFFFu,
+    0x7F800000u, 0xFF800000u, 0x7FC00000u, 0xFFFFFFFFu, 0x7FFFFFFFu, 0x00400000u,
+};
+#define NEDGE (int)(sizeof k_edge / sizeof k_edge[0])
+
+static uint32_t rnd32(void) { return ((uint32_t)rand() << 16) ^ (uint32_t)rand(); }
+
+static int check(u128 a, u128 b, long n)
+{
+#define CMP(op) do { u128 x = spu_##op(a, b), y = spu_##op##_ref(a, b); \
+        if (memcmp(&x, &y, 16)) { printf("test_spu_fcmp_neon: %s MISMATCH (case %ld) a=%08X b=%08X\n", #op, n, a._u32[0], b._u32[0]); return 1; } } while (0)
+    CMP(fceq); CMP(fcgt); CMP(fcmeq); CMP(fcmgt);
+#undef CMP
+    return 0;
+}
+
+int main(void)
+{
+#if !defined(__ARM_NEON)
+    puts("test_spu_fcmp_neon: not arm64, nothing to compare");
+    return 0;
+#else
+    long n = 0;
+    for (int i = 0; i < NEDGE; i++)
+        for (int j = 0; j < NEDGE; j++) {
+            u128 a, b;
+            for (int l = 0; l < 4; l++) { a._u32[l] = k_edge[(i + l) % NEDGE]; b._u32[l] = k_edge[(j + 3 * l) % NEDGE]; }
+            a._u32[0] = k_edge[i]; b._u32[0] = k_edge[j];
+            if (check(a, b, n++)) return 1;
+        }
+    srand(4242);
+    for (long it = 0; it < 4000000; it++) {
+        u128 a, b;
+        for (int l = 0; l < 4; l++) {
+            a._u32[l] = rnd32();
+            /* Half the time b is a near neighbour of a, so equal/adjacent keys occur. */
+            b._u32[l] = (it & 1) ? a._u32[l] + (uint32_t)(rand() % 5) - 2u : rnd32();
+        }
+        if (check(a, b, n++)) return 1;
+    }
+    printf("test_spu_fcmp_neon: ok (%ld cases x 4 ops)\n", n);
+    return 0;
+#endif
+}
