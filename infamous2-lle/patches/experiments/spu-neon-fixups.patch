+    const float64x2_t lo = vaddq_f64(spu__nv_wide(vget_low_u32(x)), spu__nv_wide(vget_low_u32(y)));
+    const float64x2_t hi = vaddq_f64(spu__nv_wide(vget_high_u32(x)), spu__nv_wide(vget_high_u32(y)));
+    const uint32x4_t r = vcombine_u32(spu__nv_narrow(lo, NULL), spu__nv_narrow(hi, NULL));
+    const uint32x4_t bx = spu__nv_bexp(x), by = spu__nv_bexp(y);
+    const uint32x4_t gap = vandq_u32(vandq_u32(vtstq_u32(bx, bx), vtstq_u32(by, by)),
+                                     vcgtq_u32(vabdq_u32(bx, by), vdupq_n_u32(29)));
+    const uint32x4_t dom = vbslq_u32(vcgtq_u32(bx, by), x, y);
+    const uint32x4_t opp = vshrq_n_u32(veorq_u32(x, y), 31);           /* 1 where the signs differ */
+    return vbslq_u32(gap, vsubq_u32(dom, opp), r);
