+SPU__NV_INLINE uint32x2_t spu__nv_fma_med_half(float64x2_t p, float64x2_t z) {
+    float64x2_t err;
+    const float64x2_t sm = spu__nv_twosum(p, z, &err);
+    uint32x2_t special;
+    const uint32x2_t r = spu__nv_narrow(sm, &special);
+    const uint64x2_t su = vreinterpretq_u64_f64(sm), eu = vreinterpretq_u64_f64(err);
+    /* on a 24-bit boundary, rounded, and the exact value is below it in magnitude */
+    const uint64x2_t adj = vbicq_u64(vandq_u64(vceqzq_u64(vandq_u64(su, vdupq_n_u64(0x1FFFFFFFull))),
+                                               vtstq_u64(veorq_u64(su, eu), vdupq_n_u64(0x8000000000000000ull))),
+                                     vceqzq_f64(err));
+    const uint32x2_t a = vbic_u32(vmovn_u64(adj), special);
+    const uint32x2_t r1 = vadd_u32(r, a);                                /* a = -1 where adjusted */
+    /* below 2^-126 after the step: the SPU's +0 */
+    const uint32x2_t uf = vand_u32(a, vceq_u32(vand_u32(r, vdup_n_u32(0x7FFFFFFFu)), vdup_n_u32(0x00800000u)));
+    return vbic_u32(r1, uf);
