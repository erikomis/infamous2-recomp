+SPU__NV_INLINE uint32x4_t spu__nv_fma_med(uint32x4_t x, uint32x4_t y, uint32x4_t z) {   /* signs adjusted */
+    const float64x2_t plo = vmulq_f64(spu__nv_wide(vget_low_u32(x)), spu__nv_wide(vget_low_u32(y)));
