+/* The fix-ups' vector form (PS3_SPU_NEON_FIX, default on): all four lanes
+ * exact in double, for every input the fast path turns down -- exponent-0
+ * words (SPU zeros), extended range (exponent 255), exponent gaps over 29,
+ * results outside the normal range, fma sums rounded onto a 24-bit boundary.
+ * A New Marais walk sent ~1.7G fa lanes a run to the scalar fix-up for the
+ * gap alone and ~1.5G fma lanes for zero/extended operands; the scalar path
+ * (spu__sf_sum, 128-bit integers per lane) was ~3% of SPU time.
+ *  - widening: an SPU single with biased exponent 1..255 is exactly
+ *    (-1)^s 1.m 2^(be-127) in double, built from its bits; exponent 0 is 0;
+ *  - fm: the 48-bit product is exact in double; fa: the sum is exact when
+ *    the exponents differ by at most 29, and otherwise the smaller term lies
+ *    below half the larger one's last bit, so the truncated sum is the larger
+ *    term (same sign) or its bit pattern minus one (opposite sign: it cannot
+ *    underflow, the larger term's exponent is at least 31);
+ *  - fma: the product is exact, the sum is rounded once (TwoSum gives the
+ *    error); truncating the rounded sum is exact unless it landed on a 24-bit
+ *    boundary with a nonzero error; there the truncation is the boundary itself
+ *    when the error has the sum's sign, else the pattern just below it (minus
+ *    one; +0 when that falls under 2^-126);
+ *  - narrowing truncates (the low 29 bits go), saturates above Smax and gives
+ *    +0 below Smin and for zero, as spu__sf_pack.
+ * tests/test_spu_float_neon.c checks it against the exact lanes. */
+/* p + z in double with its exact rounding error (Knuth's TwoSum: round to nearest, no overflow
+ * -- the operands here are at most 2^257). *err == 0 means the sum was exact. */
+SPU__NV_INLINE float64x2_t spu__nv_twosum(float64x2_t p, float64x2_t z, float64x2_t* err) {
+    const float64x2_t s = vaddq_f64(p, z), bb = vsubq_f64(s, p);
+    *err = vaddq_f64(vsubq_f64(p, vsubq_f64(s, bb)), vsubq_f64(z, bb));
+    return s;
+}
+__attribute__((weak)) volatile int g_spu_neon_fix = 1;
+SPU__NV_INLINE float64x2_t spu__nv_wide(uint32x2_t w) {
+    const uint64x2_t u = vmovl_u32(w);
+    const uint64x2_t be = vandq_u64(vshrq_n_u64(u, 23), vdupq_n_u64(0xFF));
+    const uint64x2_t d = vorrq_u64(vorrq_u64(vshlq_n_u64(vandq_u64(u, vdupq_n_u64(0x80000000u)), 32),
+                                             vshlq_n_u64(vaddq_u64(be, vdupq_n_u64(1023 - 127)), 52)),
+                                   vshlq_n_u64(vandq_u64(u, vdupq_n_u64(0x7FFFFFu)), 29));
+    return vreinterpretq_f64_u64(vbicq_u64(d, vceqzq_u64(be)));
+}
+/* *special: the lanes that saturated or went to +0 (the fma adjust leaves them). */
+SPU__NV_INLINE uint32x2_t spu__nv_narrow(float64x2_t d, uint32x2_t* special) {
+    const uint64x2_t u = vreinterpretq_u64_f64(d);
+    const int64x2_t be = vsubq_s64(vreinterpretq_s64_u64(vandq_u64(vshrq_n_u64(u, 52), vdupq_n_u64(0x7FF))),
+                                   vdupq_n_s64(1023 - 127));
+    const uint64x2_t sign = vandq_u64(vshrq_n_u64(u, 32), vdupq_n_u64(0x80000000u));
+    uint64x2_t r = vorrq_u64(vorrq_u64(sign, vshlq_n_u64(vreinterpretq_u64_s64(be), 23)),
+                             vandq_u64(vshrq_n_u64(u, 29), vdupq_n_u64(0x7FFFFFu)));
+    const uint64x2_t over = vcgtq_s64(be, vdupq_n_s64(255)), under = vcltq_s64(be, vdupq_n_s64(1));
+    r = vbslq_u64(over, vorrq_u64(sign, vdupq_n_u64(0x7FFFFFFFu)), r);
+    r = vbicq_u64(r, under);
+    if (special) *special = vmovn_u64(vorrq_u64(over, under));
+    return vmovn_u64(r);
+}
+SPU__NV_INLINE uint32x4_t spu__nv_fm_med(uint32x4_t x, uint32x4_t y) {
+    const float64x2_t lo = vmulq_f64(spu__nv_wide(vget_low_u32(x)), spu__nv_wide(vget_low_u32(y)));
+    const float64x2_t hi = vmulq_f64(spu__nv_wide(vget_high_u32(x)), spu__nv_wide(vget_high_u32(y)));
+    return vcombine_u32(spu__nv_narrow(lo, NULL), spu__nv_narrow(hi, NULL));
