+/* test_spu_fi_neon.c: the NEON spu_fi against the scalar spu_fi_exact.
+ * Build: cc -O2 -I.. -I../.. -I../../../include test_spu_fi_neon.c -o /tmp/t && /tmp/t
+ * Every estimate exponent/sign with random fractions and ra, plus the edges
+ * (exponent 0, 1 and 255; base/step/y at 0 and all ones). */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "spu_context.h"
+#include "spu_helpers.h"
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)rng; }
+
+int main(void)
+{
+    unsigned long long n = 0, bad = 0;
+    static const uint32_t frac[] = { 0, 0x7FFFFFu, 0x7FFC00u, 0x3FFu, 0x400u, 0x1u, 0x400000u };
+    static const uint32_t ys[] = { 0, 0x7FFFFu, 0x40000u, 1u, 0xFFFFFFFFu, 0x80000000u };
+    for (uint32_t se = 0; se < 512; se++) {
+        for (int k = 0; k < 4000; k++) {
+            u128 a, b;
+            for (int l = 0; l < 4; l++) {
+                const uint32_t f = (k < 7 * 6) ? frac[k % 7] : rnd() & 0x7FFFFFu;
+                b._u32[l] = (se << 23) | f;
+                a._u32[l] = (k < 7 * 6) ? ys[(k / 7) % 6] : rnd();
+                if (l) { b._u32[l] = (rnd() & 0xFF800000u) | (rnd() & 0x7FFFFFu); if (l == 3) b._u32[l] &= 0x807FFFFFu; }
+            }
+            const u128 r = spu_fi(a, b), x = spu_fi_exact(a, b);
+            for (int l = 0; l < 4; l++, n++)
+                if (r._u32[l] != x._u32[l] && bad++ < 10)
+                    printf("fi(%08X, %08X): neon %08X exact %08X\n", a._u32[l], b._u32[l], r._u32[l], x._u32[l]);
+        }
+    }
+    printf("spu_fi NEON vs exact: %llu lanes, %llu mismatches\n", n, bad);
+    return bad != 0;
+}
