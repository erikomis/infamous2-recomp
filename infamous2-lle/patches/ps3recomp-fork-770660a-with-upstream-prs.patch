+        const u32 source = (control1 >> (2u * i)) & 3u;
+        if (remap[i] < RSX_REMAP_ZERO && ((filter >> (28u + source)) & 1u))
+            gamma &= (u8)~(1u << rgba_lane[i]);
+    }
+    return gamma;
+}
