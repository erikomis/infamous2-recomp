diff --git a/libs/video/tests/test_fp_decompiler.c b/libs/video/tests/test_fp_decompiler.c
index b75424f..54f0c7b 100644
--- a/libs/video/tests/test_fp_decompiler.c
+++ b/libs/video/tests/test_fp_decompiler.c
@@ -300,6 +300,122 @@ int main(void)
         check_absent("lif_handled", hlsl, "unhandled FP opcode");
     }
 
+    /* A unit bound to a 3D texture (SET_TEXTURE_FORMAT dimension 3) is
+     * declared Texture3D and sampled with three coordinates; TXP divides
+     * them by w. inFAMOUS 2's occlusion volumes look up an 8x8x8 cone LUT. */
+    {
+        u8 prog[16];
+        u32 nk = 0;
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(0) | END); /* TEX TC0 */
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        rsx_fp_decompile_buffered_shadow_color_expand_vol_ex(prog, sizeof prog, CTRL_32BIT, 0, 1u,
+                                                             NULL, NULL, NULL, hlsl, sizeof hlsl, &nk);
+        check("vol_decl",   hlsl, "Texture3D   rsx_tex0 : register(t0);");
+        check("vol_sample", hlsl, "rsx_tex0.Sample(rsx_samp[0], ((input.tc0).xyzw).xyz)");
+        put_word(prog + 0, OPC(0x18) | OUTMASK_ALL | INSRC(4) | TEXU(0) | END); /* TXP TC0 */
+        rsx_fp_decompile_buffered_shadow_color_expand_vol_ex(prog, sizeof prog, CTRL_32BIT, 0, 1u,
+                                                             NULL, NULL, NULL, hlsl, sizeof hlsl, &nk);
+        check("vol_txp", hlsl, "rsx_tex0.Sample(rsx_samp[0], ((input.tc0).xyzw).xyz / ((input.tc0).xyzw).w)");
+        /* No volume units: the array declaration and 2D sample as before. */
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(0) | END);
+        rsx_fp_decompile_buffered_shadow_color_expand_vol_ex(prog, sizeof prog, CTRL_32BIT, 0, 0,
+                                                             NULL, NULL, NULL, hlsl, sizeof hlsl, &nk);
+        check("vol_none", hlsl, "rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy)");
+    }
+
+    /* SRC2 bit 31 (perspective_corr) on a texcoord read multiplies the input
+     * by 1/w (RPCS3 FragmentProgramDecompiler: "Perspective correct flag
+     * multiplies the result by 1/w"). inFAMOUS 2's water writes uv*w from the
+     * vertex program and samples TC2 with the flag set; read raw, uv*w lands
+     * far outside the screen copy and the river samples black. */
+    {
+        u8 prog[16];
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(6) | TEXU(0) | END); /* TEX TC2 */
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 1u << 31);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("persp_tc_scaled", hlsl, "(input.tc2 * _rsx_inv_w(input.position))");
+        check("persp_helper",    hlsl, "#define _rsx_inv_w(p)");
+
+        put_word(prog + 12, 0);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("persp_off_raw",    hlsl, "((input.tc2).xyzw).xy");
+        check_absent("persp_off_no_helper", hlsl, "_rsx_inv_w");
+    }
+
+    /* Sign expansion: a TEX on a unit whose SET_TEXTURE_ADDRESS asks for the
+     * biased unsigned remap returns the masked lanes re-centred, and with
+     * EXP_TEX (OPDEST bit 21, the _bx2 modifier) as x*2-1 (RPCS3
+     * _process_texel). inFAMOUS 2's deferred composite reads its normals
+     * G-buffer that way; read unexpanded, normalize() ran on 0..1 encodings
+     * and every normal leaned towards (1,1,1). */
+    {
+        u8 prog[16];
+        u8 expand[16] = {0};
+        u32 nk = 0;
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(0) | (1u << 21) | END); /* TEX TC0, EXP_TEX */
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        expand[0] = 0x7;   /* R, G, B lanes signed */
+        check_true("expand_units", rsx_fp_texture_expand_units(prog, sizeof prog, expand) == 1u);
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, NULL,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check("expand_wrapped", hlsl, "_rsx_expand_input(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), 15u, true)");
+        check("expand_helper",  hlsl, "float4 _rsx_expand_input(float4 v, uint mask, bool bx2)");
+        check("expand_math",    hlsl, "v * 2.0 - 1.0");
+
+        expand[0] = 0;     /* the unit is not biased: _bx2 still expands every lane */
+        check_true("expand_units_none", rsx_fp_texture_expand_units(prog, sizeof prog, expand) == 0u);
+        check_true("bx2_units", rsx_fp_texture_bx2_units(prog, sizeof prog) == 1u);
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, NULL,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check("expand_bx2_unbiased", hlsl, "_rsx_expand_input(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), 15u, true)");
+        /* ...and the older entry point, with no masks, is byte-identical. */
+        char plain[16384];
+        rsx_fp_decompile_buffered_shadow_color_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, NULL,
+                                                  plain, sizeof plain, &nk);
+        check_true("expand_old_entry_identical", strcmp(plain, hlsl) == 0);
+
+        /* Biased but no EXP_TEX bit: the fetch still re-centres (RPCS3 applies
+         * the remap to every read; only the formula and gamma differ). */
+        expand[0] = 0x7;
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(0) | END);
+        check_true("expand_units_nobit", rsx_fp_texture_expand_units(prog, sizeof prog, expand) == 1u);
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, NULL,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check("expand_nobit_wrapped", hlsl, "_rsx_expand_input(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), 7u, false)");
+        check("expand_nobit_math",    hlsl, "(floor(v * 255.0 + 0.5) - 128.0) / 127.0");
+
+        /* Gamma lanes are decoded, not re-centred: gamma rgb + biased rgba
+         * leaves the expansion with the alpha lane only, around the gamma. */
+        u8 gamma[16] = {0}; gamma[0] = 0x7; expand[0] = 0xF;
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, gamma,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check("expand_after_gamma", hlsl,
+              "_rsx_expand_input(_rsx_gamma_input(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), 7u), 8u, false)");
+        /* Gamma on every biased lane: nothing left to expand. */
+        gamma[0] = 0xF;
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, gamma,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check_absent("expand_all_gamma", hlsl, "_rsx_expand_input(rsx_tex");
+        /* With EXP_TEX, gamma steps aside and every biased lane is x*2-1. */
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(0) | (1u << 21) | END);
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, gamma,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check("expand_bx2_over_gamma", hlsl, "_rsx_expand_input(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), 15u, true)");
+        check_absent("expand_bx2_no_gamma", hlsl, "_rsx_gamma_input(");
+        /* Bit 4 (16-bit channels) rides along in the mask argument. */
+        expand[0] = 0x13;
+        put_word(prog + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(0) | END);
+        rsx_fp_decompile_buffered_shadow_color_expand_ex(prog, sizeof prog, CTRL_32BIT, 0, NULL, NULL,
+                                                         expand, hlsl, sizeof hlsl, &nk);
+        check("expand_16bit", hlsl, "_rsx_expand_input(rsx_tex[0].Sample(rsx_samp[0], ((input.tc0).xyzw).xy), 19u, false)");
+    }
+
     printf("\n===========================================\n");
     printf("Results: %d passed, %d failed\n", g_pass, g_fail);
     return g_fail ? 1 : 0;
diff --git a/libs/video/tests/test_gcm_flip_wrap.c b/libs/video/tests/test_gcm_flip_wrap.c
new file mode 100644
index 0000000..4938056
--- /dev/null
+++ b/libs/video/tests/test_gcm_flip_wrap.c
@@ -0,0 +1,116 @@
+/* The flip HLE's in-FIFO flip (gcm_flip_into_fifo, used by
+ * _cellGcmSetFlipCommand) wraps a nearly used command buffer back to its
+ * begin only when the runtime owns that buffer.
+ *
+ * Two contexts, both "nearly full" (less than GCM_FLIP_WRAP_BYTES left) with
+ * the walker far past their begin:
+ *   - the runtime's own ring, made by cellGcmSetupContext (its buffer-full
+ *     callback is the runtime's): the flip marker is written, then a JUMP to
+ *     begin, and current goes back to begin;
+ *   - a title's context with its own buffer-full callback: the flip marker is
+ *     written and current advances past it; no JUMP, no rewind.
+ *
+ * gcc -std=gnu17 -I include -I libs/video libs/video/tests/test_gcm_flip_wrap.c
+ *   -ffunction-sections -fdata-sections -Wl,--gc-sections -pthread
+ *   -o /tmp/test_gcm_flip_wrap        (clang on macOS: -Wl,-dead_strip)
+ */
+#include "../cellGcmSys.c"
+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+/* The rest of the walker's world: no graphics backend, no lifted program. */
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+int  rsx_process_method(rsx_state* state, u32 method, u32 data) { (void)state; (void)method; (void)data; return 0; }
+int  rsx_draw_engine_enabled(void) { return 0; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+
+#define IO_ADDR   0x00100000u
+#define IO_SIZE   0x00400000u
+#define CMD_SIZE  0x00080000u
+#define TITLE_CB  0x012D6A78u      /* a title function: its own buffer-full callback */
+
+static uint32_t g_heap = 0x00800000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void host_w32(u32 ea, u32 v) { vm_write32(ea, v); }
+
+static int fails;
+/* Put ctx's current 0x10000 bytes before its end, the walker 0x28000 bytes
+ * past its begin, flip, and report what happened to the buffer. */
+static void flip_on(const char* what, u32 ctx, int want_wrap)
+{
+    const u32 begin = vm_read32(ctx), end = vm_read32(ctx + 4), cur = end - 0x10000u;
+    vm_write32(ctx + 8, cur);
+    vm_write32(cur, 0); vm_write32(cur + 4, 0);
+    s_fifo_getoff = gcm_ea2io(begin) + 0x28000u;
+    int r = gcm_flip_into_fifo(ctx, 1);
+    const u32 marker = vm_read32(cur), next = vm_read32(cur + 4), now = vm_read32(ctx + 8);
+    const int wrapped = next == (0x20000000u | gcm_ea2io(begin)) && now == begin;
+    const int advanced = next == 0 && now == cur + 4;
+    const int ok = r == 1 && marker == (GCM_FLIP_MARKER | 1u) && (want_wrap ? wrapped : advanced);
+    printf("[%s] %s: marker 0x%08X, next word 0x%08X, current %s\n", ok ? "PASS" : "FAIL", what,
+           marker, next, wrapped ? "rewound to begin (JUMP written)" : advanced ? "advanced past the marker" : "?");
+    fails += !ok;
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+
+    u32 ctx_out = host_alloc(4, 4);
+    u32 rt = cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    s_display_buffer_set[1] = 1;
+
+    /* The title's draw context: 0x30000 bytes inside the IO window, with its
+     * own callback descriptor. */
+    const u32 tctx = host_alloc(0x18, 16), tbuf = IO_ADDR + 0x200000u;
+    vm_write32(tctx + 0x0, tbuf);
+    vm_write32(tctx + 0x4, tbuf + 0x30000u);
+    vm_write32(tctx + 0x8, tbuf);
+    vm_write32(tctx + 0xC, tctx + 0x10);
+    vm_write32(tctx + 0x10, TITLE_CB);
+    vm_write32(tctx + 0x14, 0);
+
+    flip_on("runtime ring (cellGcmSetupContext)", rt, 1);
+    flip_on("title context (own callback)", tctx, 0);
+    printf("[gcm_flip_wrap] %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    free(vm_base);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_metal_frame_rate.m b/libs/video/tests/test_metal_frame_rate.m
new file mode 100644
index 0000000..c02bc36
--- /dev/null
+++ b/libs/video/tests/test_metal_frame_rate.m
@@ -0,0 +1,279 @@
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+#include <IOKit/graphics/IOGraphicsTypes.h>
+
+/* Observe Metal independently of the production handler, including dropped
+ * frames whose presentedTime is zero. This is fixture-only instrumentation. */
+@interface FixturePresentations : NSObject {
+@public
+ pthread_mutex_t lock;
+ unsigned callbacks;
+ unsigned positive;
+ double last_positive, last_callback;
+ double times[6];
+}
+@end
+@implementation FixturePresentations
+- (instancetype)init {
+ if ((self=[super init])) pthread_mutex_init(&lock,NULL);
+ return self;
+}
+- (void)dealloc { pthread_mutex_destroy(&lock); }
+@end
+
+/* Only presentation callbacks are controlled here. Passing this substitute to
+ * fps_track_drawable executes the same registration and callback as Metal. */
+@interface FixtureDrawable : NSObject <MTLDrawable>
+@property(nonatomic) CFTimeInterval presentedTime;
+@property(nonatomic) NSUInteger drawableID;
+@property(nonatomic,strong) NSMutableArray *handlers;
+- (void)emitPresentedTime:(double)time;
+@end
+@implementation FixtureDrawable
+- (instancetype)init {
+ if ((self=[super init])) _handlers=[NSMutableArray new];
+ return self;
+}
+- (void)addPresentedHandler:(MTLDrawablePresentedHandler)handler {
+ [_handlers addObject:[handler copy]];
+}
+- (void)emitPresentedTime:(double)time {
+ _presentedTime=time;
+ for (MTLDrawablePresentedHandler handler in _handlers) handler(self);
+}
+- (void)present { assert(!"Use explicit fixture timestamps"); }
+- (void)presentAtTime:(CFTimeInterval)time { (void)time;[self present]; }
+- (void)presentAfterMinimumDuration:(CFTimeInterval)duration { (void)duration;[self present]; }
+@end
+
+static void check_callback_contract(void) {
+ MetalFrameRateSession *old=[MetalFrameRateSession new];
+ pthread_mutex_lock(&s_fps_session_lock);s_fps_session=old;
+ pthread_mutex_unlock(&s_fps_session_lock);
+ FixtureDrawable *drawable=[FixtureDrawable new];
+ fps_track_drawable((id<CAMetalDrawable>)drawable);
+ assert(drawable.handlers.count==1 && old->stats.displayed==0);
+ [drawable emitPresentedTime:0]; /* completion/drop is not a display frame */
+ assert(old->stats.displayed==0);
+ [drawable emitPresentedTime:10];
+ assert(old->stats.displayed==1 && old->stats.last_presented==10);
+ [drawable emitPresentedTime:10]; /* duplicates and stale callbacks */
+ [drawable emitPresentedTime:9];
+ [drawable emitPresentedTime:NAN];
+ [drawable emitPresentedTime:INFINITY];
+ assert(old->stats.displayed==1 && old->stats.last_presented==10);
+ [drawable emitPresentedTime:10.25];
+ assert(old->stats.displayed==2 && old->stats.guest==0);
+ assert(old->stats.interval_count==1 && old->stats.interval_sum==250);
+ __weak MetalFrameRateSession *retained=old;
+ fps_stop();
+ old=nil;
+ assert(retained); /* compositor-owned handler must keep its session alive */
+ MetalFrameRateSession *late=retained;
+ MetalFrameRateSession *fresh=[MetalFrameRateSession new];
+ pthread_mutex_lock(&s_fps_session_lock);s_fps_session=fresh;
+ pthread_mutex_unlock(&s_fps_session_lock);
+ [drawable emitPresentedTime:10.5]; /* retained old handler after restart */
+ assert(late->stats.displayed==3 && fresh->stats.displayed==0);
+ rsx_metal_backend_note_guest_frame();
+ assert(fresh->stats.guest==1 && late->stats.guest==0);
+ fps_stop();
+ FixtureDrawable *disabled=[FixtureDrawable new];
+ fps_track_drawable((id<CAMetalDrawable>)disabled);
+ fps_track_drawable(nil);
+ assert(disabled.handlers.count==0);
+ fprintf(stderr,"[FPS fixture] deterministic callback contract passed\n");
+}
+
+static int log_display_environment(void) {
+ CGDirectDisplayID displays[16];uint32_t count=0;
+ CGError error=CGGetActiveDisplayList(16,displays,&count);
+ fprintf(stderr,"[FPS fixture] device=%s active_displays=%u display_error=%d app_active=%d window_visible=%d occlusion_visible=%d layer_size=%.0fx%.0f\n",
+     s_dev.name.UTF8String,count,error,NSApp.active,s_window.visible,
+     !!(s_window.occlusionState&NSWindowOcclusionStateVisible),
+     s_layer.bounds.size.width,s_layer.bounds.size.height);
+ for (uint32_t i=0;i<count;i++) fprintf(stderr,
+     "[FPS fixture] display=%u online=%d active=%d builtin=%d vendor=%u model=%u pixels=%zux%zu\n",
+     displays[i],CGDisplayIsOnline(displays[i]),CGDisplayIsActive(displays[i]),
+     CGDisplayIsBuiltin(displays[i]),CGDisplayVendorNumber(displays[i]),
+     CGDisplayModelNumber(displays[i]),CGDisplayPixelsWide(displays[i]),CGDisplayPixelsHigh(displays[i]));
+ NSArray *windows=CFBridgingRelease(CGWindowListCopyWindowInfo(
+     kCGWindowListOptionIncludingWindow,(CGWindowID)s_window.windowNumber));
+ NSDictionary *window=windows.firstObject;
+ fprintf(stderr,"[FPS fixture] window_number=%ld cg_onscreen=%d cg_layer=%ld cg_bounds=%s\n",
+     (long)s_window.windowNumber,[window[(id)kCGWindowIsOnscreen] boolValue],
+     [window[(id)kCGWindowLayer] longValue],
+     [window[(id)kCGWindowBounds] description].UTF8String);
+ CGDirectDisplayID display=[s_window.screen.deviceDescription[@"NSScreenNumber"] unsignedIntValue];
+ uint32_t vendor=CGDisplayVendorNumber(display),model=CGDisplayModelNumber(display);
+ /* I/O Kit monitor identity is a stronger precondition than a visible virtual
+  * window. It is not proof of physical scanout. Unknown/no-monitor IDs do not
+  * promise that Metal can report presentation timestamps. */
+ int identified=CGDisplayIsActive(display)&&CGDisplayIsOnline(display)&&
+     vendor&&vendor!=UINT32_MAX&&vendor!=kDisplayVendorIDUnknown&&
+     model&&model!=UINT32_MAX&&model!=kDisplayProductIDGeneric;
+ fprintf(stderr,"[FPS fixture] window_display=%u identified_monitor=%d\n",display,identified);
+ return identified;
+}
+
+/* Shutdown reaches these only for a fully initialized production engine. */
+void rsx_set_backend(rsx_backend* backend) { (void)backend; }
+void rsx_draw_engine_shutdown(void) {}
+void rsx_draw_engine_set_backend(const rsx_draw_backend* backend) { (void)backend; }
+static void* shutdown_worker(void* unused) {
+ (void)unused;rsx_metal_backend_shutdown();return NULL;
+}
+
+int main(int argc, char **argv) {
+ @autoreleasepool {
+  assert(argc == 2);
+  if (!strcmp(argv[1], "callback_contract")) {
+   check_callback_contract();
+  } else if (!strcmp(argv[1], "headless_shutdown")) {
+   s_headless=1;pthread_t worker;
+   assert(pthread_create(&worker,NULL,shutdown_worker,NULL)==0);
+   assert(pthread_join(worker,NULL)==0);
+  } else if (!strcmp(argv[1], "window") || !strcmp(argv[1], "drawable") || !strcmp(argv[1], "disabled")) {
+   setenv("PS3RECOMP_METAL_FPS", "1", 1);
+   if (!strcmp(argv[1], "disabled")) unsetenv("PS3RECOMP_METAL_FPS");
+   s_dev = MTLCreateSystemDefaultDevice(); assert(s_dev);
+   s_width = s_height = 64;
+   assert(create_window_impl("FPS fixture") == 0);
+   if (!strcmp(argv[1], "disabled")) {
+    [[NSRunLoop mainRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:1.2]];
+    assert([s_window.title isEqualToString:@"FPS fixture"]);
+#ifdef PS3RECOMP_METAL_FRAME_RATE
+    assert(!s_fps_session && !s_fps_timer);
+#endif
+   } else if (!strcmp(argv[1], "drawable")) {
+#ifdef PS3RECOMP_METAL_FRAME_RATE
+    /* Inspect the callback counters directly in this scenario. Sampling would
+     * reset them on the one-second timer while a slower compositor catches up;
+     * the separate window scenario verifies that timer. */
+    dispatch_source_cancel(s_fps_timer);s_fps_timer=nil;
+    s_queue=[s_dev newCommandQueue];assert(s_queue);
+    [NSApp finishLaunching];
+    [[NSRunLoop mainRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.1]];
+    [s_window display];[CATransaction flush];
+    const int identified_monitor=log_display_environment();
+    FixturePresentations *observed=[FixturePresentations new];
+    /* Read back our own clear, never any other application's image. */
+    s_layer.framebufferOnly=NO;
+    id<MTLBuffer> pixel=[s_dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    assert(pixel);
+    id<MTLCommandBuffer> flush=[s_queue commandBuffer];[flush commit];[flush waitUntilCompleted];
+    assert(flush.status==MTLCommandBufferStatusCompleted && !flush.error);
+    assert(s_fps_session->stats.displayed==0); /* GPU completion is not a presentation */
+    for (int frame=0;frame<6;frame++) {
+    id<CAMetalDrawable> drawable=[s_layer nextDrawable];assert(drawable);
+    fps_track_drawable(drawable);
+    [drawable addPresentedHandler:^(id<MTLDrawable> shown) {
+     pthread_mutex_lock(&observed->lock);
+     const double time=shown.presentedTime;
+     observed->times[frame]=time;++observed->callbacks;
+     if (isfinite(time)&&time>0&&time>observed->last_positive) {
+      ++observed->positive;observed->last_positive=time;
+     }
+     observed->last_callback=CACurrentMediaTime();
+     fprintf(stderr,"[FPS fixture] raw_callback frame=%d presented_time=%.9f\n",frame,time);
+     pthread_mutex_unlock(&observed->lock);
+    }];
+    rsx_metal_backend_note_guest_frame();
+    id<MTLCommandBuffer> cb=[s_queue commandBuffer];
+    MTLRenderPassDescriptor *pass=[MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture=drawable.texture;
+    pass.colorAttachments[0].loadAction=MTLLoadActionClear;
+    pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+    pass.colorAttachments[0].clearColor=MTLClearColorMake(0.1,0.3,0.5,1);
+    id<MTLRenderCommandEncoder> encoder=[cb renderCommandEncoderWithDescriptor:pass];
+    assert(encoder);[encoder endEncoding];
+    id<MTLBlitCommandEncoder> copy=[cb blitCommandEncoder];assert(copy);
+    [copy copyFromTexture:drawable.texture sourceSlice:0 sourceLevel:0
+        sourceOrigin:MTLOriginMake(32,32,0) sourceSize:MTLSizeMake(1,1,1)
+        toBuffer:pixel destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:256];
+    [copy endEncoding];
+    [cb presentDrawable:drawable];[cb commit];[cb waitUntilCompleted];
+    assert(cb.status==MTLCommandBufferStatusCompleted && !cb.error);
+    const unsigned char *bgra=pixel.contents;
+    assert(abs((int)bgra[0]-128)<=1 && abs((int)bgra[1]-77)<=1 &&
+        abs((int)bgra[2]-26)<=1 && bgra[3]==255);
+    [[NSRunLoop mainRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.05]];
+    }
+    fprintf(stderr,"[FPS fixture] GPU clears completed=6 readback BGRA=128,77,26,255 (within one byte)\n");
+    /* Completion precedes compositor callbacks. Wait for all observations and
+     * a quiet interval; a virtual display may never deliver them. */
+    const double deadline=CACurrentMediaTime()+5.0;
+    for (;;) {
+     pthread_mutex_lock(&observed->lock);
+     int settled=observed->callbacks==6&&CACurrentMediaTime()-observed->last_callback>=0.05;
+     pthread_mutex_unlock(&observed->lock);
+     if (settled || CACurrentMediaTime()>=deadline) break;
+     [[NSRunLoop mainRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.01]];
+    }
+    pthread_mutex_lock(&s_fps_session->lock);
+    pthread_mutex_lock(&observed->lock);
+    fprintf(stderr,"[FPS fixture] raw_callbacks=%u presented_times=%.9f,%.9f,%.9f,%.9f,%.9f,%.9f\n",
+        observed->callbacks,observed->times[0],observed->times[1],observed->times[2],
+        observed->times[3],observed->times[4],observed->times[5]);
+    fprintf(stderr,"[FPS fixture] drawable displayed=%llu guest=%llu raw_positive=%u\n",
+        s_fps_session->stats.displayed,s_fps_session->stats.guest,observed->positive);
+    assert(observed->callbacks<=6);
+    assert(s_fps_session->stats.displayed==observed->positive);
+    assert(s_fps_session->stats.last_presented==observed->last_positive);
+    if (identified_monitor) assert(s_fps_session->stats.displayed>0);
+    if (!observed->positive) fprintf(stderr,
+        "[FPS fixture] actual presentation unobserved; zero display FPS verified against raw Metal timestamps\n");
+    assert(s_fps_session->stats.guest==6);
+    pthread_mutex_unlock(&observed->lock);
+    pthread_mutex_unlock(&s_fps_session->lock);
+    MetalFrameRateSession *old=s_fps_session;
+    fps_stop();fps_start();
+    assert(s_fps_session!=old && s_fps_session->stats.displayed==0);
+#else
+    assert(!"Metal drawable tracking is missing");
+#endif
+   } else {
+   /* No rendering thread is running: the title must still update on a stall. */
+   [[NSRunLoop mainRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:1.2]];
+   assert([s_window.title containsString:@"display 0.0 FPS"]);
+   assert([s_window.title containsString:@"guest 0.0 FPS"]);
+   }
+#ifdef PS3RECOMP_METAL_FRAME_RATE
+   fps_stop();
+#endif
+   [s_window close];
+  } else {
+#ifdef PS3RECOMP_METAL_FRAME_RATE
+   MetalFrameRate stats = {0};
+   metal_frame_rate_reset(&stats, 10.0);
+   for (int i=1;i<=60;i++) metal_frame_rate_guest(&stats);
+   for (int i=1;i<=10;i++) metal_frame_rate_presented(&stats, 10.0+i*0.1);
+   MetalFrameRateSample sample = metal_frame_rate_sample(&stats, 11.0);
+   assert(fabs(sample.display_fps-10.0)<0.001);
+   assert(fabs(sample.guest_fps-60.0)<0.001);
+   assert(fabs(sample.average_ms-100.0)<0.001);
+   assert(fabs(sample.p95_ms-100.0)<0.001);
+   sample = metal_frame_rate_sample(&stats, 13.0);
+   assert(sample.display_fps==0 && sample.guest_fps==0);
+   assert(sample.average_ms==0 && sample.p95_ms==0);
+   assert(fabs(sample.age_seconds-2.0)<0.001);
+   metal_frame_rate_presented(&stats, 13.1);
+   metal_frame_rate_presented(&stats, 13.1); /* duplicate time cannot add a frame */
+   metal_frame_rate_presented(&stats, 12.9); /* out-of-order callback */
+   sample = metal_frame_rate_sample(&stats, 14.0);
+   assert(sample.display_fps==1 && sample.guest_fps==0);
+   assert(fabs(sample.worst_ms-2100.0)<0.001);
+   metal_frame_rate_reset(&stats, 20.0);
+   metal_frame_rate_presented(&stats, 20.01);
+   for (int i=1;i<=300;i++) metal_frame_rate_presented(&stats, 20.01+i*0.01);
+   sample=metal_frame_rate_sample(&stats, 24.0);
+   assert(sample.display_fps==75.25);
+   assert(fabs(sample.p95_ms-10.0)<0.001);
+   assert(fabs(sample.worst_ms-10.0)<0.001);
+#else
+   assert(!"Metal frame-rate measurement is missing");
+#endif
+  }
+  puts("Metal frame-rate scenario passed");
+ }
+}
diff --git a/libs/video/tests/test_metal_independent_clears.m b/libs/video/tests/test_metal_independent_clears.m
new file mode 100644
index 0000000..b9405c6
--- /dev/null
+++ b/libs/video/tests/test_metal_independent_clears.m
@@ -0,0 +1,55 @@
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+static id<MTLTexture> depth_texture(unsigned width,unsigned height) {
+ MTLTextureDescriptor*d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float_Stencil8 width:width height:height mipmapped:NO];
+ d.usage=MTLTextureUsageRenderTarget;d.storageMode=MTLStorageModePrivate;
+ id<MTLTexture> t=[s_dev newTextureWithDescriptor:d];assert(t);return t;
+}
+static void check_depth_stencil(id<MTLTexture> t,float depth,unsigned char stencil) {
+ NSUInteger row=256,size=row*t.height;
+ id<MTLBuffer> db=[s_dev newBufferWithLength:size options:MTLResourceStorageModeShared];
+ id<MTLBuffer> sb=[s_dev newBufferWithLength:size options:MTLResourceStorageModeShared];assert(db && sb);
+ id<MTLCommandBuffer> cb=[s_queue commandBuffer];id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];assert(blit);
+ [blit copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(t.width,t.height,1) toBuffer:db destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:size options:MTLBlitOptionDepthFromDepthStencil];
+ [blit copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(t.width,t.height,1) toBuffer:sb destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:size options:MTLBlitOptionStencilFromDepthStencil];
+ [blit endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+ for(NSUInteger y=0;y<t.height;y++)for(NSUInteger x=0;x<t.width;x++) {
+  float actual;memcpy(&actual,(unsigned char*)db.contents+y*row+x*4,4);assert(fabsf(actual-depth)<0.000001f);
+  assert(*((unsigned char*)sb.contents+y*row+x)==stencil);
+ }
+}
+int main(int argc,char**argv) {
+ @autoreleasepool {
+  assert(argc==2);s_dev=MTLCreateSystemDefaultDevice();assert(s_dev);
+  s_queue=[s_dev newCommandQueue];assert(s_queue);
+   /* Independent clears must cover each entire surface, even when consecutive
+    * records name targets of different dimensions. They are not a draw MRT. */
+   MTLTextureDescriptor*d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:2 height:2 mipmapped:NO];d.usage=MTLTextureUsageRenderTarget;d.storageMode=MTLStorageModeShared;
+   id<MTLTexture> a=[s_dev newTextureWithDescriptor:d];assert(a);
+   d.width=4;d.height=3;
+   id<MTLTexture> b=[s_dev newTextureWithDescriptor:d];assert(b);
+   u32 ha=eng_obj_add(a),hb=eng_obj_add(b);
+   float red[4]={1,0,0,1},green[4]={0,1,0,1};
+   int with_depth=!strcmp(argv[1],"independent_depth_stencil");
+   id<MTLTexture> da=nil,db=nil;u32 hda=0,hdb=0;
+   if(with_depth) {da=depth_texture(5,4);db=depth_texture(7,3);hda=eng_obj_add(da);hdb=eng_obj_add(db);}
+   eng_clear_color(NULL,ha,red);
+   if(with_depth)eng_clear_depth_stencil(NULL,hda,RSX_BE_CLEAR_DEPTH|RSX_BE_CLEAR_STENCIL,0.25f,7);
+   eng_clear_color(NULL,hb,green);
+   if(with_depth) {
+    eng_clear_depth_stencil(NULL,hdb,RSX_BE_CLEAR_DEPTH|RSX_BE_CLEAR_STENCIL,0.33f,13);
+    eng_clear_depth_stencil(NULL,hda,RSX_BE_CLEAR_DEPTH,0.75f,9);
+    eng_clear_depth_stencil(NULL,hda,RSX_BE_CLEAR_STENCIL,0.5f,11);
+   }
+   id<MTLCommandBuffer> cb=[s_queue commandBuffer];assert(cb);
+   eng_encode_records(cb,nil);[cb commit];[cb waitUntilCompleted];
+   assert(cb.status==MTLCommandBufferStatusCompleted);
+   unsigned char pixels[48]={0};
+   [a getBytes:pixels bytesPerRow:8 fromRegion:MTLRegionMake2D(0,0,2,2) mipmapLevel:0];
+   for(unsigned j=0;j<16;j+=4)assert(pixels[j]==255 && pixels[j+1]==0 && pixels[j+2]==0 && pixels[j+3]==255);
+   [b getBytes:pixels bytesPerRow:16 fromRegion:MTLRegionMake2D(0,0,4,3) mipmapLevel:0];
+   for(unsigned j=0;j<48;j+=4)assert(pixels[j]==0 && pixels[j+1]==255 && pixels[j+2]==0 && pixels[j+3]==255);
+   if(with_depth) {check_depth_stencil(da,0.75f,11);check_depth_stencil(db,0.33f,13);}
+  puts("Metal independent clears scenario passed");
+ }
+}
