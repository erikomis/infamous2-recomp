diff --git a/docs/FRAGMENT_COLOR_INPUTS.md b/docs/FRAGMENT_COLOR_INPUTS.md
new file mode 100644
index 0000000..2ba1dfe
--- /dev/null
+++ b/docs/FRAGMENT_COLOR_INPUTS.md
@@ -0,0 +1,26 @@
+# Fragment color input reads
+
+RSX fragment reads of COL0 and COL1 clamp every component to [0,1] before
+source swizzle, abs and negate. The clamp belongs at the fragment input
+expression; vertex output registers and texture coordinates stay unbounded.
+The shared input expression is used by all three instruction operands and
+by both legacy and buffered decompilation APIs.
+
+The production change is limited to the two COL0/COL1 input expressions.
+No render-target, cache, vertex-program, tone mapping, texture or shader-control
+behavior changes.
+
+`test_color_input_metal.m` uses actual translated shaders and an RGBA32Float
+target, which preserves values below0 and above1. MOV, MUL and MAD test both
+color inputs, all source positions, identity/reversed swizzles, abs/negate
+ordering, half/full export selection, and unrestricted FOG/TC0 controls. The
+optional RSX_COLOR_TEST_TEX9 define checks TC9 on baselines that already support
+it; it is not an additional feature of this patch.
+
+Primary oracle: RPCS3 FragmentProgramDecompiler.cpp GetSRC documents hardware
+tests and explicitly saturates input registers1/2 before source modifiers.
+https://github.com/RPCS3/rpcs3/blob/master/rpcs3/Emu/RSX/Program/FragmentProgramDecompiler.cpp
+
+NV_vertex_program also documents normalized color attributes at the fragment
+boundary, while texture-coordinate results remain unrestricted.
+https://registry.khronos.org/OpenGL/extensions/NV/NV_vertex_program.txt
diff --git a/docs/SHADOW_COMPARISON.md b/docs/SHADOW_COMPARISON.md
new file mode 100644
index 0000000..df98ec6
--- /dev/null
+++ b/docs/SHADOW_COMPARISON.md
@@ -0,0 +1,49 @@
+# Fragment depth texture comparisons
+
+The shared draw engine and legacy Metal path specialize referenced texture
+units from TEXTURE_ADDRESS zfunc. Native depth formats with alpha-kill off
+activate comparison only for controls 1 through 6. NEVER (0), ALWAYS (7),
+non-depth textures and alpha-kill keep the existing raw sampling behavior.
+
+TEX compares source z with stored red-channel depth. TXP divides xyz by w
+before comparison. The reference is clamped to [0,1], and the scalar comparison
+is replicated into all four lanes. Comparisons are reference <, ==, <=, >, !=,
+and >= stored depth in control order. Linear sampling compares four texel
+centers separately before interpolating visibility; it does not compare a
+filtered depth value. The existing sampler supplies address/border behavior.
+
+Depth snapshots are currently bound as color textures (R32Float for D24_D8,
+R16 UNORM for D16). Explicit HLSL comparisons preserve those bindings rather
+than requiring a native depth texture and comparison sampler. UN coordinates
+use the bound texture's dimensions. Only referenced active units add shader
+helpers and cache identity, avoiding unused texture bindings/readbacks.
+
+Supported comparison scope is 2D D24_D8 or D16, one mip level, TEX/TXP and
+matching nearest or linear min/mag filtering. Active float-depth formats,
+cubes/other dimensions, multiple mip levels, mismatched filters and
+TXB/TXL/TXD/TEXBEM/TXPBEM reject translation with a bounded diagnostic. The
+engine drops failed pipelines; the legacy Metal path also rejects these
+failures instead of its ordinary built-in shader fallback. Other standalone
+legacy backend paths still need to adopt the metadata API. Texture remapping,
+LOD/aniso extensions and full hardware shadow sampling precision are outside
+this correction's coverage; existing texture/sampler behavior is retained.
+
+Synthetic tests contain no title programs or data:
+
+- `test_shadow_metadata.c`: activation, ordinary HLSL retention, unsupported
+  layouts/fetches, sixteen-unit bounded output.
+- `test_shadow_engine.c`: production method dispatch, per-unit shader cache,
+  switchback, unused-unit bindings and rejected draw emission.
+- `test_shadow_compare_metal.m`: actual translated GPU comparisons, projected
+  reference, equality, raw endpoint controls and checked legacy failures.
+
+Contract references:
+
+- RPCS3 RSXTexture.cpp: ADDRESS bits 28..31 select zfunc.
+  https://github.com/RPCS3/rpcs3/blob/master/rpcs3/Emu/RSX/RSXTexture.cpp
+- RPCS3 RSXThread.cpp: depth formats, alpha-kill and strict endpoint activation.
+  https://github.com/RPCS3/rpcs3/blob/master/rpcs3/Emu/RSX/RSXThread.cpp
+- RPCS3 FragmentProgramDecompiler.cpp: TEX/TXP shadow reference and replication.
+  https://github.com/RPCS3/rpcs3/blob/master/rpcs3/Emu/RSX/Program/FragmentProgramDecompiler.cpp
+- OpenGL ARB_shadow: reference direction/clamp and comparison before filtering.
+  https://registry.khronos.org/OpenGL/extensions/ARB/ARB_shadow.txt
diff --git a/include/ps3emu/log_first.h b/include/ps3emu/log_first.h
new file mode 100644
index 0000000..e6c6867
--- /dev/null
+++ b/include/ps3emu/log_first.h
@@ -0,0 +1,22 @@
+/*
+ * ps3recomp - a log cap that cannot wrap
+ *
+ * PS3_LOG_FIRST(ctr, limit) is true for the first `limit` evaluations and
+ * false from then on. `if (__atomic_fetch_add(&n, 1, ...) < limit)` and
+ * `if (n++ < limit)` keep counting on every call, so on a hot path a signed
+ * int counter passes INT_MAX, wraps negative, and the line prints on every
+ * call from then on (millions of lines in a long session). This one stops
+ * counting at the limit. Callers racing on the same counter can carry it past
+ * the limit by one each, never around. As sp00nznet/ps3recomp#364.
+ *
+ * `ctr` is a plain integer lvalue (usually a function-local static); `limit`
+ * is evaluated up to twice.
+ */
+#ifndef PS3EMU_LOG_FIRST_H
+#define PS3EMU_LOG_FIRST_H
+
+#define PS3_LOG_FIRST(ctr, limit)                                   \
+    (__atomic_load_n(&(ctr), __ATOMIC_RELAXED) < (limit) &&         \
+     __atomic_fetch_add(&(ctr), 1, __ATOMIC_RELAXED) < (limit))
+
+#endif /* PS3EMU_LOG_FIRST_H */
diff --git a/include/ps3emu/ps3_ftrace.h b/include/ps3emu/ps3_ftrace.h
new file mode 100644
index 0000000..6c93d7a
--- /dev/null
+++ b/include/ps3emu/ps3_ftrace.h
@@ -0,0 +1,248 @@
+/*
+ * ps3_ftrace -- a timeline of who waits for whom, frame by frame.
+ *
+ * PS3_FTRACE=<start s>:<seconds>:<path> records timestamped spans from the PPU
+ * syscall dispatcher, the SPU channel waits, the RSX FIFO walker and the Metal
+ * backend for <seconds> starting <start s> after the first hook ran (~boot),
+ * then writes them to <path> as text for tools/ftrace_report.py:
+ *   # ps3_ftrace start_us=<n> end_us=<n> spans=<n> dropped=<n>
+ *   T <tid> <name>                         PPU thread names
+ *   <kind> <who> <a hex> <b hex> <t0 us> <t1 us>
+ *
+ * A sampling profile says where CPU time goes; it cannot say why a frame takes
+ * 130 ms when no thread is busy for 130 ms. That is a latency chain -- the PPU
+ * waiting on SPU tasks waiting on the RSX waiting on the GPU -- and only a
+ * timeline shows it.
+ *
+ * Header-only on purpose: the hooked files are also compiled on their own by
+ * self-contained tests, and a new link dependency would break each of them.
+ * The state is one weak/selectany object the linker folds into a single copy;
+ * the functions are static inline. Off (the default), every hook is a load
+ * and a predictable branch. Knobs: PS3_FTRACE_MIN_US (shortest span kept,
+ * default 20), PS3_FTRACE_MERGE_US (usleep polls of one thread at one call
+ * site closer than this become one span, default 300), PS3_FTRACE_CAP (spans
+ * kept, default 4M = 128 MB, allocated only when recording), PS3_FTRACE_KINDS
+ * (comma-separated span kinds to keep, default all: a long A/B run keeps
+ * 4,5,6,7,9,10,15 and leaves out the usleep polls that are most of a trace).
+ */
+#ifndef PS3EMU_PS3_FTRACE_H
+#define PS3EMU_PS3_FTRACE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include <time.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum ps3_ft_kind {
+    PS3_FT_SYSCALL     = 1,  /* who = PPU tid, a = syscall number, b = guest lr        */
+    PS3_FT_USLEEP      = 2,  /* who = PPU tid, a = usleep calls merged, b = guest lr   */
+    PS3_FT_SPU_WAIT    = 3,  /* who = SPU id,  a = channel,      b = LS pc             */
+    PS3_FT_SPU_BUSY    = 4,  /* who = SPU id,  a = lifted image, b = SPURS wid (LS 0x1DC) */
+    PS3_FT_SEMA        = 5,  /* RSX blocked on ACQUIRE: a = label offset, b = value    */
+    PS3_FT_SEMA_GAVEUP = 6,  /* same, ended by a bounded acquire giving up            */
+    PS3_FT_DRAIN       = 7,  /* one RSX FIFO drain pass, a = 1 if it ended on an ACQUIRE */
+    PS3_FT_FLIP_FIFO   = 8,  /* instant: the RSX reached a flip, a = buffer            */
+    PS3_FT_FLIP_REQ    = 9,  /* instant: the guest asked for a flip, a = buffer        */
+    PS3_FT_PRESENT     = 10, /* the host presented a guest frame                       */
+    PS3_FT_GPU_ENCODE  = 11, /* Metal: CPU encode of the recorded draws, a = 1 present / 0 flush, b = records */
+    PS3_FT_GPU_WAIT    = 12, /* Metal: CPU waits for the GPU, a = 1 present / 0 flush / 2 in-flight bound, b = flush reason */
+    PS3_FT_READBACK    = 13, /* Metal: render target read back to the CPU, a = w, b = h */
+    PS3_FT_GPU_EXEC    = 14, /* Metal: a command buffer's own GPU time, ending when the CPU saw it
+                              * complete; who = render passes, a = depth resolves | colour copies << 16,
+                              * b = 1 present / 0 flush */
+    PS3_FT_TOGGLE      = 15, /* instant: PS3_TOGGLE_FILE changed a knob (ps3_toggles.h); who = knob id
+                              * (64 + n: the n-th name that is not a built-in knob), a = old value,
+                              * b = new value (a string knob: a hash of its text) */
+    PS3_FT_COMPILE     = 16, /* RSX thread built a shader or pipeline on first use: who = 0 the
+                              * engine's whole pipeline miss (decompile + backend), 1 vertex /
+                              * 2 fragment function (HLSL -> MSL -> Metal library), 3 Metal
+                              * pipeline state, 4 the HLSL -> MSL translation alone (inside 1/2);
+                              * a = 1 built / 0 failed */
+    PS3_FT_TEXUP       = 17, /* RSX thread decoded + uploaded a guest texture: a = source KB,
+                              * b = 0 new, 1 content changed; | 2 when it evicted another */
+};
+
+#if defined(_MSC_VER)
+#  define PS3_FT_SHARED __declspec(selectany)
+#else
+#  define PS3_FT_SHARED __attribute__((weak))
+#endif
+
+typedef struct { uint64_t t0, t1; uint32_t a, b, who, kind; } ps3_ft_rec;
+
+enum { PS3_FT_TIDS = 256 };
+
+typedef struct {
+    int on;              /* 0 unknown, 1 initialising, 2 recording, 3 off/done */
+    int dumped;
+    uint32_t n, cap, dropped;
+    uint64_t base, start, end, min, merge;
+    uint32_t kinds;      /* bit k: keep spans of kind k (PS3_FTRACE_KINDS) */
+    ps3_ft_rec* buf;
+    char path[1024];
+    struct { uint64_t t0, t1; uint32_t lr, n; } us[PS3_FT_TIDS];   /* usleep run being merged */
+    char names[PS3_FT_TIDS][28];
+} ps3_ft_state;
+
+PS3_FT_SHARED ps3_ft_state g_ps3_ft = { 0 };
+
+static inline uint64_t ps3_ft_now(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER c, f;
+    QueryPerformanceCounter(&c); QueryPerformanceFrequency(&f);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+#endif
+}
+
+static inline void ps3_ft_dump(void)
+{
+    ps3_ft_state* s = &g_ps3_ft;
+    if (__atomic_exchange_n(&s->dumped, 1, __ATOMIC_ACQ_REL)) return;
+    __atomic_store_n(&s->on, 3, __ATOMIC_RELEASE);
+    /* Close the open usleep runs; their threads may still be in them. */
+    for (uint32_t t = 0; t < PS3_FT_TIDS; t++) {
+        if (!s->us[t].n) continue;
+        const uint32_t i = __atomic_fetch_add(&s->n, 1, __ATOMIC_RELAXED);
+        if (i >= s->cap) break;
+        ps3_ft_rec r = { s->us[t].t0, s->us[t].t1, s->us[t].n, s->us[t].lr, t, PS3_FT_USLEEP };
+        s->buf[i] = r;
+    }
+    uint32_t n = __atomic_load_n(&s->n, __ATOMIC_ACQUIRE);
+    if (n > s->cap) n = s->cap;
+    FILE* f = fopen(s->path, "w");
+    if (!f) { fprintf(stderr, "[ftrace] cannot write %s\n", s->path); return; }
+    fprintf(f, "# ps3_ftrace start_us=%.3f end_us=%.3f spans=%u dropped=%u\n",
+            (double)(s->start - s->base) / 1e3, (double)(s->end - s->base) / 1e3, n, s->dropped);
+    for (uint32_t t = 0; t < PS3_FT_TIDS; t++)
+        if (s->names[t][0]) fprintf(f, "T %u %s\n", t, s->names[t]);
+    for (uint32_t i = 0; i < n; i++) {
+        const ps3_ft_rec* r = &s->buf[i];
+        if (!r->kind) continue;   /* claimed but never filled: a writer raced the dump */
+        fprintf(f, "%u %u %x %x %.3f %.3f\n", r->kind, r->who, r->a, r->b,
+                (double)(r->t0 - s->base) / 1e3, (double)(r->t1 - s->base) / 1e3);
+    }
+    fclose(f);
+    fprintf(stderr, "[ftrace] wrote %u spans (%u dropped) to %s\n", n, s->dropped, s->path);
+}
+
+static inline void ps3_ft_dump_atexit(void) { ps3_ft_dump(); }
+
+/* First hook: read PS3_FTRACE once. Hooks see "off" while another thread is
+ * still setting up, which only loses spans before the window anyway. */
+static inline int ps3_ft_init(void)
+{
+    ps3_ft_state* s = &g_ps3_ft;
+    int expect = 0;
+    if (!__atomic_compare_exchange_n(&s->on, &expect, 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+        return expect == 2;
+    int on = 3;
+    const char* e = getenv("PS3_FTRACE");
+    double start = 0, secs = 0;
+    int used = 0;
+    if (e && *e) {
+        if (sscanf(e, "%lf:%lf:%n", &start, &secs, &used) < 2 || !used || secs <= 0) {
+            fprintf(stderr, "[ftrace] PS3_FTRACE=<start s>:<seconds>:<path>, got '%s'\n", e);
+        } else {
+            snprintf(s->path, sizeof s->path, "%s", e + used);
+            const char* m = getenv("PS3_FTRACE_MIN_US");
+            s->min = (m ? strtoull(m, 0, 10) : 20ull) * 1000ull;
+            const char* g = getenv("PS3_FTRACE_MERGE_US");
+            s->merge = (g ? strtoull(g, 0, 10) : 300ull) * 1000ull;
+            const char* kl = getenv("PS3_FTRACE_KINDS");
+            s->kinds = 0xFFFFFFFFu;
+            if (kl && *kl) {
+                s->kinds = 0;
+                for (const char* q = kl; *q;) {
+                    char* qe; const long k = strtol(q, &qe, 10);
+                    if (qe == q) break;
+                    if (k >= 0 && k < 32) s->kinds |= 1u << k;
+                    q = *qe == ',' ? qe + 1 : qe;
+                }
+            }
+            const char* c = getenv("PS3_FTRACE_CAP");
+            s->cap = c ? (uint32_t)strtoul(c, 0, 10) : 4u << 20;
+            s->buf = (ps3_ft_rec*)calloc(s->cap, sizeof(ps3_ft_rec));
+            if (!s->buf) {
+                fprintf(stderr, "[ftrace] no memory for %u spans\n", s->cap);
+            } else {
+                s->base = ps3_ft_now();
+                s->start = s->base + (uint64_t)(start * 1e9);
+                s->end = s->start + (uint64_t)(secs * 1e9);
+                atexit(ps3_ft_dump_atexit);
+                fprintf(stderr, "[ftrace] recording %.1f s from t=%.1f s into %s\n", secs, start, s->path);
+                on = 2;
+            }
+        }
+    }
+    __atomic_store_n(&s->on, on, __ATOMIC_RELEASE);
+    return on == 2;
+}
+
+/* The hook guard: one load when off. */
+static inline int ps3_ft_on(void)
+{
+    const int on = __atomic_load_n(&g_ps3_ft.on, __ATOMIC_RELAXED);
+    if (__builtin_expect(on == 2, 0)) return 1;
+    if (__builtin_expect(on != 0, 1)) return 0;
+    return ps3_ft_init();
+}
+#define PS3_FT_ON() ps3_ft_on()
+
+static inline uint64_t ps3_ft_min_ns(void) { return g_ps3_ft.min; }
+
+static inline void ps3_ft_span(int kind, uint32_t who, uint32_t a, uint32_t b,
+                               uint64_t t0, uint64_t t1)
+{
+    ps3_ft_state* s = &g_ps3_ft;
+    if (__atomic_load_n(&s->on, __ATOMIC_RELAXED) != 2) return;
+    if (t1 < s->start) return;
+    if (t0 > s->end) { ps3_ft_dump(); return; }
+    if (!(s->kinds >> (kind & 31) & 1u)) return;
+    const uint32_t i = __atomic_fetch_add(&s->n, 1, __ATOMIC_RELAXED);
+    if (i >= s->cap) { __atomic_fetch_add(&s->dropped, 1, __ATOMIC_RELAXED); return; }
+    ps3_ft_rec r = { t0, t1, a, b, who, (uint32_t)kind };
+    s->buf[i] = r;
+}
+
+/* sys_timer_usleep polls come tens of thousands a second; consecutive sleeps of
+ * one thread from one call site within PS3_FTRACE_MERGE_US become one span.
+ * Only the sleeping thread touches its slot. */
+static inline void ps3_ft_usleep(uint32_t tid, uint32_t lr, uint64_t t0, uint64_t t1)
+{
+    ps3_ft_state* s = &g_ps3_ft;
+    if (tid >= PS3_FT_TIDS || __atomic_load_n(&s->on, __ATOMIC_RELAXED) != 2) return;
+    if (s->us[tid].n && s->us[tid].lr == lr && t0 - s->us[tid].t1 <= s->merge) {
+        s->us[tid].t1 = t1; s->us[tid].n++;
+        return;
+    }
+    if (s->us[tid].n)
+        ps3_ft_span(PS3_FT_USLEEP, tid, s->us[tid].n, s->us[tid].lr, s->us[tid].t0, s->us[tid].t1);
+    s->us[tid].t0 = t0; s->us[tid].t1 = t1; s->us[tid].lr = lr; s->us[tid].n = 1;
+}
+
+/* A PPU thread's name, for the report's labels. */
+static inline void ps3_ft_name(uint32_t tid, const char* name)
+{
+    if (tid >= PS3_FT_TIDS || !name || !PS3_FT_ON()) return;
+    snprintf(g_ps3_ft.names[tid], sizeof g_ps3_ft.names[tid], "%s", name);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
