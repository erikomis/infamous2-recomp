+
+/* ---- the atlas ------------------------------------------------------------ */
+
+#define ATLAS_W 512u
+#define ATLAS_H 256u
+
+enum { K_FACE, K_SHOULDER, K_STICK_CLICK, K_STICK, K_DPAD_DIR, K_DPAD_ALL, K_STARTSEL };
