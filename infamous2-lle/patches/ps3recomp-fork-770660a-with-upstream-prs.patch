+"    return floor(ssao_mul_rz(num, ssao_recip(den))) / 255.0f;\n"
+"}\n"
+"fragment float ssao_blur_h_fs(BOut i [[stage_in]], texture2d<float> ao [[texture(0)]],\n"
+"                              texture2d<float> hd [[texture(1)]], constant SsaoC& c [[buffer(0)]]) {\n"
