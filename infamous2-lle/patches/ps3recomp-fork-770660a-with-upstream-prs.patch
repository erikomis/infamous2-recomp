+                    (pass == 1 && [n caseInsensitiveCompare:want] == NSOrderedSame) ||
+                    (pass == 2 && [n rangeOfString:want options:NSCaseInsensitiveSearch].location != NSNotFound)) {
+                    *why = "PS3_DISPLAY";
+                    return sc;
