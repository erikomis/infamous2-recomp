+}
+/* port_status[port] from cellPadGetInfo2 (guest big-endian). */
+static u32 info_status(u32 port)
+{
+    const uint32_t ea = 0x1000;
+    assert(cellPadGetInfo2((CellPadInfo2*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 12 + port * 4;
+    return (u32)b[0] << 24 | (u32)b[1] << 16 | (u32)b[2] << 8 | b[3];
+}
+/* DIGITAL2 of cellPadGetData(port) (0 if it reported nothing new). */
+static unsigned data_digital2(u32 port)
+{
+    const uint32_t ea = 0x2000;
+    usleep((PAD_POLL_INTERVAL_MS + 2) * 1000);
+    assert(cellPadGetData(port, (CellPadData*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 4 + CELL_PAD_BTN_OFFSET_DIGITAL2 * 2;
+    return (unsigned)b[0] << 8 | b[1];
+}
+static unsigned data_digital1(u32 port)
+{
+    const uint32_t ea = 0x2000;
+    usleep((PAD_POLL_INTERVAL_MS + 2) * 1000);
+    assert(cellPadGetData(port, (CellPadData*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 4 + CELL_PAD_BTN_OFFSET_DIGITAL1 * 2;
+    return (unsigned)b[0] << 8 | b[1];
+}
+#define CROSS_BIT  0x40u   /* in DIGITAL2 */
+#define CIRCLE_BIT 0x20u
+
+/* ---- the tests -------------------------------------------------------------- */
+int main(void)
+{
+    unsetenv("PS3_PAD_SDL");
+    unsetenv("PS3_INPUT_MAP");
+    unsetenv("PS3_INPUT_MODE");
+    unsetenv("PS3_RUMBLE");
+    unsetenv("PS3_RUMBLE_STRENGTH");
+    vm_base = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+
+    /* A DualSense is on at start: port 0. */
+    FakePad* a = fake_new(1, 0xA5);
+    assert(cellPadInit(4) == CELL_OK);
+    assert(a->opens == 1 && s_sdl_controllers[0] == (SDL_GameController*)a);
+    assert(info_status(0) == CELL_PAD_STATUS_CONNECTED);   /* what is there at start: no change flag */
+    a->buttons = 1u << SDL_CONTROLLER_BUTTON_A;
+    assert(data_digital2(0) & CROSS_BIT);
+    a->buttons = 0;
+
+    /* The title asks for rumble: it reaches the controller. */
+    CellPadActParam* act = (CellPadActParam*)(vm_base + 0x3000);
+    act->motor[CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+    act->motor[CELL_PAD_ACTUATOR_PARAM_LARGE] = 255;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)0x3000) == CELL_OK);
+    assert(a->rumble_lo == 65535 && a->rumble_hi == 65535);
+
+    /* Switched off: SDL drops it (and says so with an event). */
+    a->present = 0;
+    fake_event(SDL_CONTROLLERDEVICEREMOVED);
+    fake_event(SDL_JOYDEVICEREMOVED);
+    poll_once();
+    assert(a->closed && s_sdl_controllers[0] == NULL && s_sdl_ids[0] == -1);
+    assert(s_rumble[0].lo == 0 && s_rumble[0].hi == 0 && s_rumble[0].sent_ms == 0);
+    assert(info_status(0) == CELL_PAD_STATUS_CONNECTED);   /* port 0 is the virtual pad: still there */
+    assert(s_nevents == 0);                                 /* the events were drained */
+
+    /* Switched on again: the same pad, a new instance id. Port 0 again, motors
+     * off, nothing of the old rumble renewed. */
+    FakePad* a2 = fake_new(7, 0xA5);
+    fake_event(SDL_JOYDEVICEADDED);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(a2->opens == 1 && s_sdl_controllers[0] == (SDL_GameController*)a2 && s_sdl_ids[0] == 7);
+    assert(a2->rumble_calls == 1 && a2->rumble_lo == 0 && a2->rumble_hi == 0);
+    assert(g_ps3_pad_icons.connected == 1 + SDL_CONTROLLER_TYPE_PS5);   /* the prompt glyphs see it */
+    a2->buttons = 1u << SDL_CONTROLLER_BUTTON_A;
+    assert(data_digital2(0) & CROSS_BIT);                   /* it plays again */
+    assert(g_ps3_pad_icons.source == 1 + SDL_CONTROLLER_TYPE_PS5);      /* ... and that it was used */
+    a2->buttons = 0;
+    usleep((PAD_RUMBLE_RENEW_MS + 50) * 1000);
+    poll_once();
+    assert(a2->rumble_calls == 1);                          /* no old rumble came back */
+
+    /* A second controller with no event (someone else drained the queue):
+     * found by the periodic rescan, on port 1, flagged once. */
+    FakePad* b = fake_new(9, 0xB6);
+    poll_once();
+    if (!s_sdl_controllers[1]) { usleep((PAD_SDL_RESCAN_MS + 50) * 1000); poll_once(); }
+    assert(b->opens == 1 && s_sdl_controllers[1] == (SDL_GameController*)b);
+    assert(a2->opens == 1);                                 /* the open one is not opened twice */
+    assert(info_status(1) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES));
+    assert(info_status(1) == CELL_PAD_STATUS_CONNECTED);
+    b->buttons = 1u << SDL_CONTROLLER_BUTTON_B;
+    assert(data_digital2(1) & CIRCLE_BIT);
+    b->buttons = 0;
+
+    /* Both go off; the second one comes back first: it gets port 1 back, the
+     * port its GUID had, not the lowest free one. */
+    a2->present = 0; b->present = 0;
+    fake_event(SDL_CONTROLLERDEVICEREMOVED);
+    poll_once();
+    assert(!s_sdl_controllers[0] && !s_sdl_controllers[1]);
+    assert(info_status(1) == (CELL_PAD_STATUS_DISCONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES));
+    assert(info_status(1) == CELL_PAD_STATUS_DISCONNECTED);
+    FakePad* b2 = fake_new(11, 0xB6);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(s_sdl_controllers[1] == (SDL_GameController*)b2 && !s_sdl_controllers[0]);
+    FakePad* a3 = fake_new(12, 0xA5);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(s_sdl_controllers[0] == (SDL_GameController*)a3);
+
+    /* A new pad with no history takes the lowest free port. */
+    FakePad* c = fake_new(13, 0xC7);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(s_sdl_controllers[2] == (SDL_GameController*)c);
+
+    /* The live map: the menu binds Circle (SDL "b") to Cross; it applies to
+     * the reconnected pad at once. */
+    PadInputMap m;
+    cellPad_host_input_map(&m);
+    pim_rebind(&m, PIM_SEC_CONTROLLER, PIM_CROSS, 1);
+    cellPad_host_set_input_map(&m);
+    a3->buttons = 1u << SDL_CONTROLLER_BUTTON_B;
+    { const unsigned d2 = data_digital2(0);
+      assert((d2 & CROSS_BIT) && !(d2 & CIRCLE_BIT)); }      /* b left circle: it was moved */
+    assert(g_pad_overlay_raw & (1u << SDL_CONTROLLER_BUTTON_B)); /* the menu sees the raw button */
+
+    /* Input mode: keyboard and mouse only hides the controllers from the
+     * title; controller only hides the keys. */
+    cellPad_host_set_input_mode(PAD_MODE_KEYBOARD);
+    assert(!(data_digital2(0) & CROSS_BIT));
+    cellPad_host_set_input_mode(PAD_MODE_CONTROLLER);
+    a3->buttons = 0;
+    g_pad_host_keys[0x31 >> 5] |= 1u << (0x31 & 31);        /* Space: Cross on the keyboard */
+    assert(!(data_digital2(0) & CROSS_BIT));
+    cellPad_host_set_input_mode(PAD_MODE_BOTH);
+    assert(data_digital2(0) & CROSS_BIT);
+    g_pad_host_keys[0x31 >> 5] = 0;
+    (void)data_digital1;
+
+    assert(cellPadEnd() == CELL_OK);
+    assert(a3->closed && b2->closed && c->closed);
+    printf("test_pad_hotplug: ok\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_input_map.c b/libs/input/tests/test_pad_input_map.c
new file mode 100644
index 0000000..c9c6116
--- /dev/null
+++ b/libs/input/tests/test_pad_input_map.c
@@ -0,0 +1,337 @@
+/* The PS3_INPUT_MAP parser (pad_input_map.h): defaults, rebinding, the value
+ * forms, the [mouse] settings and unknown names.
+ *
+ *   cc -std=gnu17 -Wall -Wextra libs/input/tests/test_pad_input_map.c \
+ *      -o /tmp/test_pad_input_map && /tmp/test_pad_input_map
+ */
+#include "../pad_input_map.h"
+#include <assert.h>
+#include <unistd.h>
+
+static int key_of(const PadInputMap* m, int ctl, unsigned vk)
+{
+    return (m->key[ctl][vk >> 5] >> (vk & 31)) & 1;
+}
+
+static int n_keys(const PadInputMap* m, int ctl)
+{
+    int n = 0;
+    for (unsigned vk = 0; vk < 128; vk++) n += key_of(m, ctl, vk);
+    return n;
+}
+
+/* The defaults are the layout cellPad.c hard-coded before the file. */
+static void test_defaults(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    static const struct { int ctl; unsigned vk; } old[] = {
+        {PIM_UP, 0x7E}, {PIM_DOWN, 0x7D}, {PIM_LEFT, 0x7B}, {PIM_RIGHT, 0x7C},
+        {PIM_CROSS, 0x31}, {PIM_CIRCLE, 0x0C}, {PIM_SQUARE, 0x0E}, {PIM_TRIANGLE, 0x0F},
+        {PIM_L1, 0x20}, {PIM_R1, 0x1F}, {PIM_L2, 0x10}, {PIM_R2, 0x23},
+        {PIM_L3, 0x05}, {PIM_R3, 0x04}, {PIM_START, 0x24}, {PIM_START, 0x4C},
+        {PIM_SELECT, 0x30},
+        {PIM_LS_RIGHT, 0x02}, {PIM_LS_LEFT, 0x00}, {PIM_LS_DOWN, 0x01}, {PIM_LS_UP, 0x0D},
+        {PIM_RS_RIGHT, 0x25}, {PIM_RS_LEFT, 0x26}, {PIM_RS_DOWN, 0x28}, {PIM_RS_UP, 0x22},
+    };
+    int total = 0;
+    for (unsigned i = 0; i < sizeof old / sizeof old[0]; i++) assert(key_of(&m, old[i].ctl, old[i].vk));
+    for (int c = 0; c < PIM_N_CONTROLS; c++) total += n_keys(&m, c);
+    assert(total == (int)(sizeof old / sizeof old[0]));   /* nothing else bound */
+    assert(m.mouse[PIM_R1] == 1 && m.mouse[PIM_R2] == 2 && m.mouse[PIM_L1] == 0xFC);   /* middle, 4-8 */
+    for (int c = 0; c < PIM_N_CONTROLS; c++)
+        if (c != PIM_R1 && c != PIM_R2 && c != PIM_L1) assert(m.mouse[c] == 0);
+    /* controller: each SDL button its namesake, triggers L2/R2, sticks unbound */
+    assert(m.pad[PIM_CROSS] == 1u << 0 && m.pad[PIM_CIRCLE] == 1u << 1);
+    assert(m.pad[PIM_SQUARE] == 1u << 2 && m.pad[PIM_TRIANGLE] == 1u << 3);
+    assert(m.pad[PIM_SELECT] == 1u << 4 && m.pad[PIM_START] == 1u << 6);
+    assert(m.pad[PIM_L3] == 1u << 7 && m.pad[PIM_R3] == 1u << 8);
+    assert(m.pad[PIM_L1] == 1u << 9 && m.pad[PIM_R1] == 1u << 10);
+    assert(m.pad[PIM_UP] == 1u << 11 && m.pad[PIM_DOWN] == 1u << 12);
+    assert(m.pad[PIM_LEFT] == 1u << 13 && m.pad[PIM_RIGHT] == 1u << 14);
+    assert(m.pad[PIM_L2] == 1u << PIM_PAD_TRIGGER_LEFT && m.pad[PIM_R2] == 1u << PIM_PAD_TRIGGER_RIGHT);
+    for (int c = PIM_LS_UP; c < PIM_N_CONTROLS; c++) assert(m.pad[c] == 0);
+    assert(m.mouse_camera == -1 && m.mouse_sens == 0.0f && m.mouse_deadzone == -1);
+    assert(m.n_set == 0 && m.n_warnings == 0);
+}
+
+static void test_empty_and_comments(void)
+{
+    PadInputMap a, b;
+    pim_defaults(&a);
+    pim_defaults(&b);
+    assert(pim_parse(&b, "", NULL, "t") == 0);
+    assert(pim_parse(&b, "# only a comment\n\n   ; another\n[keyboard]\n", NULL, "t") == 0);
+    assert(!memcmp(&a, &b, sizeof a));
+}
+
+static void test_rebind(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    const char* text =
+        "# a remap\r\n"
+        "[Keyboard]\r\n"
+        "cross = \"F\"            # one key\r\n"
+        "start = 'Return, Escape'\r\n"
+        "select = [\"Tab\", \"backspace\"]\r\n"
+        "L3 = \"\"\r\n"
+        "r3 = none\r\n"
+        "ls_up = Up\r\n"
+        "circle = \"Shift, RightOption, 0x0A\"\r\n"
+        "[mouse_buttons]\n"
+        "r1 = \"Right\"\n"
+        "r2 = \"Left\"\n"
+        "up = \"WheelUp\"\n"
+        "down = \"wheeldown, Button4\"\n"
+        "l1 = \"\"\n"
+        "[controller]\n"
+        "cross = \"b\"\n"
+        "circle = \"cross\"\n"
+        "select = \"touchpad, back\"\n"
+        "r1 = \"righttrigger\"\n"
+        "r2 = \"rightshoulder\"\n"
+        "rs_up = \"paddle1\"\n";
+    assert(pim_parse(&m, text, stderr, "rebind") == 0);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x03));
+    assert(n_keys(&m, PIM_START) == 2 && key_of(&m, PIM_START, 0x24) && key_of(&m, PIM_START, 0x35));
+    assert(n_keys(&m, PIM_SELECT) == 2 && key_of(&m, PIM_SELECT, 0x30) && key_of(&m, PIM_SELECT, 0x33));
+    assert(n_keys(&m, PIM_L3) == 0 && n_keys(&m, PIM_R3) == 0);
+    assert(n_keys(&m, PIM_LS_UP) == 1 && key_of(&m, PIM_LS_UP, 0x7E));
+    assert(n_keys(&m, PIM_UP) == 0);                     /* Up left the D-pad, which the file does not mention */
+    assert(n_keys(&m, PIM_CIRCLE) == 3 && key_of(&m, PIM_CIRCLE, 0x38) &&
+           key_of(&m, PIM_CIRCLE, 0x3D) && key_of(&m, PIM_CIRCLE, 0x0A));
+    assert(key_of(&m, PIM_SQUARE, 0x0E));                /* untouched controls keep their defaults */
+    assert(m.mouse[PIM_R1] == 2 && m.mouse[PIM_R2] == 1 && m.mouse[PIM_L1] == 0);
+    assert(m.mouse[PIM_UP] == PIM_MOUSE_WHEEL_UP);
+    assert(m.mouse[PIM_DOWN] == (PIM_MOUSE_WHEEL_DOWN | 8u));
+    assert(m.pad[PIM_CROSS] == 1u << 1 && m.pad[PIM_CIRCLE] == 1u << 0);
+    assert(m.pad[PIM_SELECT] == ((1u << 20) | (1u << 4)));
+    assert(m.pad[PIM_R1] == 1u << PIM_PAD_TRIGGER_RIGHT && m.pad[PIM_R2] == 1u << 10);
+    assert(m.pad[PIM_RS_UP] == 1u << 16);
+    assert(m.pad[PIM_SQUARE] == 1u << 2);
+    assert(m.n_set == 18);
+}
+
+/* Bound here = gone from the controls the text does not mention; listed
+ * twice = kept twice. */
+static void test_steal_and_overlap(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[keyboard]\ncross = \"Q\"\n[mouse_buttons]\nr2 = \"Button4\"\n", NULL, "s") == 0);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && n_keys(&m, PIM_CIRCLE) == 0);
+    assert(m.mouse[PIM_R2] == 8 && m.mouse[PIM_L1] == (0xFCu & ~8u));
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[keyboard]\ncross = \"Q\"\ncircle = \"Q\"\n", NULL, "o") == 0);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && key_of(&m, PIM_CIRCLE, 0x0C));
+}
+
+static void test_mouse_settings(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[mouse]\ncamera = false\nsensitivity = 1.75\ninvert_x = yes\n"
+                         "invert_y = true\ndeadzone = 500\ncapture = off\n", stderr, "mouse") == 0);
+    assert(m.mouse_camera == 0 && m.mouse_invert_x == 1 && m.mouse_invert_y == 1);
+    assert(m.mouse_sens > 1.74f && m.mouse_sens < 1.76f);
+    assert(m.mouse_deadzone == 120);                     /* clamped */
+    assert(m.mouse_capture == 0);
+    /* bad values leave the setting alone */
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[mouse]\nsensitivity = fast\ndeadzone = -4\ninvert_y = maybe\n", NULL, "m") == 2);
+    assert(m.mouse_sens == 0.0f && m.mouse_deadzone == 0 && m.mouse_invert_y == -1);
+}
+
+static void test_unknown_names(void)
+{
+    PadInputMap m, d;
+    pim_defaults(&m);
+    pim_defaults(&d);
+    FILE* err = tmpfile();
+    assert(err);
+    const int n = pim_parse(&m,
+        "stray = 1\n"
+        "[keyboard]\n"
+        "cross = \"Space, Hyper\"\n"      /* Hyper unknown: Space still bound */
+        "jump = \"J\"\n"                  /* not a PS3 control */
+        "[joystick]\n"                    /* unknown section: its lines are skipped */
+        "cross = \"q\"\n"
+        "[mouse_buttons]\n"
+        "r1 = \"Button9\"\n"
+        "[controller]\n"
+        "cross = \"south\"\n"
+        "[mouse]\n"
+        "speed = 3\n"
+        "[keyboard]\n"
+        "this line has no equals sign\n",
+        err, "bad.toml");
+    assert(n == 8);
+    assert(m.n_warnings == 8);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x31));
+    assert(m.mouse[PIM_R1] == 0);                        /* the line still rebinds, to nothing known */
+    assert(m.pad[PIM_CROSS] == 0);
+    assert(n_keys(&m, PIM_CIRCLE) == n_keys(&d, PIM_CIRCLE));
+    rewind(err);
+    char buf[2048]; size_t r = fread(buf, 1, sizeof buf - 1, err); buf[r] = 0;
+    fclose(err);
+    assert(strstr(buf, "bad.toml:1: unknown setting outside a section 'stray'"));
+    assert(strstr(buf, "bad.toml:3: unknown key 'hyper'"));
+    assert(strstr(buf, "bad.toml:4: unknown PS3 control 'jump'"));
+    assert(strstr(buf, "bad.toml:5: unknown section 'joystick'"));
+    assert(strstr(buf, "bad.toml:8: unknown mouse button 'button9'"));
+    assert(strstr(buf, "bad.toml:10: unknown controller input 'south'"));
+    assert(strstr(buf, "bad.toml:12: unknown mouse setting 'speed'"));
+    assert(strstr(buf, "bad.toml:14: unknown line"));
+}
+
+static void test_load_file(void)
+{
+    PadInputMap m;
+    assert(pim_load_file(&m, "/nonexistent/input.toml", NULL) == 0);
+    PadInputMap d;
+    pim_defaults(&d);
+    assert(!memcmp(&m, &d, sizeof m));                   /* missing file = defaults */
+
+    char path[] = "/tmp/pim_testXXXXXX";
+    int fd = mkstemp(path);
+    assert(fd >= 0);
+    FILE* f = fdopen(fd, "w");
+    /* a long file: the reader grows its buffer past the first 4 KB */
+    for (int i = 0; i < 300; i++) fprintf(f, "# padding line %03d ...........................\n", i);
+    fprintf(f, "[keyboard]\ncross = \"Z\"\n");
+    fclose(f);
+    assert(pim_load_file(&m, path, stderr) == 1);
+    remove(path);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x06));
+}
+
+static void test_keys_hit(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    uint32_t keys[4] = {0, 0, 0, 0};
+    keys[0x4C >> 5] |= 1u << (0x4C & 31);                /* keypad Enter */
+    assert(pim_keys_hit(&m, PIM_START, keys));
+    assert(!pim_keys_hit(&m, PIM_SELECT, keys));
+}
+
+/* Writing (the in-game menu): every canonical name reads back as itself,
+ * a written map reads back the same, the other sections stay, and saving
+ * again changes nothing. */
+static int maps_equal(const PadInputMap* a, const PadInputMap* b)
+{
+    return !memcmp(a->key, b->key, sizeof a->key) && !memcmp(a->mouse, b->mouse, sizeof a->mouse) &&
+           !memcmp(a->pad, b->pad, sizeof a->pad);
+}
+
+static void test_names_round_trip(void)
+{
+    char tmp[8], low[32];
+    for (unsigned vk = 0; vk < 128; vk++) {
+        const char* n = pim_key_label(vk, tmp, sizeof tmp);
+        snprintf(low, sizeof low, "%s", n);
+        pim_lower(low);
+        assert(pim_parse_key_name(low) == (int)vk);
+    }
+    for (int b = 0; b < 32; b++) {
+        const char* n = pim_mouse_label(1u << b);
+        if (!n) continue;
+        snprintf(low, sizeof low, "%s", n); pim_lower(low);
+        assert(pim_lookup(pim_mouse_buttons, PIM_COUNT(pim_mouse_buttons), low) == (int)(1u << b));
+    }
+    for (int b = 0; b <= PIM_PAD_TRIGGER_RIGHT; b++) {
+        const char* n = pim_pad_label(b);
+        assert(n);
+        assert(pim_lookup(pim_pad_inputs, PIM_COUNT(pim_pad_inputs), n) == b);
+    }
+    /* the launcher's spelling */
+    assert(!strcmp(pim_key_label(0x31, tmp, sizeof tmp), "Space"));
+    assert(!strcmp(pim_key_label(0x4C, tmp, sizeof tmp), "KeypadEnter"));
+    assert(!strcmp(pim_key_label(0x34, tmp, sizeof tmp), "0x34"));   /* no name */
+    assert(!strcmp(pim_pad_label(PIM_PAD_TRIGGER_LEFT), "lefttrigger"));
+}
+
+static void test_render_round_trip(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    char list[256];
+    pim_inputs_text(&m, PIM_SEC_KEYBOARD, PIM_START, list, sizeof list);
+    assert(!strcmp(list, "Return, KeypadEnter"));
+    pim_inputs_text(&m, PIM_SEC_MOUSE_BUTTONS, PIM_L1, list, sizeof list);
+    assert(!strcmp(list, "Middle, Button4, Button5, Button6, Button7, Button8"));
+    pim_inputs_text(&m, PIM_SEC_CONTROLLER, PIM_CROSS, list, sizeof list);
+    assert(!strcmp(list, "a"));
+    pim_inputs_text(&m, PIM_SEC_CONTROLLER, PIM_LS_UP, list, sizeof list);
+    assert(!strcmp(list, ""));
+
+    /* the menu moves Q from Circle to Cross and puts R2 on the wheel */
+    assert(pim_rebind(&m, PIM_SEC_KEYBOARD, PIM_CROSS, 0x0C) == 1u << PIM_CIRCLE);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && n_keys(&m, PIM_CROSS) == 1 && n_keys(&m, PIM_CIRCLE) == 0);
+    assert(pim_rebind(&m, PIM_SEC_MOUSE_BUTTONS, PIM_R2, PIM_MOUSE_WHEEL_DOWN) == 0);
+    assert(m.mouse[PIM_R2] == PIM_MOUSE_WHEEL_DOWN);
+    assert(pim_rebind(&m, PIM_SEC_CONTROLLER, PIM_R1, PIM_PAD_TRIGGER_RIGHT) == 1u << PIM_R2);
+    pim_unbind(&m, PIM_SEC_CONTROLLER, PIM_SELECT);
+
+    const char* old =
+        "# hand-written\n"
+        "[keyboard]\n"
+        "cross = \"F\"\n"
+        "\n"
+        "[mouse]\n"
+        "sensitivity = 1.5   # fast\n"
+        "invert_y = true\n"
+        "\n"
+        "[controller]\n"
+        "cross = \"b\"\n"
+        "[future]\n"
+        "x = 1\n";
+    char* text = pim_render(&m, old);
+    assert(text);
+    assert(strstr(text, "\n[keyboard]\ncross    = \"Q\"\ncircle   = \"\"\n"));
+    assert(strstr(text, "start    = \"Return, KeypadEnter\"\n"));
+    assert(strstr(text, "\n[mouse]\nsensitivity = 1.5   # fast\ninvert_y = true\n"));
+    assert(strstr(text, "\n[future]\nx = 1\n"));
+    assert(!strstr(text, "hand-written"));          /* the preamble is the writer's own */
+    assert(!strstr(text, "cross = \"b\""));         /* the old bindings are gone */
+    PadInputMap back;
+    pim_defaults(&back);
+    assert(pim_parse(&back, text, NULL, "rendered") == 1);   /* [future]: unknown to the game too */
+    assert(maps_equal(&m, &back));
+    assert(back.mouse_sens == 1.5f && back.mouse_invert_y == 1);
+    /* saving again changes nothing */
+    char* again = pim_render(&back, text);
+    assert(again && !strcmp(again, text));
+    free(again);
+    free(text);
+
+    /* through a file, into a folder that does not exist yet */
+    char dir[] = "/tmp/pim_save_XXXXXX";
+    assert(mkdtemp(dir));
+    char path[256];
+    snprintf(path, sizeof path, "%s/sub/input.toml", dir);
+    assert(pim_save_file(&m, path));
+    PadInputMap loaded;
+    assert(pim_load_file(&loaded, path, stderr));
+    assert(maps_equal(&m, &loaded) && loaded.n_warnings == 0);
+    remove(path);
+    snprintf(path, sizeof path, "%s/sub", dir); rmdir(path);
+    rmdir(dir);
+}
+
+int main(void)
+{
+    test_defaults();
+    test_empty_and_comments();
+    test_rebind();
+    test_steal_and_overlap();
+    test_mouse_settings();
+    test_unknown_names();
+    test_load_file();
+    test_keys_hit();
+    test_names_round_trip();
+    test_render_round_trip();
+    printf("test_pad_input_map: ok\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_keymap.c b/libs/input/tests/test_pad_keymap.c
new file mode 100644
index 0000000..114a032
--- /dev/null
+++ b/libs/input/tests/test_pad_keymap.c
@@ -0,0 +1,169 @@
+/* cellPad's keyboard/mouse pad with PS3_INPUT_MAP: with no file every key
+ * does exactly what the hard-coded table did; with one, the keys, mouse
+ * buttons, wheel and capture setting follow it.
+ *
+ *   cc -std=gnu17 -I include -isystem /opt/homebrew/include \
+ *      -isystem /opt/homebrew/include/SDL2 libs/input/tests/test_pad_keymap.c \
+ *      -Wl,-dead_strip -o /tmp/test_pad_keymap && /tmp/test_pad_keymap
+ * (SDL's headers only: -dead_strip drops the SDL backend, nothing links SDL.)
+ */
+#include "../cellPad.c"
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+static void press_only(const unsigned* vks, int n)
+{
+    for (int i = 0; i < 4; i++) g_pad_host_keys[i] = 0;
+    for (int i = 0; i < n; i++) g_pad_host_keys[vks[i] >> 5] |= 1u << (vks[i] & 31);
+}
+
+/* What the hard-coded pad_poll_keys produced (before PS3_INPUT_MAP). */
+static void old_layout(const unsigned* vks, int n, u16* btns, int* lx, int* ly, int* rx, int* ry)
+{
+    static const struct { unsigned vk; u16 btn; } map[] = {
+        {0x7E, CELL_PAD_CTRL_UP}, {0x7D, CELL_PAD_CTRL_DOWN},
+        {0x7B, CELL_PAD_CTRL_LEFT}, {0x7C, CELL_PAD_CTRL_RIGHT},
+        {0x31, CELL_PAD_CTRL_CROSS}, {0x0C, CELL_PAD_CTRL_CIRCLE},
+        {0x0E, CELL_PAD_CTRL_SQUARE}, {0x0F, CELL_PAD_CTRL_TRIANGLE},
+        {0x20, CELL_PAD_CTRL_L1}, {0x1F, CELL_PAD_CTRL_R1},
+        {0x10, CELL_PAD_CTRL_L2}, {0x23, CELL_PAD_CTRL_R2},
+        {0x05, CELL_PAD_CTRL_L3}, {0x04, CELL_PAD_CTRL_R3},
+        {0x24, CELL_PAD_CTRL_START}, {0x4C, CELL_PAD_CTRL_START},
+        {0x30, CELL_PAD_CTRL_SELECT},
+    };
+    int down[128] = {0};
+    for (int i = 0; i < n; i++) down[vks[i]] = 1;
+    *btns = 0;
+    for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (down[map[i].vk]) *btns |= map[i].btn;
+    *lx = 128 + (down[0x02] ? 127 : 0) - (down[0x00] ? 128 : 0);
+    *ly = 128 + (down[0x01] ? 127 : 0) - (down[0x0D] ? 128 : 0);
+    *rx = 128 + (down[0x25] ? 127 : 0) - (down[0x26] ? 128 : 0);
+    *ry = 128 + (down[0x28] ? 127 : 0) - (down[0x22] ? 128 : 0);
+}
+
+static void expect_like_old(const unsigned* vks, int n)
+{
+    u16 b; int lx, ly, rx, ry;
+    old_layout(vks, n, &b, &lx, &ly, &rx, &ry);
+    press_only(vks, n);
+    pad_poll_keys(0);
+    const PadHostState* hs = &s_host_state[0];
+    assert(hs->buttons == b);
+    assert(hs->analog_lx == lx && hs->analog_ly == ly && hs->analog_rx == rx && hs->analog_ry == ry);
+    assert(hs->trigger_l2 == ((b & CELL_PAD_CTRL_L2) ? 255 : 0));
+}
+
+static void test_default_layout(void)
+{
+    unsetenv("PS3_INPUT_MAP");
+    s_map_state = 0;
+    pad_map_load();
+    for (unsigned vk = 0; vk < 128; vk++) expect_like_old(&vk, 1);
+    const unsigned combos[][4] = {
+        {0x00, 0x02, 0, 0}, {0x0D, 0x01, 0, 0}, {0x0D, 0x02, 0x31, 0x22},
+        {0x26, 0x25, 0x28, 0x24}, {0x10, 0x23, 0x20, 0x1F},
+    };
+    expect_like_old(combos[0], 2);
+    expect_like_old(combos[1], 2);
+    for (int i = 2; i < 5; i++) expect_like_old(combos[i], 4);
+    press_only(NULL, 0);
+    /* mouse buttons: left R1, right R2, middle and the side buttons L1 */
+    g_pad_mouse_buttons = 1; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R1);
+    g_pad_mouse_buttons = 2; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R2);
+    g_pad_mouse_buttons = 4; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);
+    g_pad_mouse_buttons = 8;  pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);   /* as before: */
+    g_pad_mouse_buttons = 64; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);   /* any other button */
+    g_pad_mouse_buttons = 0;
+    g_pad_mouse_wheel = 64; pad_poll_keys(0); assert(s_host_state[0].buttons == 0);   /* wheel unbound */
+    for (int i = 0; i < 8; i++) { usleep(100 * 1000); pad_poll_keys(0); }   /* let the queued notches pass */
+    assert(cellPad_host_mouse_capture_wanted() == 1);
+}
+
+static void test_mapped_layout(void)
+{
+    char path[] = "/tmp/pad_keymap_XXXXXX";
+    int fd = mkstemp(path);
+    FILE* f = fdopen(fd, "w");
+    fputs("[keyboard]\n"
+          "cross  = \"F, Shift\"\n"
+          "circle = \"\"\n"            /* Q no longer does anything */
+          "ls_up  = \"Up\"\n"          /* the arrow walks forward ... */
+          "up     = \"T\"\n"           /* ... and the D-pad up moved to T */
+          "rs_left = \"Q\"\n"
+          "[mouse_buttons]\n"
+          "r1 = \"Button4\"\n"
+          "up = \"WheelUp\"\n"
+          "[mouse]\n"
+          "capture = false\n", f);
+    fclose(f);
+    setenv("PS3_INPUT_MAP", path, 1);
+    s_map_state = 0;
+    pad_map_load();
+    remove(path);
+
+    unsigned k;
+    k = 0x03; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_CROSS);
+    k = 0x38; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_CROSS);
+    k = 0x31; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == 0);   /* Space unbound now */
+    k = 0x0C; press_only(&k, 1); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_rx == 0);                /* Q: camera left */
+    k = 0x7E; press_only(&k, 1); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_ly == 0);
+    k = 0x11; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    k = 0x0E; press_only(&k, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_SQUARE);
+    press_only(NULL, 0);
+    g_pad_mouse_buttons = 1; pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    g_pad_mouse_buttons = 8; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R1);
+    g_pad_mouse_buttons = 2; pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R2);
+    g_pad_mouse_buttons = 0;
+
+    /* two wheel notches up: two separate presses of UP */
+    g_pad_mouse_wheel = 32;
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    usleep(85 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    usleep(50 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    usleep(130 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    /* a turn down is not bound */
+    g_pad_mouse_wheel = -16;
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+
+    /* capture: the file says no, the variable wins */
+    unsetenv("PS3_MOUSE_CAPTURE");
+    unsetenv("PS3_MOUSE");
+    assert(cellPad_host_mouse_capture_wanted() == 0);
+    setenv("PS3_MOUSE_CAPTURE", "1", 1);
+    assert(cellPad_host_mouse_capture_wanted() == 1);
+    setenv("PS3_MOUSE", "0", 1);
+    assert(cellPad_host_mouse_capture_wanted() == 0);
+}
+
+static void test_sdl_triggers(void)
+{
+    const uint32_t lt = 1u << PIM_PAD_TRIGGER_LEFT, rt = 1u << PIM_PAD_TRIGGER_RIGHT;
+    assert(pad_sdl_analog(lt, 0, 77, 9) == 77);            /* default L2: the left trigger's own value */
+    assert(pad_sdl_analog(lt | rt, 0, 77, 99) == 99);      /* both triggers: the stronger */
+    assert(pad_sdl_analog(1u << 9, 0, 77, 99) == 0);       /* L1 bound, up */
+    assert(pad_sdl_analog(1u << 9, 1u << 9, 0, 0) == 255); /* L1 bound, down */
+}
+
+int main(void)
+{
+    test_default_layout();
+    test_mapped_layout();
+    test_sdl_triggers();
+    printf("test_pad_keymap: ok\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_rumble.c b/libs/input/tests/test_pad_rumble.c
new file mode 100644
index 0000000..6811ff7
--- /dev/null
+++ b/libs/input/tests/test_pad_rumble.c
@@ -0,0 +1,90 @@
+/* cellPadSetActDirect -> host rumble: PS3_RUMBLE / PS3_RUMBLE_STRENGTH, the
+ * motor levels, and the per-port state the pad poll renews.
+ *
+ *   cc -std=gnu17 -I include -isystem /opt/homebrew/include \
+ *      -isystem /opt/homebrew/include/SDL2 libs/input/tests/test_pad_rumble.c \
+ *      -L /opt/homebrew/lib -lSDL2 -o /tmp/test_pad_rumble && /tmp/test_pad_rumble
+ * (No controller is opened: the state is checked, nothing vibrates.)
+ */
+#include "../cellPad.c"
+#include <assert.h>
+#include <sys/mman.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+/* the guest-memory writers' SPU coherence hooks (ppu_memory.h) */
+uint64_t spu_lockline_mask_range(uint32_t ea, uint32_t len) { (void)ea; (void)len; return 0; }
+void spu_lockline_lock_mask(uint64_t mask) { (void)mask; }
+void spu_lockline_unlock_mask(uint64_t mask) { (void)mask; }
+void spu_coh_notify_write_from_ppu(uint32_t addr) { (void)addr; }
+
+static void test_strength(void)
+{
+    assert(pad_rumble_strength_from(NULL, NULL) == 100);
+    assert(pad_rumble_strength_from("1", NULL) == 100);
+    assert(pad_rumble_strength_from("0", NULL) == 0);
+    assert(pad_rumble_strength_from("0", "80") == 0);    /* off wins */
+    assert(pad_rumble_strength_from(NULL, "50") == 50);
+    assert(pad_rumble_strength_from(NULL, "0") == 0);
+    assert(pad_rumble_strength_from(NULL, "250") == 200);
+    assert(pad_rumble_strength_from(NULL, "-3") == 0);
+    assert(pad_rumble_strength_from(NULL, "abc") == 100);
+    assert(pad_rumble_strength_from(NULL, "") == 100);
+}
+
+static void test_levels(void)
+{
+    u16 lo, hi;
+    pad_rumble_levels(0, 0, 100, &lo, &hi);   assert(lo == 0 && hi == 0);
+    pad_rumble_levels(1, 255, 100, &lo, &hi); assert(lo == 65535 && hi == 65535);
+    pad_rumble_levels(1, 0, 100, &lo, &hi);   assert(lo == 0 && hi == 65535);  /* small motor is on/off */
+    pad_rumble_levels(255, 0, 100, &lo, &hi); assert(hi == 65535);            /* any non-zero is on */
+    pad_rumble_levels(1, 128, 50, &lo, &hi);  assert(lo == 16448 && hi == 32767);
+    pad_rumble_levels(0, 100, 200, &lo, &hi); assert(lo == 51400 && hi == 0);
+    pad_rumble_levels(1, 255, 200, &lo, &hi); assert(lo == 65535 && hi == 65535); /* capped */
+    pad_rumble_levels(1, 255, 0, &lo, &hi);   assert(lo == 0 && hi == 0);
+}
+
+static void test_set_act_direct(void)
+{
+    vm_base = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+    s_pad_initialized = 1;
+    CellPadActParam* p = (CellPadActParam*)(vm_base + 0x100);
+    const uintptr_t ea = 0x100;
+
+    p->motor[CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+    p->motor[CELL_PAD_ACTUATOR_PARAM_LARGE] = 200;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)ea) == CELL_OK);
+    assert(s_rumble[0].lo == 200 * 257 && s_rumble[0].hi == 65535);
+    assert(s_rumble[0].sent_ms == 0);     /* no controller open: nothing sent, nothing to renew */
+
+    p->motor[CELL_PAD_ACTUATOR_PARAM_SMALL] = 0;
+    p->motor[CELL_PAD_ACTUATOR_PARAM_LARGE] = 0;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)ea) == CELL_OK);
+    assert(s_rumble[0].lo == 0 && s_rumble[0].hi == 0);
+
+    assert(cellPadSetActDirect(5, (CellPadActParam*)ea) == CELL_OK);   /* a port with no host pad */
+    assert(cellPadSetActDirect(CELL_PAD_MAX_PORT_NUM, (CellPadActParam*)ea) == (s32)CELL_PAD_ERROR_INVALID_PARAMETER);
+    assert(cellPadSetActDirect(0, NULL) == (s32)CELL_PAD_ERROR_INVALID_PARAMETER);
+    s_pad_initialized = 0;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)ea) == (s32)CELL_PAD_ERROR_NOT_OPENED);
+}
+
+int main(void)
+{
+    unsetenv("PS3_RUMBLE");
+    unsetenv("PS3_RUMBLE_STRENGTH");
+    test_strength();
+    test_levels();
+    test_set_act_direct();
+    printf("test_pad_rumble: ok\n");
+    return 0;
+}
diff --git a/libs/misc/cellAvconfExt.c b/libs/misc/cellAvconfExt.c
index 50e6fe8..0cb9f91 100644
--- a/libs/misc/cellAvconfExt.c
+++ b/libs/misc/cellAvconfExt.c
@@ -7,6 +7,9 @@
 
 #include "cellAvconfExt.h"
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write32: translate + byte-swap */
+#include "../../runtime/ppu/ppu_context.h"  /* the float argument of SetGamma is in f1 */
+#include <stdlib.h>
+#include "../../include/ps3emu/ps3_toggles.h"   /* PS3_TOGGLE_FILE: PS3_DISPLAY_GAMMA live */
 
 /* The HLE ABI adapter passes pointer parameters as raw guest addresses, so a
  * bare deref here writes to whatever host address shares that number. These
@@ -181,10 +184,52 @@ s32 cellVideoOutSetGamma(u32 videoOut, float gamma)
 {
     (void)videoOut;
     printf("[cellAvconfExt] VideoOutSetGamma(%.2f)\n", gamma);
+    if (gamma < 0.8f || gamma > 1.2f) return (s32)0x8002b223;   /* PARAMETER_OUT_OF_RANGE */
     s_gamma = gamma;
     return CELL_OK;
 }
 
+/* The gamma is a float, which the PPU ABI passes in f1, not r4: registered
+ * through a plain C prototype it arrived as garbage (inFAMOUS 2 logged 0.00)
+ * and the game's brightness setting never reached the screen. The context
+ * handler reads f1 (avconf_register_ctx, called with the other ctx handlers). */
+static void hle_video_out_set_gamma(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)cellVideoOutSetGamma((u32)ctx->gpr[3], (float)ctx->fpr[1]);
+}
+
+void avconf_register_ctx(void)
+{
+    extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+    ps3_hle_register_ctx(0xC7020F62u, "cellVideoOutSetGamma", hle_video_out_set_gamma);
+}
+
+/* The display gamma for the presenter: what the title set (0.8..1.2, 1 by
+ * default), or PS3_DISPLAY_GAMMA=<g> to override it. The video out applies
+ * it as out = in^gamma, like RPCS3's calibration pass. */
+static volatile float s_gamma_override = -1.0f;   /* < 0: not read yet; 0: none */
+static int s_gamma_dirty = 1;   /* PS3_TOGGLE_FILE changed PS3_DISPLAY_GAMMA (and the first call) */
+static void avconf_gamma_set(int id, int v) { (void)id; (void)v; __atomic_store_n(&s_gamma_dirty, 1, __ATOMIC_RELAXED); }
+float cellAvconfExt_display_gamma(void)
+{
+    if (__builtin_expect(__atomic_load_n(&s_gamma_dirty, __ATOMIC_RELAXED), 0)) {
+        static int watching;
+        if (!watching) { watching = 1; ps3_toggle_watch(PS3T_DISPLAY_GAMMA, avconf_gamma_set); }
+        __atomic_store_n(&s_gamma_dirty, 0, __ATOMIC_RELAXED);
+        char buf[PS3_TOGGLE_STR];
+        const char* e = ps3_toggle_str(PS3T_DISPLAY_GAMMA, buf, sizeof buf);
+        const float g = *e ? (float)atof(e) : 0.0f;
+        s_gamma_override = g > 0.0f ? g : 0.0f;   /* the in-game menu may change it later */
+    }
+    const float env = s_gamma_override;
+    return env > 0.0f ? env : s_gamma;
+}
+/* The in-game menu (ps3_overlay.mm): the override (0 = the title's own
+ * gamma) and the title's value. */
+float cellAvconfExt_display_gamma_override(void) { cellAvconfExt_display_gamma(); return s_gamma_override; }
+void  cellAvconfExt_set_display_gamma_override(float g) { s_gamma_override = g > 0.0f ? g : 0.0f; }
+float cellAvconfExt_title_gamma(void) { return s_gamma; }
+
 /* cellAudioOutConfigure(audioOut, config, option, waitForEvent) -- set the
  * audio output mode. We accept any config and report success (request id 0);
  * the title queries availability separately. NID 0x4692AB35. */
diff --git a/libs/misc/cellAvconfExt.h b/libs/misc/cellAvconfExt.h
index 2521ff0..9ab90ee 100644
--- a/libs/misc/cellAvconfExt.h
+++ b/libs/misc/cellAvconfExt.h
@@ -87,6 +87,8 @@ s32 cellAudioOutGetNumberOfDevice(u32 audioOut);
 /* Video output extended queries */
 s32 cellVideoOutGetGamma(u32 videoOut, float* gamma);
 s32 cellVideoOutSetGamma(u32 videoOut, float gamma);
+void avconf_register_ctx(void);
+float cellAvconfExt_display_gamma(void);
 
 #ifdef __cplusplus
 }
diff --git a/libs/misc/ps3_toggles.c b/libs/misc/ps3_toggles.c
new file mode 100644
index 0000000..49beb54
--- /dev/null
+++ b/libs/misc/ps3_toggles.c
@@ -0,0 +1,209 @@
+/*
+ * ps3recomp - PS3_TOGGLE_FILE: knobs switched while the game runs.
+ *
+ * The poll half of include/ps3emu/ps3_toggles.h (the format and the list of
+ * live knobs are there). One thread calls ps3_toggles_poll() every frame; at
+ * most every 250 ms it stat()s the file, and only when its modification time,
+ * size or inode moved does it read and parse it. Each knob whose value then
+ * differs from before is stored, logged ("[toggle] NAME old -> new"), marked
+ * in the PS3_FTRACE timeline and handed to its watchers, which update the
+ * module-local ints the hot paths read.
+ */
+#include "ps3emu/ps3_toggles.h"
+#include "ps3emu/ps3_ftrace.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#define TOGGLE_POLL_NS  (250ull * 1000000ull)
+#define TOGGLE_FILE_MAX (16u * 1024u)
+
+static uint32_t toggle_hash(const char* s)
+{
+    uint32_t h = 2166136261u;
+    for (; *s; s++) { h ^= (uint8_t)*s; h *= 16777619u; }
+    return h;
+}
+
+static char* trim(char* s)
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r') s++;
+    char* e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r')) *--e = 0;
+    return s;
+}
+
+static void toggle_mark(uint32_t who, uint32_t a, uint32_t b)
+{
+    if (!PS3_FT_ON()) return;
+    const uint64_t now = ps3_ft_now();
+    ps3_ft_span(PS3_FT_TOGGLE, who, a, b, now, now);
+}
+
+/* One built-in knob to its new text (the file's, or the environment's when the
+ * file does not name it). Takes the lock; calls the watchers under it. */
+static void toggle_apply(int id, const char* text, int from_file)
+{
+    ps3_toggle_state* s = &g_ps3_toggles;
+    const ps3_toggle_def* d = ps3_toggle_def_of(id);
+    int v;
+    if (!from_file) v = s->env_value[id];
+    else if (d->kind == PS3_TK_STR) v = atoi(text);
+    else {
+        char* end = NULL;
+        const long l = strtol(text, &end, 0);
+        if (!*text || (end && *end)) {
+            fprintf(stderr, "[toggle] %s=%s: not a number, ignored\n", d->name, text);
+            return;
+        }
+        v = (int)l;
+    }
+    ps3_toggle_lock();
+    const int old = s->value[id];
+    char old_str[PS3_TOGGLE_STR];
+    memcpy(old_str, s->str[id], sizeof old_str);
+    const int changed = d->kind == PS3_TK_STR ? strcmp(old_str, text) != 0 : old != v;
+    if (changed) {
+        __atomic_store_n(&s->value[id], v, __ATOMIC_RELAXED);
+        snprintf(s->str[id], PS3_TOGGLE_STR, "%s", text);
+        for (int i = 0; i < PS3_TOGGLE_WATCHERS && s->watch[id][i]; i++)
+            s->watch[id][i](id, v);
+    }
+    ps3_toggle_unlock();
+    if (!changed) return;
+    if (d->kind == PS3_TK_STR) {
+        fprintf(stderr, "[toggle] %s %s -> %s%s\n", d->name, *old_str ? old_str : "(unset)",
+                *text ? text : "(unset)", from_file ? "" : " (environment)");
+        toggle_mark((uint32_t)id, toggle_hash(old_str), toggle_hash(text));
+    } else {
+        fprintf(stderr, "[toggle] %s %d -> %d%s\n", d->name, old, v, from_file ? "" : " (environment)");
+        toggle_mark((uint32_t)id, (uint32_t)old, (uint32_t)v);
+    }
+}
+
+/* A name that is not a built-in knob: kept for ps3_toggle_get(). */
+static void toggle_apply_extra(const char* name, const char* text, int set)
+{
+    ps3_toggle_state* s = &g_ps3_toggles;
+    const int v = set ? (int)strtol(text, NULL, 0) : 0;
+    ps3_toggle_lock();
+    int i = 0;
+    while (i < s->n_extra && strcmp(s->extra[i].name, name)) i++;
+    if (i == s->n_extra) {
+        if (!set || i >= PS3_TOGGLE_EXTRA) { ps3_toggle_unlock(); return; }
+        snprintf(s->extra[i].name, sizeof s->extra[i].name, "%s", name);
+        s->n_extra++;
+        fprintf(stderr, "[toggle] %s is not a built-in knob: only ps3_toggle_get() sees it\n", name);
+    }
+    const int was_set = s->extra[i].set, old = s->extra[i].value;
+    s->extra[i].set = set;
+    s->extra[i].value = v;
+    ps3_toggle_unlock();
+    if (was_set == set && (!set || old == v)) return;
+    char was[16];
+    snprintf(was, sizeof was, "%d", old);
+    fprintf(stderr, "[toggle] %s %s -> %s\n", name, was_set ? was : "(unset)", set ? text : "(unset)");
+    toggle_mark(64u + (uint32_t)i, (uint32_t)old, (uint32_t)v);
+}
+
+static void toggles_apply_text(char* buf)
+{
+    int seen[PS3T_COUNT] = { 0 };
+    char seen_extra[PS3_TOGGLE_EXTRA][48];
+    int n_seen_extra = 0;
+    int line_no = 0;
+    for (char* line = buf; line && *line;) {
+        char* next = strchr(line, '\n');
+        if (next) *next++ = 0;
+        line_no++;
+        char* hash = strchr(line, '#');
+        if (hash) *hash = 0;
+        char* l = trim(line);
+        line = next;
+        if (!*l) continue;
+        char* eq = strchr(l, '=');
+        if (!eq) {
+            fprintf(stderr, "[toggle] line %d: '%s' has no '=', ignored\n", line_no, l);
+            continue;
+        }
+        *eq = 0;
+        char* name = trim(l);
+        char* val = trim(eq + 1);
+        int id = 0;
+        while (id < PS3T_COUNT && strcmp(ps3_toggle_def_of(id)->name, name)) id++;
+        if (id < PS3T_COUNT) {
+            seen[id] = 1;
+            toggle_apply(id, val, 1);
+        } else if (*name) {
+            if (n_seen_extra < PS3_TOGGLE_EXTRA)
+                snprintf(seen_extra[n_seen_extra++], 48, "%s", name);
+            toggle_apply_extra(name, val, 1);
+        }
+    }
+    /* What the file no longer names goes back to the environment. */
+    for (int id = 0; id < PS3T_COUNT; id++)
+        if (!seen[id]) toggle_apply(id, g_ps3_toggles.env_str[id], 0);
+    for (int i = 0; i < g_ps3_toggles.n_extra; i++) {
+        int named = 0;
+        for (int k = 0; k < n_seen_extra && !named; k++)
+            named = !strcmp(seen_extra[k], g_ps3_toggles.extra[i].name);
+        if (!named) toggle_apply_extra(g_ps3_toggles.extra[i].name, "", 0);
+    }
+}
+
+static uint64_t toggles_now_ns(void)
+{
+    return ps3_ft_now();   /* monotonic, the timeline's own clock */
+}
+
+void ps3_toggles_poll(void)
+{
+    static int s_on = -1;              /* -1 not read yet, 0 no file, 1 polling */
+    static char s_path[1024];
+    static uint64_t s_next;
+    static int s_had;                  /* the last stat found the file */
+    static long long s_mt_s, s_mt_ns, s_size, s_ino;
+    if (__builtin_expect(s_on == 0, 1)) return;
+    if (s_on < 0) {
+        const char* e = getenv("PS3_TOGGLE_FILE");
+        if (!e || !*e) { s_on = 0; return; }
+        snprintf(s_path, sizeof s_path, "%s", e);
+        ps3_toggles_seed();
+        s_on = 1;
+        fprintf(stderr, "[toggle] watching %s (every 250 ms)\n", s_path);
+    }
+    const uint64_t now = toggles_now_ns();
+    if (now < s_next) return;
+    s_next = now + TOGGLE_POLL_NS;
+
+    struct stat st;
+    const int have = stat(s_path, &st) == 0;
+    long long mt_s = 0, mt_ns = 0;
+    if (have) {
+        mt_s = (long long)st.st_mtime;
+#if defined(__APPLE__)
+        mt_ns = (long long)st.st_mtimespec.tv_nsec;
+#elif defined(__linux__)
+        mt_ns = (long long)st.st_mtim.tv_nsec;
+#endif
+    }
+    if (have == s_had && (!have || (mt_s == s_mt_s && mt_ns == s_mt_ns &&
+                                    (long long)st.st_size == s_size &&
+                                    (long long)st.st_ino == s_ino)))
+        return;
+    s_had = have;
+    if (have) { s_mt_s = mt_s; s_mt_ns = mt_ns; s_size = (long long)st.st_size; s_ino = (long long)st.st_ino; }
+
+    static char buf[TOGGLE_FILE_MAX + 1];
+    size_t n = 0;
+    if (have) {
+        FILE* f = fopen(s_path, "rb");
+        if (f) { n = fread(buf, 1, TOGGLE_FILE_MAX, f); fclose(f); }
+    }
+    buf[n] = 0;
+    toggles_apply_text(buf);
+}
