+static const float kColA[3] = { 0.40f, 0.86f, 0.28f };
+static const float kColB[3] = { 0.98f, 0.30f, 0.26f };
+static const float kColX[3] = { 0.26f, 0.58f, 1.00f };
+static const float kColY[3] = { 1.00f, 0.80f, 0.16f };
