+        int i = 1;
+        for (NSScreen* sc in screens)
+            fprintf(stderr, "[RSX metal]   %d: %s\n", i++, sc.localizedName ? [sc.localizedName UTF8String] : "?");
+    } else {
+        fprintf(stderr, "[RSX metal] PS3_DISPLAY=%s: names need macOS 10.15; give a number\n", e);
+    }
+    return fallback;
