<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The game's Info.plist (CMakeLists.txt builds build/Infamous2Recomp.app on
  macOS). It is what makes macOS treat the game as a game: gamepolicyd turns
  Game Mode on for a fullscreen, frontmost app whose bundle carries
  LSSupportsGameMode or the games category. It only reads a real bundle; an
  Info.plist embedded in a bare executable (-sectcreate __TEXT __info_plist)
  is not looked at. Running .app/Contents/MacOS/Infamous2Recomp directly (as
  run.sh does) keeps the bundle identity.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>inFAMOUS 2 Recomp</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.games</string>
    <!-- macOS 26+ (the key gamepolicyd cites when it finds the game) -->
    <key>LSSupportsGameMode</key>
    <true/>
    <!-- macOS 14-15 -->
    <key>GCSupportsGameMode</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
